// 1 if every byte of a is zero, else 0 (portable High-Level Ode).

def zero_from(a, at) {
    if at == len(a) then 1
    else if a[at] != 0 then 0
    else zero_from(a, at + 1)
}

def zeros(a) { zero_from(a, 0) }

fn all_zero(a: n bytes, n: number)
    returns zeros(a)
    trace depends on a, n
    stack 0
{
    for i in 0..n
        maintains zeros(a) == zero_from(a, i)
    {
        if a[i] != 0 { return 0 }
    }
    return 1
}
