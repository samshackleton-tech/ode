// 1 if every byte of a is zero, else 0.

def zero_from(a, at) {
    if at == len(a) then 1
    else if a[at] != 0 then 0
    else zero_from(a, at + 1)
}

def zeros(a) { zero_from(a, 0) }

fn all_zero(a: n bytes, n: number)
    returns zeros(a)
    trace depends on a, n
    stack 0
{
    for x86_64 {
        reg base = rdi, count = rsi, idx = rcx, res = rax
        reg addr = rdx, cur = edx, cur64 = rdx

        idx := 0
        place {
            fact 0 <= idx
            fact idx <= n
            fact zeros(a) == zero_from(a, idx)
            decreases n - idx
        }
    @loop:
        cmp idx, count
        jae @yes
        mov addr, base
        add addr, idx
        movzx cur, byte ptr [addr]
        cmp cur64, 0
        jne @no
        add idx, 1
        jmp @loop
    @yes:
        res := 1
        jmp @done
    @no:
        res := 0
    @done:
        ret
    }
    for arm64 {
        reg base = x0, count = x1, idx = x2, res = x0
        reg addr = x3, cur = w4, cur64 = x4

        idx := 0
        place {
            fact 0 <= idx
            fact idx <= n
            fact zeros(a) == zero_from(a, idx)
            decreases n - idx
        }
    @loop:
        cmp idx, count
        b.hs @yes
        add addr, base, idx
        ldrb cur, [addr, 0]
        cmp cur64, 0
        b.ne @no
        add idx, idx, 1
        b @loop
    @yes:
        res := 1
        b @done
    @no:
        res := 0
    @done:
        ret
    }
}
