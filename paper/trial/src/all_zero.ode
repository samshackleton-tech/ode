// Whether every byte of an array is zero: a scan that leaves at the first byte that is not. Today's notation.
// The loop's invariant is written at the loop; the compiler works out where that is in the code.
fn all_zero_early as "ode_all_zero" {
  xor ecx, ecx
  @loop:
  place {
    name i = rcx
    fact i <= n
    fact all_zero_from(xs, i) == all_zero(xs)
    decreases n - i
  }
  cmp rcx, rsi
  jae @yes
  mov rdx, rdi
  add rdx, rcx
  movzx eax, byte ptr [rdx + 0]
  cmp rax, 0
  jne @no
  add rcx, 1
  jmp @loop
  @yes:
  mov rax, 1
  jmp @done
  @no:
  xor eax, eax
  @done:
  ret
}
