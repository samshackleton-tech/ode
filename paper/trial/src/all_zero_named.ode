// Whether every byte of an array is zero: a scan that leaves at the first byte that is not. As all_zero.ode,
// with names for the registers and `:=` for the two stores. Both give the same object file.
target x86_64

fn all_zero_early as "ode_all_zero" {
  reg xs = rdi
  reg n  = rsi
  reg i  = rcx
  reg p  = rdx
  reg b  = rax

  xor ecx, ecx
  @loop:
  place {
    name i = rcx
    fact i <= n
    fact all_zero_from(xs, i) == all_zero(xs)
    decreases n - i
  }
  cmp i, n
  jae @yes
  p := xs
  add p, i
  movzx eax, byte ptr [p + 0]
  cmp b, 0
  jne @no
  add i, 1
  jmp @loop
  @yes:
  b := 1
  jmp @done
  @no:
  xor eax, eax
  @done:
  ret
}
