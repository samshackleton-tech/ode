target x86_64

fn adler32_s1 as "ode_adler32_s1" {
  reg input = rdi
  reg n = rsi
  reg i = rcx
  reg s = rax
  reg byte_val = r8
  reg addr = r9
  reg mod_val = r10

  // Initialize: s = 1, i = 0, pre-load modulus
  s := 1
  i := 0
  mod_val := 65521
  
  loop {
    place {
      name idx = i
      name cur = s
      fact 0 <= idx
      fact idx <= n
      fact cur == s1(input)[idx]
      fact cur < 65521
      decreases n - idx
    }
    
    cmp i, n
    break if eq
    
    // Compute address first, then load
    lea addr, [input + i]
    movzx r8d, byte ptr [addr]
    
    // Add to s
    add s, r8
    
    // Compare and subtract if needed (single conditional branch)
    cmp s, mod_val
    if uge {
      sub s, mod_val
    }
    
    add i, 1
  }
  
  ret
}

