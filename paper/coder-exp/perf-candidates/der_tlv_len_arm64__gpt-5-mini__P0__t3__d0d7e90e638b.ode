target arm64

fn der_tlv_len as "ode_der_tlv_len" {
  reg buf = x0
  reg n = x1
  reg tag = x2
  reg lenb = x3
  reg tmp = x4
  reg res = x5

  // need at least tag + length byte
  cmp n, 2
  if ult {
    x0 := 0
    ret
  }

  // load both first to reduce dependency chain
  ldrb w3, [buf, 1]    // lenb <- buf[1]
  ldrb w2, [buf, 0]    // tag  <- buf[0]

  // reject high-tag-number form: (tag & 31) == 31
  lsl x2, x2, 59
  lsr x2, x2, 59
  cmp x2, 31
  if eq {
    x0 := 0
    ret
  }

  // short form: len < 128 -> total = 2 + len
  cmp x3, 128
  if ult {
    add x5, x3, 2
    cmp n, x5
    if ult {
      x0 := 0
      ret
    }
    x0 := x5
    ret
  }

  // 1-byte long form: 0x81
  cmp x3, 129
  if eq {
    cmp n, 3
    if ult {
      x0 := 0
      ret
    }
    ldrb w4, [buf, 2]
    cmp x4, 128
    if ult {
      x0 := 0
      ret
    }
    add x5, x4, 3
    cmp n, x5
    if ult {
      x0 := 0
      ret
    }
    x0 := x5
    ret
  }

  // 2-byte long form: 0x82
  cmp x3, 130
  if eq {
    cmp n, 4
    if ult {
      x0 := 0
      ret
    }
    ldrb w4, [buf, 2]
    cmp x4, 1
    if ult {
      x0 := 0
      ret
    }
    ldrb w5, [buf, 3]
    lsl x4, x4, 8
    add x4, x4, x5
    add x4, x4, 4
    cmp n, x4
    if ult {
      x0 := 0
      ret
    }
    x0 := x4
    ret
  }

  // indefinite (0x80), 0x83+ : malformed
  x0 := 0
  ret
}

