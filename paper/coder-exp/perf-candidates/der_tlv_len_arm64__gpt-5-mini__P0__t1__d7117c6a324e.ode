target arm64

fn der_tlv_len as "ode_der_tlv_len" {
  reg buf = x0
  reg n = x1
  reg b0 = x2
  reg b1 = x3
  reg t = x4
  reg acc = x5

  // need at least tag + length byte
  cmp n, 2
  if ult {
    x0 := 0
    ret
  }

  // reject high-tag-number form: (tag & 31) == 31
  ldrb w2, [buf, 0]
  lsl x2, x2, 59
  lsr x2, x2, 59
  cmp x2, 31
  if eq {
    x0 := 0
    ret
  }

  // load length byte
  ldrb w3, [buf, 1]

  // short form: l0 < 128, total = 2 + l0
  cmp x3, 128
  if ult {
    add x5, x3, 2
    cmp n, x5
    if ult {
      x0 := 0
      ret
    }
    x0 := x5
    ret
  }

  // 1-byte long form: 0x81, buf[2] >= 128
  cmp x3, 129
  if eq {
    cmp n, 3
    if ult {
      x0 := 0
      ret
    }
    ldrb w4, [buf, 2]
    cmp x4, 128
    if ult {
      x0 := 0
      ret
    }
    add x5, x4, 3
    cmp n, x5
    if ult {
      x0 := 0
      ret
    }
    x0 := x5
    ret
  }

  // 2-byte long form: 0x82, buf[2] >= 1
  cmp x3, 130
  if eq {
    cmp n, 4
    if ult {
      x0 := 0
      ret
    }
    ldrb w4, [buf, 2]
    cmp x4, 1
    if ult {
      x0 := 0
      ret
    }
    ldrb w5, [buf, 3]
    lsl x4, x4, 8
    add x4, x4, x5
    add x4, x4, 4
    cmp n, x4
    if ult {
      x0 := 0
      ret
    }
    x0 := x4
    ret
  }

  // indefinite (0x80), 0x83+ : malformed
  x0 := 0
  ret
}

