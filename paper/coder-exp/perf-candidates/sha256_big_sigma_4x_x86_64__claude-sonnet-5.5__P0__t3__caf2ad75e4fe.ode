target x86_64

fn sha256_big_sigma_4x as "ode_sha256_big_sigma_4x" {
  reg out_ptr = rdi
  reg a_ptr = rsi
  reg e_ptr = rdx

  vmovdqu xmm0, [a_ptr]
  vmovdqu xmm1, [e_ptr]

  // Interleave Sigma0(a) and Sigma1(e) so both chains issue in parallel
  vpsrld xmm2, xmm0, 2
  vpslld xmm3, xmm0, 30
  vpsrld xmm4, xmm1, 6
  vpslld xmm5, xmm1, 26

  vpsrld xmm6, xmm0, 13
  vpslld xmm7, xmm0, 19
  vpsrld xmm8, xmm1, 11
  vpslld xmm9, xmm1, 21

  vpor xmm2, xmm2, xmm3
  vpor xmm4, xmm4, xmm5

  vpsrld xmm10, xmm0, 22
  vpslld xmm0, xmm0, 10
  vpsrld xmm11, xmm1, 25
  vpslld xmm1, xmm1, 7

  vpor xmm6, xmm6, xmm7
  vpor xmm8, xmm8, xmm9
  vpor xmm10, xmm10, xmm0
  vpor xmm11, xmm11, xmm1

  vpxor xmm2, xmm2, xmm6
  vpxor xmm4, xmm4, xmm8
  vpxor xmm2, xmm2, xmm10
  vpxor xmm4, xmm4, xmm11

  vpaddd xmm0, xmm2, xmm4

  vmovdqu [out_ptr], xmm0
  ret
}

