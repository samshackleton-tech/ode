target x86_64

fn sha256_big_sigma_4x as "ode_sha256_big_sigma_4x" {
  reg out_ptr = rdi
  reg a_ptr = rsi
  reg e_ptr = rdx

  // Load inputs
  vmovdqu xmm0, [a_ptr]  // a
  vmovdqu xmm1, [e_ptr]  // e

  // Compute Sigma0(a) = (a >>> 2) ^ (a >>> 13) ^ (a >>> 22)
  // Use parallel computation to shorten critical path
  
  // xmm2 = a >>> 2 = (a >> 2) | (a << 30)
  vpsrld xmm2, xmm0, 2
  vpslld xmm3, xmm0, 30
  vpor xmm2, xmm2, xmm3
  
  // xmm3 = a >>> 13 = (a >> 13) | (a << 19)
  vpsrld xmm3, xmm0, 13
  vpslld xmm4, xmm0, 19
  vpor xmm3, xmm3, xmm4
  
  // xmm4 = a >>> 22 = (a >> 22) | (a << 10)
  vpsrld xmm4, xmm0, 22
  vpslld xmm5, xmm0, 10
  vpor xmm4, xmm4, xmm5
  
  // Compute Sigma1(e) = (e >>> 6) ^ (e >>> 11) ^ (e >>> 25)
  // Parallel computation with Sigma0
  
  // xmm5 = e >>> 6 = (e >> 6) | (e << 26)
  vpsrld xmm5, xmm1, 6
  vpslld xmm6, xmm1, 26
  vpor xmm5, xmm5, xmm6
  
  // xmm6 = e >>> 11 = (e >> 11) | (e << 21)
  vpsrld xmm6, xmm1, 11
  vpslld xmm7, xmm1, 21
  vpor xmm6, xmm6, xmm7
  
  // xmm7 = e >>> 25 = (e >> 25) | (e << 7)
  vpsrld xmm7, xmm1, 25
  vpslld xmm8, xmm1, 7
  vpor xmm7, xmm7, xmm8
  
  // Combine Sigma0 components
  vpxor xmm2, xmm2, xmm3
  vpxor xmm2, xmm2, xmm4
  
  // Combine Sigma1 components
  vpxor xmm5, xmm5, xmm6
  vpxor xmm5, xmm5, xmm7
  
  // Add Sigma0(a) + Sigma1(e) modulo 2^32
  vpaddd xmm0, xmm2, xmm5

  // Store result
  vmovdqu [out_ptr], xmm0
  ret
}

