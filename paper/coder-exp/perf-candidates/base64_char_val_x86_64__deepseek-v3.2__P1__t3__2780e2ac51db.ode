target x86_64

fn b64_char_val as "ode_b64_char_val" {
  reg b = rdi
  reg res = rax
  reg tmp = rcx
  
  // Handle uppercase A-Z (65-90) -> 0-25
  cmp b, 65
  if lo {
    jmp @check_digit  // Below 65
  }
  cmp b, 91
  if uge {
    jmp @check_lower  // >= 91
  }
  res := b
  sub res, 65
  ret
  
@check_lower:
  // Handle lowercase a-z (97-122) -> 26-51
  cmp b, 97
  if lo {
    jmp @check_plus  // Below 97
  }
  cmp b, 123
  if uge {
    jmp @check_plus  // >= 123 (skip digit check)
  }
  res := b
  sub res, 71
  ret
  
@check_digit:
  // Handle digits 0-9 (48-57) -> 52-61
  cmp b, 48
  if lo {
    jmp @check_plus  // Below 48
  }
  cmp b, 58
  if uge {
    jmp @check_plus  // >= 58
  }
  res := b
  add res, 4
  ret
  
@check_plus:
  // Handle '+' (43) -> 62 and '/' (47) -> 63
  cmp b, 43
  if eq {
    res := 62
    ret
  }
  cmp b, 47
  if eq {
    res := 63
    ret
  }
  
  // Any other byte -> 255
  res := 255
  ret
}

