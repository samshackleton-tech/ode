target arm64

fn der_tlv_len as "ode_der_tlv_len" {
  reg buf = x0
  reg n = x1

  // need at least tag + length byte
  cmp n, 2
  if ult {
    x0 := 0
    ret
  }

  ldrb w9, [buf, 0]
  ldrb w10, [buf, 1]

  // reject high-tag-number form: (tag & 31) == 31
  lsl x9, x9, 59
  lsr x9, x9, 59
  cmp x9, 31
  if eq {
    x0 := 0
    ret
  }

  // short form: l0 < 128, total = 2 + l0
  cmp x10, 128
  if ult {
    add x0, x10, 2
    cmp n, x0
    if ult {
      x0 := 0
    }
    ret
  }

  // 1-byte long form: 0x81, buf[2] >= 128
  cmp x10, 129
  if eq {
    cmp n, 3
    if ult {
      x0 := 0
      ret
    }
    ldrb w11, [buf, 2]
    cmp x11, 128
    if ult {
      x0 := 0
      ret
    }
    add x0, x11, 3
    cmp n, x0
    if ult {
      x0 := 0
    }
    ret
  }

  // 2-byte long form: 0x82, buf[2] >= 1
  cmp x10, 130
  if eq {
    cmp n, 4
    if ult {
      x0 := 0
      ret
    }
    ldrb w11, [buf, 2]
    ldrb w12, [buf, 3]
    cmp x11, 1
    if ult {
      x0 := 0
      ret
    }
    lsl x11, x11, 8
    add x11, x11, x12
    add x0, x11, 4
    cmp n, x0
    if ult {
      x0 := 0
    }
    ret
  }

  // indefinite (0x80), 0x83+ : malformed
  x0 := 0
  ret
}

