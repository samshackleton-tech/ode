target x86_64

fn sha256_big_sigma_4x as "ode_sha256_big_sigma_4x" {
  reg out_ptr = rdi
  reg a_ptr = rsi
  reg e_ptr = rdx

  // Load inputs
  vmovdqu xmm0, [a_ptr]    // a
  vmovdqu xmm1, [e_ptr]    // e

  // Sigma0(a) = (a >>> 2) ^ (a >>> 13) ^ (a >>> 22)
  vpsrld xmm2, xmm0, 2
  vpslld xmm3, xmm0, 30
  vpor   xmm2, xmm2, xmm3   // rot2

  vpsrld xmm3, xmm0, 13
  vpslld xmm4, xmm0, 19
  vpor   xmm3, xmm3, xmm4   // rot13

  vpsrld xmm4, xmm0, 22
  vpslld xmm0, xmm0, 10
  vpor   xmm4, xmm4, xmm0   // rot22

  vpxor  xmm2, xmm2, xmm3
  vpxor  xmm2, xmm2, xmm4   // xmm2 = Sigma0(a)

  // Sigma1(e) = (e >>> 6) ^ (e >>> 11) ^ (e >>> 25)
  vpsrld xmm3, xmm1, 6
  vpslld xmm0, xmm1, 26
  vpor   xmm3, xmm3, xmm0   // rot6

  vpsrld xmm0, xmm1, 11
  vpslld xmm4, xmm1, 21
  vpor   xmm0, xmm0, xmm4   // rot11

  vpsrld xmm4, xmm1, 25
  vpslld xmm1, xmm1, 7
  vpor   xmm4, xmm4, xmm1   // rot25

  vpxor  xmm3, xmm3, xmm0
  vpxor  xmm3, xmm3, xmm4   // xmm3 = Sigma1(e)

  // Add modulo 2^32 across 4 lanes
  vpaddd xmm2, xmm2, xmm3

  // Store result
  vmovdqu [out_ptr], xmm2
  ret
}

