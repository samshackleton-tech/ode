target arm64

fn sha256_big_sigma_4x as "ode_sha256_big_sigma_4x" {
  // Load a and e
  ld1 {v0.4s}, [x1]
  ld1 {v1.4s}, [x2]

  // Sigma0(a) = ROTR^2 ^ ROTR^13 ^ ROTR^22
  // ROTR^2
  ushr v2.4s, v0.4s, 2
  shl v3.4s, v0.4s, 30
  orr v2.16b, v2.16b, v3.16b
  // ROTR^13
  ushr v3.4s, v0.4s, 13
  shl v4.4s, v0.4s, 19
  orr v3.16b, v3.16b, v4.16b
  // ROTR^22
  ushr v4.4s, v0.4s, 22
  shl v5.4s, v0.4s, 10
  orr v4.16b, v4.16b, v5.16b
  // XOR all three
  eor v2.16b, v2.16b, v3.16b
  eor v2.16b, v2.16b, v4.16b

  // Sigma1(e) = ROTR^6 ^ ROTR^11 ^ ROTR^25
  // ROTR^6
  ushr v3.4s, v1.4s, 6
  shl v4.4s, v1.4s, 26
  orr v3.16b, v3.16b, v4.16b
  // ROTR^11
  ushr v4.4s, v1.4s, 11
  shl v5.4s, v1.4s, 21
  orr v4.16b, v4.16b, v5.16b
  // ROTR^25
  ushr v5.4s, v1.4s, 25
  shl v6.4s, v1.4s, 7
  orr v5.16b, v5.16b, v6.16b
  // XOR all three
  eor v3.16b, v3.16b, v4.16b
  eor v3.16b, v3.16b, v5.16b

  // Add and store
  add v0.4s, v2.4s, v3.4s
  st1 {v0.4s}, [x0]
  ret
}

