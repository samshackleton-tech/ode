target arm64

fn sha256_big_sigma_4x as "ode_sha256_big_sigma_4x" {
  // Inputs: x0 = out (16 bytes), x1 = a (16 bytes), x2 = e (16 bytes)
  
  // Load inputs
  ld1 {v0.4s}, [x1]  // v0 = a
  ld1 {v1.4s}, [x2]  // v1 = e
  
  // Compute Sigma0(a) = ROTR^2(a) ^ ROTR^13(a) ^ ROTR^22(a)
  // Compute rotations with immediate reuse
  
  // ROTR^2(a)
  ushr v2.4s, v0.4s, 2
  shl v3.4s, v0.4s, 30
  orr v2.16b, v2.16b, v3.16b
  
  // ROTR^13(a) - compute while v2 is being used
  ushr v3.4s, v0.4s, 13
  shl v4.4s, v0.4s, 19
  orr v3.16b, v3.16b, v4.16b
  
  // XOR first two rotations
  eor v2.16b, v2.16b, v3.16b
  
  // ROTR^22(a)
  ushr v3.4s, v0.4s, 22
  shl v4.4s, v0.4s, 10
  orr v3.16b, v3.16b, v4.16b
  
  // Complete Sigma0
  eor v2.16b, v2.16b, v3.16b  // v2 = Sigma0(a)
  
  // Compute Sigma1(e) = ROTR^6(e) ^ ROTR^11(e) ^ ROTR^25(e)
  
  // ROTR^6(e)
  ushr v3.4s, v1.4s, 6
  shl v4.4s, v1.4s, 26
  orr v3.16b, v3.16b, v4.16b
  
  // ROTR^11(e)
  ushr v4.4s, v1.4s, 11
  shl v5.4s, v1.4s, 21
  orr v4.16b, v4.16b, v5.16b
  
  // XOR first two rotations
  eor v3.16b, v3.16b, v4.16b
  
  // ROTR^25(e)
  ushr v4.4s, v1.4s, 25
  shl v5.4s, v1.4s, 7
  orr v4.16b, v4.16b, v5.16b
  
  // Complete Sigma1
  eor v3.16b, v3.16b, v4.16b  // v3 = Sigma1(e)
  
  // Add Sigma0(a) + Sigma1(e) modulo 2^32
  add v0.4s, v2.4s, v3.4s
  
  // Store result
  st1 {v0.4s}, [x0]
  
  ret
}

