target arm64

fn base64_char_val as "ode_b64_char_val" {
  reg b = x0

  cmp b, 97
  if uge {
    // 'a'..'z' (97..122) -> 26..51
    cmp b, 123
    if ult {
      sub x0, b, 71
      ret
    }
    mov x0, 255
    ret
  }

  cmp b, 65
  if uge {
    // 'A'..'Z' (65..90) -> 0..25
    cmp b, 91
    if ult {
      sub x0, b, 65
      ret
    }
    mov x0, 255
    ret
  }

  cmp b, 58
  if uge {
    mov x0, 255
    ret
  }

  // '0'..'9' (48..57) -> 52..61
  cmp b, 48
  if uge {
    add x0, b, 4
    ret
  }

  // '+' -> 62
  cmp b, 43
  if eq {
    mov x0, 62
    ret
  }

  // '/' -> 63
  cmp b, 47
  if eq {
    mov x0, 63
    ret
  }

  mov x0, 255
  ret
}

