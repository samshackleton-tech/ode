target arm64

fn base64_char_val as "ode_b64_char_val" {
  reg b = x0
  reg t = x1

  // 'A'..'Z' (65..90) -> 0..25
  cmp b, 65
  b.lo @check_a
  sub t, b, 65
  cmp t, 26
  b.lo @AZ

@check_a:
  // 'a'..'z' (97..122) -> 26..51
  cmp b, 97
  b.lo @check_0
  sub t, b, 97
  cmp t, 26
  b.lo @az

@check_0:
  // '0'..'9' (48..57) -> 52..61
  cmp b, 48
  b.lo @check_plus
  sub t, b, 48
  cmp t, 10
  b.lo @09

@check_plus:
  // '+' -> 62
  cmp b, 43
  b.eq @plus

  // '/' -> 63
  cmp b, 47
  b.eq @slash

  // not in the alphabet -> 255
  mov x0, 255
  ret

@AZ:
  mov x0, t
  ret

@az:
  add x0, t, 26
  ret

@09:
  add x0, t, 52
  ret

@plus:
  mov x0, 62
  ret

@slash:
  mov x0, 63
  ret
}

