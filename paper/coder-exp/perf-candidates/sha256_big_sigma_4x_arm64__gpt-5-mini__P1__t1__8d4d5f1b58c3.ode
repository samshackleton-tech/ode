target arm64

fn sha256_big_sigma_4x as "ode_sha256_big_sigma_4x" {
  // Inputs: x0 = out (16 bytes), x1 = a (16 bytes), x2 = e (16 bytes)
  // Use vector registers v0-v7 as scratch

  // Load a and e
  ld1 {v0.4s}, [x1]   // v0 = a[0..3]
  ld1 {v1.4s}, [x2]   // v1 = e[0..3]

  // Compute all partial shifts for Sigma0(a) in parallel
  ushr v2.4s, v0.4s, 2
  ushr v3.4s, v0.4s, 13
  ushr v4.4s, v0.4s, 22
  shl  v5.4s, v0.4s, 30
  shl  v6.4s, v0.4s, 19
  shl  v7.4s, v0.4s, 10

  // Combine to rotations and XOR them: Sigma0 = ROTR2 ^ ROTR13 ^ ROTR22
  orr v2.16b, v2.16b, v5.16b   // ROTR2
  orr v3.16b, v3.16b, v6.16b   // ROTR13
  orr v4.16b, v4.16b, v7.16b   // ROTR22
  eor v2.16b, v2.16b, v3.16b
  eor v2.16b, v2.16b, v4.16b   // v2 = Sigma0(a)

  // Compute all partial shifts for Sigma1(e) in parallel (reuse registers)
  ushr v3.4s, v1.4s, 6
  ushr v4.4s, v1.4s, 11
  ushr v5.4s, v1.4s, 25
  shl  v6.4s, v1.4s, 26
  shl  v7.4s, v1.4s, 21
  shl  v1.4s, v1.4s, 7        // overwrite v1 with e << 7

  // Combine to rotations and XOR them: Sigma1 = ROTR6 ^ ROTR11 ^ ROTR25
  orr v3.16b, v3.16b, v6.16b  // ROTR6
  orr v4.16b, v4.16b, v7.16b  // ROTR11
  orr v5.16b, v5.16b, v1.16b  // ROTR25
  eor v3.16b, v3.16b, v4.16b
  eor v3.16b, v3.16b, v5.16b  // v3 = Sigma1(e)

  // Add Sigma0 + Sigma1 (lane-wise 32-bit add) and store
  add v0.4s, v2.4s, v3.4s
  st1 {v0.4s}, [x0]

  ret
}

