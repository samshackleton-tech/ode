target x86_64

fn sha256_big_sigma_4x as "ode_sha256_big_sigma_4x" {
  reg out_ptr = rdi
  reg a_ptr = rsi
  reg e_ptr = rdx

  vmovdqu xmm0, [a_ptr]
  vmovdqu xmm1, [e_ptr]

  // Sigma0(a) = (a>>>2) ^ (a>>>13) ^ (a>>>22)
  vpsrld xmm2, xmm0, 2
  vpslld xmm3, xmm0, 30
  vpor xmm2, xmm2, xmm3
  vpsrld xmm3, xmm0, 13
  vpslld xmm4, xmm0, 19
  vpor xmm3, xmm3, xmm4
  vpxor xmm2, xmm2, xmm3
  vpsrld xmm3, xmm0, 22
  vpslld xmm0, xmm0, 10
  vpor xmm3, xmm3, xmm0
  vpxor xmm0, xmm2, xmm3

  // Sigma1(e) = (e>>>6) ^ (e>>>11) ^ (e>>>25)
  vpsrld xmm2, xmm1, 6
  vpslld xmm3, xmm1, 26
  vpor xmm2, xmm2, xmm3
  vpsrld xmm3, xmm1, 11
  vpslld xmm4, xmm1, 21
  vpor xmm3, xmm3, xmm4
  vpxor xmm2, xmm2, xmm3
  vpsrld xmm3, xmm1, 25
  vpslld xmm1, xmm1, 7
  vpor xmm3, xmm3, xmm1
  vpxor xmm1, xmm2, xmm3

  vpaddd xmm0, xmm0, xmm1
  vmovdqu [out_ptr], xmm0
  ret
}

