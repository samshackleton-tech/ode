target arm64

fn der_tlv_len as "ode_der_tlv_len" {
  reg buf = x0
  reg n = x1
  reg tag = w2
  reg len_byte = w3
  reg total = x4
  reg tmp = w5
  reg tmp2 = w6

  cmp n, 2
  b.lo @fail

  ldrb tag, [buf, 0]
  lsl x2, x2, 59
  lsr x2, x2, 59
  cmp x2, 31
  b.eq @fail

  ldrb len_byte, [buf, 1]
  cmp x3, 128
  b.lo @short_form

  cmp x3, 129
  b.eq @long_form_1
  cmp x3, 130
  b.eq @long_form_2
  b @fail

@short_form:
  add total, x3, 2
  cmp n, total
  b.lo @fail
  x0 := total
  ret

@long_form_1:
  cmp n, 3
  b.lo @fail
  ldrb tmp, [buf, 2]
  cmp x5, 128
  b.lo @fail
  add total, x5, 3
  cmp n, total
  b.lo @fail
  x0 := total
  ret

@long_form_2:
  cmp n, 4
  b.lo @fail
  ldrb tmp, [buf, 2]
  cmp x5, 0
  b.eq @fail
  ldrb tmp2, [buf, 3]
  lsl x5, x5, 8
  add total, x5, x6
  add total, total, 4
  cmp n, total
  b.lo @fail
  x0 := total
  ret

@fail:
  x0 := 0
  ret
}

