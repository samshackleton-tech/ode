target x86_64

fn adler32_s1 as "ode_adler32_s1" {
  reg input = rdi
  reg n = rsi
  reg i = rcx
  reg s = rax
  reg byte_val = r8
  reg addr = r9

  // Initialize: s = 1, i = 0
  s := 1
  i := 0
  
  loop {
    place {
      name idx = i
      name cur = s
      fact 0 <= idx
      fact idx <= n
      fact cur == s1(input)[idx]
      fact cur < 65521
      decreases n - idx
    }
    
    cmp i, n
    break if eq
    
    // Load byte directly using base+index addressing
    // Note: movzx with base+index is not allowed, so we need separate LEA
    lea addr, [input + i]
    movzx r8d, byte ptr [addr]
    
    // Add to s and conditionally subtract 65521
    add s, r8
    cmp s, 65521
    jb @skip
    sub s, 65521
  @skip:
    
    add i, 1
  }
  
  ret
}

