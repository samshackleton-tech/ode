target arm64

fn sha256_big_sigma_4x as "ode_sha256_big_sigma_4x" {
  // Inputs: x0 = out (16 bytes), x1 = a (16 bytes), x2 = e (16 bytes)
  
  // Load inputs
  ld1 {v0.4s}, [x1]  // v0 = a
  ld1 {v1.4s}, [x2]  // v1 = e
  
  // Compute Sigma0(a) = ROTR^2(a) ^ ROTR^13(a) ^ ROTR^22(a)
  // Optimize by computing rotations in a more efficient order
  
  // Compute ROTR^2(a) and start ROTR^13(a) in parallel
  ushr v2.4s, v0.4s, 2      // a >>> 2
  shl v3.4s, v0.4s, 30      // a << 30
  ushr v4.4s, v0.4s, 13     // a >>> 13
  
  // Complete ROTR^2(a) and start ROTR^22(a)
  orr v2.16b, v2.16b, v3.16b  // ROTR^2(a)
  shl v3.4s, v0.4s, 19      // a << 19
  ushr v5.4s, v0.4s, 22     // a >>> 22
  
  // Complete ROTR^13(a) and XOR with ROTR^2(a)
  orr v4.16b, v4.16b, v3.16b  // ROTR^13(a)
  eor v2.16b, v2.16b, v4.16b  // Partial Sigma0
  
  // Complete ROTR^22(a) and finish Sigma0
  shl v3.4s, v0.4s, 10      // a << 10
  orr v5.16b, v5.16b, v3.16b  // ROTR^22(a)
  eor v2.16b, v2.16b, v5.16b  // v2 = Sigma0(a)
  
  // Compute Sigma1(e) = ROTR^6(e) ^ ROTR^11(e) ^ ROTR^25(e)
  // Similar optimized pattern
  
  // Compute ROTR^6(e) and start ROTR^11(e) in parallel
  ushr v3.4s, v1.4s, 6      // e >>> 6
  shl v4.4s, v1.4s, 26      // e << 26
  ushr v5.4s, v1.4s, 11     // e >>> 11
  
  // Complete ROTR^6(e) and start ROTR^25(e)
  orr v3.16b, v3.16b, v4.16b  // ROTR^6(e)
  shl v4.4s, v1.4s, 21      // e << 21
  ushr v6.4s, v1.4s, 25     // e >>> 25
  
  // Complete ROTR^11(e) and XOR with ROTR^6(e)
  orr v5.16b, v5.16b, v4.16b  // ROTR^11(e)
  eor v3.16b, v3.16b, v5.16b  // Partial Sigma1
  
  // Complete ROTR^25(e) and finish Sigma1
  shl v4.4s, v1.4s, 7       // e << 7
  orr v6.16b, v6.16b, v4.16b  // ROTR^25(e)
  eor v3.16b, v3.16b, v6.16b  // v3 = Sigma1(e)
  
  // Add Sigma0(a) + Sigma1(e) modulo 2^32
  add v0.4s, v2.4s, v3.4s
  
  // Store result
  st1 {v0.4s}, [x0]
  
  ret
}

