target x86_64

fn b64_char_val as "ode_b64_char_val" {
  reg b = rdi
  reg res = rax
  reg tmp = rcx
  
  // Check uppercase A-Z (65-90) -> 0-25
  cmp b, 65
  if lo {
    jmp @check_digit
  }
  cmp b, 91
  if uge {
    jmp @check_lower
  }
  res := b
  sub res, 65
  ret
  
@check_lower:
  // Check lowercase a-z (97-122) -> 26-51
  cmp b, 97
  if lo {
    jmp @check_plus
  }
  cmp b, 123
  if uge {
    jmp @check_plus
  }
  res := b
  sub res, 71
  ret
  
@check_digit:
  // Check digits 0-9 (48-57) -> 52-61
  cmp b, 48
  if lo {
    jmp @check_plus
  }
  cmp b, 58
  if uge {
    jmp @check_plus
  }
  res := b
  add res, 4
  ret
  
@check_plus:
  // Combine plus and slash checks
  cmp b, 43
  je @plus
  cmp b, 47
  je @slash
  jmp @invalid
  
@plus:
  res := 62
  ret
  
@slash:
  res := 63
  ret
  
@invalid:
  res := 255
  ret
}

