target x86_64

fn sha256_big_sigma_4x as "ode_sha256_big_sigma_4x" {
  reg out_ptr = rdi
  reg a_ptr = rsi
  reg e_ptr = rdx

  // Load inputs
  vmovdqu xmm0, [a_ptr]    // a
  vmovdqu xmm1, [e_ptr]    // e

  // Compute all right shifts for a in parallel
  vpsrld xmm2, xmm0, 2
  vpsrld xmm3, xmm0, 13
  vpsrld xmm4, xmm0, 22

  // Compute all left shifts for a in parallel
  vpslld xmm5, xmm0, 30
  vpslld xmm6, xmm0, 19
  vpslld xmm7, xmm0, 10

  // Combine to rotations
  vpor   xmm2, xmm2, xmm5   // rot2
  vpor   xmm3, xmm3, xmm6   // rot13
  vpor   xmm4, xmm4, xmm7   // rot22

  // Sigma0 = rot2 ^ rot13 ^ rot22
  vpxor  xmm2, xmm2, xmm3
  vpxor  xmm2, xmm2, xmm4   // xmm2 = Sigma0(a)

  // Compute all right shifts for e in parallel (reuse temps)
  vpsrld xmm3, xmm1, 6
  vpsrld xmm4, xmm1, 11
  vpsrld xmm5, xmm1, 25

  // Compute left shifts for e (reuse xmm6/xmm7 and xmm0)
  vpslld xmm6, xmm1, 26
  vpslld xmm7, xmm1, 21
  vpslld xmm0, xmm1, 7

  // Combine to rotations
  vpor   xmm3, xmm3, xmm6   // rot6
  vpor   xmm4, xmm4, xmm7   // rot11
  vpor   xmm5, xmm5, xmm0   // rot25

  // Sigma1 = rot6 ^ rot11 ^ rot25
  vpxor  xmm3, xmm3, xmm4
  vpxor  xmm3, xmm3, xmm5   // xmm3 = Sigma1(e)

  // Add Sigma0 + Sigma1 across 4 lanes
  vpaddd xmm2, xmm2, xmm3

  // Store result
  vmovdqu [out_ptr], xmm2
  ret
}

