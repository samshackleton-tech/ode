target arm64

fn sha256_big_sigma_4x as "ode_sha256_big_sigma_4x" {
  // Inputs: x0 = out (16 bytes), x1 = a (16 bytes), x2 = e (16 bytes)
  
  // Load inputs
  ld1 {v0.4s}, [x1]  // v0 = a
  ld1 {v1.4s}, [x2]  // v1 = e
  
  // Compute Sigma0(a) = ROTR^2(a) ^ ROTR^13(a) ^ ROTR^22(a)
  // Compute all rotations in parallel to break dependency chain
  
  // ROTR^2(a) = (a >>> 2) | (a << 30)
  ushr v2.4s, v0.4s, 2      // a >>> 2
  shl v3.4s, v0.4s, 30      // a << 30
  
  // ROTR^13(a) = (a >>> 13) | (a << 19)
  ushr v4.4s, v0.4s, 13     // a >>> 13
  shl v5.4s, v0.4s, 19      // a << 19
  
  // ROTR^22(a) = (a >>> 22) | (a << 10)
  ushr v6.4s, v0.4s, 22     // a >>> 22
  shl v7.4s, v0.4s, 10      // a << 10
  
  // Combine rotations
  orr v2.16b, v2.16b, v3.16b  // ROTR^2(a)
  orr v4.16b, v4.16b, v5.16b  // ROTR^13(a)
  orr v6.16b, v6.16b, v7.16b  // ROTR^22(a)
  
  // XOR rotations for Sigma0
  eor v2.16b, v2.16b, v4.16b
  eor v2.16b, v2.16b, v6.16b  // v2 = Sigma0(a)
  
  // Compute Sigma1(e) = ROTR^6(e) ^ ROTR^11(e) ^ ROTR^25(e)
  // Reuse v3-v7 registers for parallel computation
  
  // ROTR^6(e) = (e >>> 6) | (e << 26)
  ushr v3.4s, v1.4s, 6      // e >>> 6
  shl v4.4s, v1.4s, 26      // e << 26
  
  // ROTR^11(e) = (e >>> 11) | (e << 21)
  ushr v5.4s, v1.4s, 11     // e >>> 11
  shl v6.4s, v1.4s, 21      // e << 21
  
  // ROTR^25(e) = (e >>> 25) | (e << 7)
  ushr v7.4s, v1.4s, 25     // e >>> 25
  shl v0.4s, v1.4s, 7       // e << 7 (reuse v0 since a is no longer needed)
  
  // Combine rotations
  orr v3.16b, v3.16b, v4.16b  // ROTR^6(e)
  orr v5.16b, v5.16b, v6.16b  // ROTR^11(e)
  orr v7.16b, v7.16b, v0.16b  // ROTR^25(e)
  
  // XOR rotations for Sigma1
  eor v3.16b, v3.16b, v5.16b
  eor v3.16b, v3.16b, v7.16b  // v3 = Sigma1(e)
  
  // Add Sigma0(a) + Sigma1(e) modulo 2^32
  add v0.4s, v2.4s, v3.4s
  
  // Store result
  st1 {v0.4s}, [x0]
  
  ret
}

