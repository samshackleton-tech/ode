target x86_64

fn sha256_big_sigma_4x as "ode_sha256_big_sigma_4x" {
  reg out_ptr = rdi
  reg a_ptr = rsi
  reg e_ptr = rdx

  // Load inputs - use AVX for wider loads if available, but contract only needs SSE
  vmovdqu xmm0, [a_ptr]  // a
  vmovdqu xmm1, [e_ptr]  // e

  // Compute Sigma0(a) = (a >>> 2) ^ (a >>> 13) ^ (a >>> 22)
  // Optimized for Zen5: minimize dependencies, maximize parallel execution
  
  // xmm2 = a >>> 2
  vpsrld xmm2, xmm0, 2
  vpslld xmm3, xmm0, 30
  vpor xmm2, xmm2, xmm3
  
  // xmm3 = a >>> 13 (reuse xmm3 after por)
  vpsrld xmm3, xmm0, 13
  vpslld xmm4, xmm0, 19
  vpor xmm3, xmm3, xmm4
  
  // xmm4 = a >>> 22 (reuse xmm4 after por)
  vpsrld xmm4, xmm0, 22
  vpslld xmm5, xmm0, 10
  vpor xmm4, xmm4, xmm5
  
  // Combine Sigma0 - optimized XOR chain
  vpxor xmm2, xmm2, xmm3
  vpxor xmm2, xmm2, xmm4

  // Compute Sigma1(e) = (e >>> 6) ^ (e >>> 11) ^ (e >>> 25)
  // Use xmm0 as temporary since original a no longer needed
  
  // xmm3 = e >>> 6
  vpsrld xmm3, xmm1, 6
  vpslld xmm0, xmm1, 26
  vpor xmm3, xmm3, xmm0
  
  // xmm4 = e >>> 11
  vpsrld xmm4, xmm1, 11
  vpslld xmm0, xmm1, 21
  vpor xmm4, xmm4, xmm0
  
  // xmm5 = e >>> 25
  vpsrld xmm5, xmm1, 25
  vpslld xmm0, xmm1, 7
  vpor xmm5, xmm5, xmm0
  
  // Combine Sigma1 - optimized XOR chain
  vpxor xmm3, xmm3, xmm4
  vpxor xmm3, xmm3, xmm5

  // Add Sigma0(a) + Sigma1(e) modulo 2^32
  vpaddd xmm0, xmm2, xmm3

  // Store result
  vmovdqu [out_ptr], xmm0
  ret
}

