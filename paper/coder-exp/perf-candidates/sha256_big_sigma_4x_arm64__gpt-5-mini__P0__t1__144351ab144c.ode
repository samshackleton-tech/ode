target arm64

fn sha256_big_sigma_4x as "ode_sha256_big_sigma_4x" {
  // Inputs: x0 = out (16 bytes), x1 = a (16 bytes), x2 = e (16 bytes)
  // Strategy: compute all lane-wise shifts for a and e in an interleaved way
  // to expose parallelism on Apple M microarchitectures, then combine.

  // Load vectors
  ld1 {v0.4s}, [x1]   // v0 = a[0..3]
  ld1 {v1.4s}, [x2]   // v1 = e[0..3]

  // Compute logical right parts (a >>> 2,13,22) and (e >>> 6,11,25) interleaved
  ushr v2.4s, v0.4s, 2    // a >>> 2
  ushr v5.4s, v1.4s, 6    // e >>> 6
  ushr v3.4s, v0.4s, 13   // a >>> 13
  ushr v6.4s, v1.4s, 11   // e >>> 11
  ushr v4.4s, v0.4s, 22   // a >>> 22
  ushr v7.4s, v1.4s, 25   // e >>> 25

  // Compute left parts (a << 30,19,10) and (e << 26,21,7) interleaved
  shl v8.4s, v0.4s, 30    // a << 30
  shl v9.4s, v1.4s, 26    // e << 26
  shl v10.4s, v0.4s, 19   // a << 19
  shl v11.4s, v1.4s, 21   // e << 21
  shl v12.4s, v0.4s, 10   // a << 10
  shl v13.4s, v1.4s, 7    // e << 7

  // Combine rotates for a: ROTR2 = (>>>2)|(<<30), ROTR13 = (>>>13)|(<<19), ROTR22 = (>>>22)|(<<10)
  orr v2.16b, v2.16b, v8.16b    // rot2(a)
  orr v3.16b, v3.16b, v10.16b   // rot13(a)
  orr v4.16b, v4.16b, v12.16b   // rot22(a)
  eor v2.16b, v2.16b, v3.16b
  eor v2.16b, v2.16b, v4.16b    // v2 = Sigma0(a)

  // Combine rotates for e: ROTR6 = (>>>6)|(<<26), ROTR11 = (>>>11)|(<<21), ROTR25 = (>>>25)|(<<7)
  orr v5.16b, v5.16b, v9.16b    // rot6(e)
  orr v6.16b, v6.16b, v11.16b   // rot11(e)
  orr v7.16b, v7.16b, v13.16b   // rot25(e)
  eor v5.16b, v5.16b, v6.16b
  eor v5.16b, v5.16b, v7.16b    // v5 = Sigma1(e)

  // Add modulo 2^32 across lanes and store
  add v0.4s, v2.4s, v5.4s
  st1 {v0.4s}, [x0]

  ret
}

