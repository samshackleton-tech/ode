target x86_64

fn b64_char_val as "ode_b64_char_val" {
  reg b = rdi
  reg res = rax

  // Uppercase A-Z ?
  cmp b, 65
  jb @check_lower
  cmp b, 91
  jae @check_lower
  res := b
  sub res, 65
  jmp @done

@check_lower:
  // Lowercase a-z ?
  cmp b, 97
  jb @check_digit
  cmp b, 123
  jae @check_digit
  res := b
  sub res, 71
  jmp @done

@check_digit:
  // Digit 0-9 ?
  cmp b, 48
  jb @check_plus
  cmp b, 58
  jae @check_plus
  res := b
  add res, 4
  jmp @done

@check_plus:
  // '+' or '/' ?
  cmp b, 43
  je @is_plus
  cmp b, 47
  je @is_slash
  res := 255
  jmp @done

@is_plus:
  res := 62
  jmp @done

@is_slash:
  res := 63

@done:
  ret
}

