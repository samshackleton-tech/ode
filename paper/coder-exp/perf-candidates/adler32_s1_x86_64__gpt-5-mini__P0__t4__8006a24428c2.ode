target x86_64

fn adler32_s1 as "ode_adler32_s1" {
  reg input = rdi
  reg n = rsi
  reg i = rcx
  reg s = rax
  reg byte_val = r8
  reg addr = r9

  // Initialize: s = 1, i = 0
  s := 1
  i := 0

  loop {
    place {
      name idx = i
      name cur = s
      fact 0 <= idx
      fact idx <= n
      fact cur == s1(input)[idx]
      fact cur < 65521
      decreases n - idx
    }

    cmp i, n
    break if eq

    // Compute address and load byte, then add to s
    lea addr, [input + i]
    movzx r8d, byte ptr [addr]
    add s, r8

    // Single-branch reduction modulo 65521
    cmp s, 65521
    if uge {
      sub s, 65521
    }

    add i, 1
  }

  ret
}

