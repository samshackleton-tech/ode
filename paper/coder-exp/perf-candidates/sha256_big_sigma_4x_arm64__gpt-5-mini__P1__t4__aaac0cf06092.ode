target arm64

fn sha256_big_sigma_4x as "ode_sha256_big_sigma_4x" {
  // Inputs: x0 = out (16 bytes), x1 = a (16 bytes), x2 = e (16 bytes)
  // Aim: shorten dependency chains by computing independent shifts for a and e
  // in parallel, then combining rotations in a balanced way.

  // Load inputs
  ld1 {v0.4s}, [x1]   // v0 = a
  ld1 {v1.4s}, [x2]   // v1 = e

  // Compute all right-shifts (independent)
  ushr v2.4s, v0.4s, 2    // a >>> 2
  ushr v3.4s, v0.4s, 13   // a >>> 13
  ushr v4.4s, v0.4s, 22   // a >>> 22

  ushr v5.4s, v1.4s, 6    // e >>> 6
  ushr v6.4s, v1.4s, 11   // e >>> 11
  ushr v7.4s, v1.4s, 25   // e >>> 25

  // Compute all left-shifts (independent)
  shl  v8.4s, v0.4s, 30   // a << 30
  shl  v9.4s, v0.4s, 19   // a << 19
  shl  v10.4s, v0.4s, 10  // a << 10

  shl  v11.4s, v1.4s, 26  // e << 26
  shl  v12.4s, v1.4s, 21  // e << 21
  shl  v13.4s, v1.4s, 7   // e << 7

  // Form rotations (each is one-layer OR from two independent shifts)
  orr v2.16b, v2.16b, v8.16b   // ROTR2(a)
  orr v3.16b, v3.16b, v9.16b   // ROTR13(a)
  orr v4.16b, v4.16b, v10.16b  // ROTR22(a)

  orr v5.16b, v5.16b, v11.16b  // ROTR6(e)
  orr v6.16b, v6.16b, v12.16b  // ROTR11(e)
  orr v7.16b, v7.16b, v13.16b  // ROTR25(e)

  // XOR rotations using a balanced tree to minimize dependent depth
  eor v2.16b, v2.16b, v3.16b
  eor v2.16b, v2.16b, v4.16b    // v2 = Sigma0(a)

  eor v5.16b, v5.16b, v6.16b
  eor v5.16b, v5.16b, v7.16b    // v5 = Sigma1(e)

  // Add and store
  add v0.4s, v2.4s, v5.4s
  st1 {v0.4s}, [x0]

  ret
}

