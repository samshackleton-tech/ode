use spec = "n5o4vitubew6gh2somiofk25h6sxsrbnyi3kmae2kqpt75pzrzsa"  // byte_sum_spec.ode

fn byte_sum(a: n bytes, n: number)
    requires n <= 1048576
    returns spec.byte_sum(a)
    trace depends on n
    stack 0
{
    var i: u64 := 0
    var s0: u64 := 0
    var s1: u64 := 0
    while i + 4 <= n
        maintains i <= n, s0 + s1 <= i * 255
        maintains spec.byte_sum(a) == spec.sum_from(a, i, s0 + s1)
        decreases n - i
    {
        s0 += a[i]
        s1 += a[i + 1]
        s0 += a[i + 2]
        s1 += a[i + 3]
        i += 4
    }
    var acc: u64 := s0 + s1
    while i < n
        maintains i <= n, acc <= i * 255
        maintains spec.byte_sum(a) == spec.sum_from(a, i, acc)
        decreases n - i
    {
        acc += a[i]
        i += 1
    }
    return acc
}
