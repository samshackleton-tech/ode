use spec = "5p2s6autx4gpak5n34fuom4egxjthz6l34sma2uko5hjwpw2dmta"  // json_str_valid_spec.ode

fn check_hex(c: u8) -> u64
    returns spec.is_hex(c)
    trace depends on c
{
    if 48 <= c && c <= 57 { return 1 }
    if 65 <= c && c <= 70 { return 1 }
    if 97 <= c && c <= 102 { return 1 }
    return 0
}

fn json_str_valid(src: n bytes, n: number)
    requires n <= 4096
    returns spec.json_str_valid(src)
    trace depends on src, n
    stack 32
{
    if n < 2 { return 0 }
    if src[0] != 34 { return 0 }
    let end: u64 := n - 1
    if src[end] != 34 { return 0 }
    var i: u64 := 1
    while i < end
        maintains 1 <= i, i <= end
        maintains spec.json_str_valid(src) == spec.json_body_valid(src, i, end)
        decreases end - i
    {
        let c: u64 := src[i]
        if c == 92 {
            if i + 1 >= end { return 0 }
            let e: u64 := src[i + 1]
            if e == 34 || e == 92 || e == 47 || e == 98 || e == 102 || e == 110 || e == 114 || e == 116 {
                i += 2
            } else if e == 117 {
                if i + 5 >= end { return 0 }
                if check_hex(src[i + 2]) != 1 { return 0 }
                if check_hex(src[i + 3]) != 1 { return 0 }
                if check_hex(src[i + 4]) != 1 { return 0 }
                if check_hex(src[i + 5]) != 1 { return 0 }
                i += 6
            } else {
                return 0
            }
        } else {
            if c < 32 || c == 34 || c > 126 { return 0 }
            i += 1
        }
    }
    return 1
}
