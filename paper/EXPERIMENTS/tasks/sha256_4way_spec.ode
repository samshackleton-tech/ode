// FIPS 180-4 SHA-256 compression function, 4-way parallel batch (`sha256_4way`).
//
// Each block takes 8 state words `h[0..7]`, 16 message words `m[0..15]`, and the
// 64 round constants `k[0..63]` (32-bit unsigned words, little-endian in memory)
// and produces the 8 updated state words after all 64 FIPS 180-4 rounds plus
// Davies-Meyer feed-forward addition.
//
// `sha256_4way(hs, ms, k)` compresses 4 independent blocks laid out contiguously:
//   hs[0..7],   ms[0..15]  -> out[0..7]
//   hs[8..15],  ms[16..31] -> out[8..15]
//   hs[16..23], ms[32..47] -> out[16..23]
//   hs[24..31], ms[48..63] -> out[24..31]

def ch(e, f, g)  { g ^ (e & (f ^ g)) }
def maj(a, b, c) { (a & b) ^ ((a ^ b) & c) }

def big_s0(a) { ((a >>> 2) ^ (a >>> 13)) ^ (a >>> 22) }
def big_s1(e) { ((e >>> 6) ^ (e >>> 11)) ^ (e >>> 25) }
def sm_s0(x)  { ((x >>> 7) ^ (x >>> 18)) ^ (x >> 3) }
def sm_s1(x)  { ((x >>> 17) ^ (x >>> 19)) ^ (x >> 10) }

def sha256_w_step(w, t) {
    let wt = sm_s1(w[t - 2]) + w[t - 7] + sm_s0(w[t - 15]) + w[t - 16]
    w ++ [wt]
}

def sha256_sched(m) {
    let w[0] = m
    let w[i + 1] = sha256_w_step(w[i], 16 + i)
    w[48]
}

def sha256_round(s, wt, kt) {
    let t1 = s[7] + big_s1(s[4]) + ch(s[4], s[5], s[6]) + kt + wt
    let t2 = big_s0(s[0]) + maj(s[0], s[1], s[2])
    [t1 + t2, s[0], s[1], s[2], s[3] + t1, s[4], s[5], s[6]]
}

def sha256_compress(h, m, k) {
    let w = sha256_sched(m)
    let r[0] = h
    let r[t + 1] = sha256_round(r[t], w[t], k[t])
    let f = r[64]
    [h[i] + f[i] for i in 0..8]
}

def sha256_4way(hs, ms, k) {
    sha256_compress(hs[0..8], ms[0..16], k)
    ++ sha256_compress(hs[8..16], ms[16..32], k)
    ++ sha256_compress(hs[16..24], ms[32..48], k)
    ++ sha256_compress(hs[24..32], ms[48..64], k)
}
