// RFC 3629 / Unicode Table 3-7 well-formed UTF-8 byte-sequence specification.
// Returns 1 if `src` is a valid UTF-8 byte sequence, 0 otherwise.
// Rejects overlong encodings (C0..C1, E0 80..9F, F0 80..8F), UTF-16 surrogates
// (ED A0..BF), code points above U+10FFFF (F4 90..BF, F5..FF), lone
// continuations (80..BF), and truncated multi-byte sequences.

def utf8_from(src, i) {
    if i == len(src) then 1
    else if src[i] < 128 then utf8_from(src, i + 1)
    else if src[i] < 194 then 0
    else if src[i] <= 223 then
        if i + 2 > len(src) then 0
        else if src[i + 1] < 128 then 0
        else if src[i + 1] > 191 then 0
        else utf8_from(src, i + 2)
    else if src[i] <= 239 then
        if i + 3 > len(src) then 0
        else if src[i + 2] < 128 then 0
        else if src[i + 2] > 191 then 0
        else if src[i] == 224 then (if src[i + 1] < 160 then 0 else if src[i + 1] > 191 then 0 else utf8_from(src, i + 3))
        else if src[i] == 237 then (if src[i + 1] < 128 then 0 else if src[i + 1] > 159 then 0 else utf8_from(src, i + 3))
        else if src[i + 1] < 128 then 0
        else if src[i + 1] > 191 then 0
        else utf8_from(src, i + 3)
    else if src[i] <= 244 then
        if i + 4 > len(src) then 0
        else if src[i + 2] < 128 then 0
        else if src[i + 2] > 191 then 0
        else if src[i + 3] < 128 then 0
        else if src[i + 3] > 191 then 0
        else if src[i] == 240 then (if src[i + 1] < 144 then 0 else if src[i + 1] > 191 then 0 else utf8_from(src, i + 4))
        else if src[i] == 244 then (if src[i + 1] < 128 then 0 else if src[i + 1] > 143 then 0 else utf8_from(src, i + 4))
        else if src[i + 1] < 128 then 0
        else if src[i + 1] > 191 then 0
        else utf8_from(src, i + 4)
    else 0
}

def utf8_valid(src) { utf8_from(src, 0) }
