// RFC 8259 Section 7 ASCII JSON string literal validator specification.
//
// Returns 1 iff `src[0..len(src)]` is a valid ASCII JSON string literal:
//   - starts and ends with `"` (34), length >= 2
//   - every interior byte is printable ASCII (32..126) except unescaped `"` (34) or `\` (92)
//   - every `\` (92) starts either a 2-byte escape (`\"`, `\\`, `\/`, `\b`, `\f`, `\n`, `\r`, `\t`)
//     or a 6-byte Unicode escape `\uXXXX` with four hexadecimal digits (`0-9`, `A-F`, `a-f`).

def is_hex(c) {
    if 48 <= c && c <= 57 then 1
    else if 65 <= c && c <= 70 then 1
    else if 97 <= c && c <= 102 then 1
    else 0
}

def is_simple_esc(c) {
    if c == 34 || c == 92 || c == 47 || c == 98 || c == 102 || c == 110 || c == 114 || c == 116 then 1
    else 0
}

def json_body_valid(src, i, end) {
    if i >= end then 1
    else if src[i] == 92 then
        if i + 1 >= end then 0
        else if is_simple_esc(src[i + 1]) == 1 then json_body_valid(src, i + 2, end)
        else if src[i + 1] == 117 then
            if i + 5 >= end then 0
            else if is_hex(src[i + 2]) == 1 && is_hex(src[i + 3]) == 1
                 && is_hex(src[i + 4]) == 1 && is_hex(src[i + 5]) == 1 then
                json_body_valid(src, i + 6, end)
            else 0
        else 0
    else if src[i] < 32 || src[i] == 34 || src[i] > 126 then 0
    else json_body_valid(src, i + 1, end)
}

def json_str_valid(src) {
    if len(src) < 2 then 0
    else if src[0] != 34 then 0
    else if src[len(src) - 1] != 34 then 0
    else json_body_valid(src, 1, len(src) - 1)
}
