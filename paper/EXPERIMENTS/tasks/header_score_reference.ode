use spec = "bourqgxpsrzluwqzc3svwwby2izmw3vn2svqtqylbyrqaqwsax3q"  // header_score_spec.ode

fn header_score(h: n bytes, n: number)
    requires n == 16
    returns spec.header_score(h)
    trace depends on h, n
    stack 0
{
    var s: u64 := 0
    if h[0] >= 128 { s += 17 }
    join maintains s <= 17, s == spec.s1(h)
    if h[1] >= 64  { s += 23 }
    join maintains s <= 40, s == spec.s2(h)
    if h[2] >= 200 { s += 31 }
    join maintains s <= 71, s == spec.s3(h)
    if h[3] == 0   { s += 41 }
    join maintains s <= 112, s == spec.s4(h)
    if h[4] >= 100 { s += 13 }
    join maintains s <= 125, s == spec.s5(h)
    if h[5] < 16   { s += 29 }
    join maintains s <= 154, s == spec.s6(h)
    if h[6] >= 180 { s += 37 }
    join maintains s <= 191, s == spec.s7(h)
    if h[7] == 255 { s += 53 }
    join maintains s <= 244, s == spec.s8(h)
    if h[8] >= 90  { s += 19 }
    join maintains s <= 263, s == spec.s9(h)
    if h[9] < 40   { s += 43 }
    join maintains s <= 306, s == spec.s10(h)
    if h[10] >= 150 { s += 11 }
    join maintains s <= 317, s == spec.s11(h)
    if h[11] == 42 { s += 59 }
    join maintains s <= 376, s == spec.s12(h)
    if h[12] >= 220 { s += 47 }
    join maintains s <= 423, s == spec.s13(h)
    if h[13] < 32  { s += 61 }
    join maintains s <= 484, s == spec.s14(h)
    if h[14] >= 75 { s += 29 }
    join maintains s <= 513, s == spec.s15(h)
    if h[15] == 1  { s += 71 }
    return s
}
