use spec = "ipv4_valid_spec.ode"

// RFC 791 IPv4 packet header validator + RFC 1071 one's-complement header checksum.
fn ipv4_valid(pkt: n bytes, n: number)
    requires n <= 65535
    returns spec.ipv4_valid(pkt)
    trace depends on pkt, n
    stack 0
{
    for x86_64 {
        cmp rsi, 20
        jb @bad
        movzx eax, byte ptr [rdi]
        mov rcx, rax
        shr rcx, 4
        cmp rcx, 4
        jne @bad
        and rax, 15
        cmp rax, 5
        jb @bad
        mov r11, rax
        shl r11, 1          // words = 2 * ihl (10..30)
        shl rax, 2          // hlen = 4 * ihl (20..60)
        cmp rax, rsi
        ja @bad
        movzx edx, byte ptr [rdi + 2]
        shl rdx, 8
        movzx r8d, byte ptr [rdi + 3]
        add rdx, r8         // totlen = pkt[2]*256 + pkt[3]
        cmp rdx, rax
        jb @bad
        cmp rdx, rsi
        ja @bad

        // Sum all 2*ihl big-endian 16-bit halfwords in pkt[0 .. 4*ihl)
        rcx := 0            // k = 0
        rdx := 0            // acc = 0
        place {
            fact 0 <= rcx
            fact rcx <= r11
            fact r11 <= 30
            fact r11 * 2 <= n
            fact rdx <= rcx * 65535
            keep rdi, rsi, r11
            fact spec.ipv4_valid(pkt) == spec.sum16_check(pkt, rcx, r11, rdx)
            decreases r11 - rcx
        }
    @sum_loop:
        cmp rcx, r11
        jae @fold
        mov r8, rcx
        shl r8, 1
        add r8, rdi
        movzx r9d, byte ptr [r8]
        shl r9, 8
        movzx r10d, byte ptr [r8 + 1]
        add r9, r10
        add rdx, r9
        add rcx, 1
        jmp @sum_loop

    @fold:
        // Fold twice: fold16_once(fold16_once(acc))
        mov r8, rdx
        and rdx, 65535
        shr r8, 16
        add rdx, r8
        mov r8, rdx
        and rdx, 65535
        shr r8, 16
        add rdx, r8
        cmp rdx, 65535
        jne @bad
        rax := 1
        ret
    @bad:
        rax := 0
        ret
    }
    for arm64 {
        cmp x1, 20
        b.lo @bad
        ldrb w2, [x0, 0]
        lsr x3, x2, 4
        cmp x3, 4
        b.ne @bad
        x9 := 15
        and x2, x2, x9
        cmp x2, 5
        b.lo @bad
        lsl x8, x2, 1       // words = 2 * ihl (10..30)
        lsl x2, x2, 2       // hlen = 4 * ihl (20..60)
        cmp x2, x1
        b.hi @bad
        ldrb w4, [x0, 2]
        lsl x4, x4, 8
        ldrb w5, [x0, 3]
        add x4, x4, x5      // totlen
        cmp x4, x2
        b.lo @bad
        cmp x4, x1
        b.hi @bad

        x3 := 0             // k = 0
        x4 := 0             // acc = 0
        place {
            fact 0 <= x3
            fact x3 <= x8
            fact x8 <= 30
            fact x8 * 2 <= n
            fact x4 <= x3 * 65535
            keep x0, x1, x8
            fact spec.ipv4_valid(pkt) == spec.sum16_check(pkt, x3, x8, x4)
            decreases x8 - x3
        }
    @sum_loop:
        cmp x3, x8
        b.hs @fold
        lsl x5, x3, 1
        add x5, x0, x5
        ldrb w6, [x5, 0]
        lsl x6, x6, 8
        ldrb w7, [x5, 1]
        add x6, x6, x7
        add x4, x4, x6
        add x3, x3, 1
        b @sum_loop

    @fold:
        x9 := 65535
        lsr x5, x4, 16
        and x4, x4, x9
        add x4, x4, x5
        lsr x5, x4, 16
        and x4, x4, x9
        add x4, x4, x5
        cmp x4, x9
        b.ne @bad
        x0 := 1
        ret
    @bad:
        x0 := 0
        ret
    }
}
