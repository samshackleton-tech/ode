use spec = "vq5izfremyqughwylrwyy6oa7dzomjky6jpn7hpdsr75lm6flkna"  // ipv4_valid_spec.ode

fn ipv4_valid(pkt: n bytes, n: number)
    requires n <= 65535
    returns spec.ipv4_valid(pkt)
    trace depends on pkt, n
    stack 0
{
    if n < 20 { return 0 }
    let b0: u64 := pkt[0]
    if (b0 >> 4) != 4 { return 0 }
    let ihl: u64 := b0 & 15
    if ihl < 5 { return 0 }
    let hdr: u64 := ihl << 2
    if hdr > n { return 0 }
    let tlen: u64 := (pkt[2] << 8) + pkt[3]
    if tlen < hdr { return 0 }
    if tlen > n { return 0 }
    let words: u64 := ihl << 1
    var acc: u64 := 0
    for k in 0..words
        maintains acc <= k * 65535
        maintains spec.sum16_check(pkt, 0, words, 0) == spec.sum16_check(pkt, k, words, acc)
    {
        let off: u64 := k << 1
        acc += (pkt[off] << 8) + pkt[off + 1]
    }
    let f1: u64 := (acc & 65535) + (acc >> 16)
    let f2: u64 := (f1 & 65535) + (f1 >> 16)
    if f2 == 65535 { return 1 }
    return 0
}
