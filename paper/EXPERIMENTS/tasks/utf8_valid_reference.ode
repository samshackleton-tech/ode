use spec = "e2alztpsinfciojsntay3as2yanhiy7ppbmf2xhbidbxtvnnbava"  // utf8_valid_spec.ode

fn utf8_valid(src: n bytes, n: number)
    requires n <= 4096
    returns spec.utf8_valid(src)
    trace depends on src, n
    stack 0
{
    var i: u64 := 0
    while i < n
        maintains i <= n
        maintains spec.utf8_valid(src) == spec.utf8_from(src, i)
        decreases n - i
    {
        if i + 4 <= n && src[i] < 128 && src[i + 1] < 128 && src[i + 2] < 128 && src[i + 3] < 128 {
            i += 4
            continue
        }
        let b0: u64 := src[i]
        if b0 < 128 {
            i += 1
        } else if b0 < 194 {
            return 0
        } else if b0 <= 223 {
            if i + 2 > n { return 0 }
            let c1: u64 := src[i + 1]
            if c1 < 128 || c1 > 191 { return 0 }
            i += 2
        } else if b0 <= 239 {
            if i + 3 > n { return 0 }
            let c2: u64 := src[i + 2]
            if c2 < 128 || c2 > 191 { return 0 }
            let c1: u64 := src[i + 1]
            if b0 == 224 {
                if c1 < 160 || c1 > 191 { return 0 }
            } else if b0 == 237 {
                if c1 < 128 || c1 > 159 { return 0 }
            } else {
                if c1 < 128 || c1 > 191 { return 0 }
            }
            i += 3
        } else if b0 <= 244 {
            if i + 4 > n { return 0 }
            let c2: u64 := src[i + 2]
            if c2 < 128 || c2 > 191 { return 0 }
            let c3: u64 := src[i + 3]
            if c3 < 128 || c3 > 191 { return 0 }
            let c1: u64 := src[i + 1]
            if b0 == 240 {
                if c1 < 144 || c1 > 191 { return 0 }
            } else if b0 == 244 {
                if c1 < 128 || c1 > 143 { return 0 }
            } else {
                if c1 < 128 || c1 > 191 { return 0 }
            }
            i += 4
        } else {
            return 0
        }
    }
    return 1
}
