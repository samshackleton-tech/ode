        in buf = rdi, n = rsi, start = rdx, end = rcx
        out = rax
        preserves rdi, rsi, rbx, rbp, r12, r13, r14, r15
    } {
        reg base = rdi, i = rdx, lim = rcx, at_start = r8, addr = r9, bv = r10, bvw = r10d

        at_start := 1
        place {
            fact start <= i
            fact i <= lim
            fact lim == end
            fact 0 <= at_start
            fact at_start <= 1
            fact spec.oid_ok(buf, start, end, 1) == spec.oid_ok(buf, i, lim, at_start)
            decreases lim - i
        }
    @loop:
        cmp i, lim
        jae @done
        lea addr, [base + i]
        movzx bvw, byte ptr [addr + 0]
        cmp at_start, 1
        jne @check_cont
        cmp bv, 128
        je @bad
    @check_cont:
        cmp bv, 128
        jae @cont
        at_start := 1
        add i, 1
        jmp @loop
    @cont:
        at_start := 0
        add i, 1
        jmp @loop
    @done:
        mov rax, at_start
        ret
    @bad:
        xor eax, eax
        ret
    }
    for arm64 calling {
        in buf = x4, n = x1, start = x2, end = x3
        out = x0
        preserves x4, x1, x19, x20, x21, x22, x23, x24, x25, x26, x27, x28, x29
    } {
        reg base = x4, i = x2, lim = x3, at_start = x5, addr = x6, bv = x7, bvw = w7

        at_start := 1
        place {
            fact start <= i
            fact i <= lim
            fact lim == end
            fact 0 <= at_start
            fact at_start <= 1
            fact spec.oid_ok(buf, start, end, 1) == spec.oid_ok(buf, i, lim, at_start)
            decreases lim - i
        }
    @loop:
        cmp i, lim
        b.hs @done
        add addr, base, i
        ldrb bvw, [addr, 0]
        cmp at_start, 1
        b.ne @check_cont
        cmp bv, 128
        b.eq @bad
    @check_cont:
        cmp bv, 128
        b.hs @cont
        at_start := 1
        add i, i, 1
        b @loop
    @cont:
        at_start := 0
        add i, i, 1
        b @loop
    @done:
        mov x0, at_start
        ret
    @bad:
        mov x0, 0
        ret
    }
}

