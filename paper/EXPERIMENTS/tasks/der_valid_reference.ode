        jne @ok
        cmp r11, 128
        jae @bad
        jmp @ok
    @t_bitstr:
        cmp rcx, 0
        je @bad
        lea r9, [rdi + rdx]
        movzx r11d, byte ptr [r9 + 0]
        cmp r11, 7
        ja @bad
        cmp rcx, 1
        jne @bitstr_nonempty
        cmp r11, 0
        je @ok
        jmp @bad
