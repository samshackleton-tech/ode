        }
    @loop:
        cmp r12, r13
        jae @ok
        lea r10, [r12 + 2]
        cmp r10, r13
        ja @bad
        lea r11, [rdi + r12]
        movzx r9d, byte ptr [r11 + 1]
        cmp r9, 128
        jb @len_short
        cmp r9, 129
        je @len81
        cmp r9, 130
        je @len82
        jmp @bad
    @len_short:
        mov r8, 2
        jmp @have_len
    @len81:
        lea r10, [r12 + 3]
        cmp r10, r13
        ja @bad
        movzx r9d, byte ptr [r11 + 2]
        cmp r9, 128
        jb @bad
        mov r8, 3
        jmp @have_len
    @len82:
        lea r10, [r12 + 4]
        cmp r10, r13
        ja @bad
        movzx r9d, byte ptr [r11 + 2]
        cmp r9, 1
        jb @bad
        shl r9, 8
        movzx r10d, byte ptr [r11 + 3]
        add r9, r10
        mov r8, 4
        place {
            fact pos <= r12
            fact r12 < r13
            fact r13 == end
            fact 2 <= r8
            fact r8 <= 4
            fact 0 <= r9
            fact r9 <= 65535
            fact r12 + r8 <= r13
            fact r8 == spec.der_hdr_len(buf, r12, r13)
            fact r9 == spec.der_val_len(buf, r12, r13)
            fact spec.der_seq(buf, pos, end, 2) == spec.der_seq(buf, r12, r13, 2)
        }
    @have_len:
        lea r10, [r12 + r8]
        add r10, r9
        cmp r10, r13
        ja @bad
        lea r11, [rdi + r12]
        movzx eax, byte ptr [r11 + 0]
        lea rdx, [r12 + r8]
        mov r12, r10
        cmp rax, 48
        je @nested
        mov rcx, r9
        mov r8, rax
        call der_prim_ok_fn
        cmp rax, 0
        je @bad
        jmp @loop
    @nested:
        mov rcx, r10
        call der_seq1
        cmp rax, 0
        je @bad
        jmp @loop
    @ok:
        mov rax, 1
        pop r13
        pop r12
        ret
    @bad:
        xor eax, eax
        pop r13
        pop r12
        ret
    }
    for arm64 calling {
        in buf = x4, n = x1, pos = x2, end = x3
        out = x0
        preserves x4, x1, x19, x20, x21, x22, x23, x24, x25, x26, x27, x28, x29
    } {
        sub sp, sp, 32
        str x30, [sp, 0]
        str x19, [sp, 8]
        str x20, [sp, 16]
        mov x19, x2
        mov x20, x3
        place {
            fact pos <= x19
            fact x19 <= x20
            fact x20 == end
            fact spec.der_seq(buf, pos, end, 2) == spec.der_seq(buf, x19, x20, 2)
            decreases x20 - x19
        }
    @loop:
        cmp x19, x20
        b.hs @ok
        add x7, x19, 2
        cmp x7, x20
        b.hi @bad
        add x9, x4, x19
        ldrb w6, [x9, 1]
        cmp x6, 128
        b.lo @len_short
        cmp x6, 129
        b.eq @len81
        cmp x6, 130
        b.eq @len82
        b @bad
    @len_short:
        mov x5, 2
        b @have_len
    @len81:
        add x7, x19, 3
        cmp x7, x20
        b.hi @bad
        ldrb w6, [x9, 2]
        cmp x6, 128
        b.lo @bad
        mov x5, 3
        b @have_len
    @len82:
        add x7, x19, 4
        cmp x7, x20
        b.hi @bad
        ldrb w6, [x9, 2]
        cmp x6, 1
        b.lo @bad
        lsl x6, x6, 8
        ldrb w8, [x9, 3]
        add x6, x6, x8
        mov x5, 4
        place {
            fact pos <= x19
            fact x19 < x20
            fact x20 == end
            fact 2 <= x5
            fact x5 <= 4
            fact 0 <= x6
            fact x6 <= 65535
            fact x19 + x5 <= x20
            fact x5 == spec.der_hdr_len(buf, x19, x20)
            fact x6 == spec.der_val_len(buf, x19, x20)
            fact spec.der_seq(buf, pos, end, 2) == spec.der_seq(buf, x19, x20, 2)
        }
    @have_len:
        add x7, x19, x5
        add x8, x7, x6
        cmp x8, x20
        b.hi @bad
        add x9, x4, x19
        ldrb w5, [x9, 0]
        mov x2, x7
        mov x19, x8
        cmp x5, 48
        b.eq @nested
        mov x3, x6
        bl der_prim_ok_fn
        cmp x0, 0
        b.eq @bad
        b @loop
    @nested:
        mov x3, x8
        bl der_seq1
        cmp x0, 0
        b.eq @bad
        b @loop
    @ok:
        mov x0, 1
        ldr x20, [sp, 16]
        ldr x19, [sp, 8]
        ldr x30, [sp, 0]
        add sp, sp, 32
        ret
    @bad:
        mov x0, 0
        ldr x20, [sp, 16]
        ldr x19, [sp, 8]
        ldr x30, [sp, 0]
        add sp, sp, 32
        ret
    }
}

fn der_seq3(buf: n bytes, n: number, pos: number, end: number)
    requires pos <= end
    requires end <= n
    requires n <= 65536
    returns spec.der_seq(buf, pos, end, 3)
    trace depends on buf, n, pos, end
    stack 128
{
    for x86_64 calling {
        in buf = rdi, n = rsi, pos = rdx, end = rcx
        out = rax
        preserves rdi, rsi, rbx, rbp, r12, r13, r14, r15
    } {
        push r12
        push r13
        mov r12, rdx
        mov r13, rcx
        place {
            fact pos <= r12
            fact r12 <= r13
            fact r13 == end
            fact spec.der_seq(buf, pos, end, 3) == spec.der_seq(buf, r12, r13, 3)
            decreases r13 - r12
        }
    @loop:
        cmp r12, r13
        jae @ok
        lea r10, [r12 + 2]
        cmp r10, r13
        ja @bad
        lea r11, [rdi + r12]
        movzx r9d, byte ptr [r11 + 1]
        cmp r9, 128
        jb @len_short
        cmp r9, 129
        je @len81
        cmp r9, 130
        je @len82
        jmp @bad
    @len_short:
        mov r8, 2
        jmp @have_len
    @len81:
        lea r10, [r12 + 3]
        cmp r10, r13
        ja @bad
        movzx r9d, byte ptr [r11 + 2]
        cmp r9, 128
        jb @bad
        mov r8, 3
        jmp @have_len
    @len82:
        lea r10, [r12 + 4]
        cmp r10, r13
        ja @bad
        movzx r9d, byte ptr [r11 + 2]
        cmp r9, 1
        jb @bad
        shl r9, 8
        movzx r10d, byte ptr [r11 + 3]
        add r9, r10
        mov r8, 4
        place {
            fact pos <= r12
            fact r12 < r13
            fact r13 == end
            fact 2 <= r8
            fact r8 <= 4
            fact 0 <= r9
            fact r9 <= 65535
            fact r12 + r8 <= r13
            fact r8 == spec.der_hdr_len(buf, r12, r13)
            fact r9 == spec.der_val_len(buf, r12, r13)
            fact spec.der_seq(buf, pos, end, 3) == spec.der_seq(buf, r12, r13, 3)
        }
    @have_len:
        lea r10, [r12 + r8]
        add r10, r9
        cmp r10, r13
        ja @bad
        lea r11, [rdi + r12]
        movzx eax, byte ptr [r11 + 0]
        lea rdx, [r12 + r8]
        mov r12, r10
        cmp rax, 48
        je @nested
        mov rcx, r9
        mov r8, rax
        call der_prim_ok_fn
        cmp rax, 0
        je @bad
        jmp @loop
    @nested:
        mov rcx, r10
        call der_seq2
        cmp rax, 0
        je @bad
        jmp @loop
    @ok:
        mov rax, 1
        pop r13
        pop r12
        ret
    @bad:
        xor eax, eax
        pop r13
        pop r12
        ret
    }
    for arm64 calling {
        in buf = x4, n = x1, pos = x2, end = x3
        out = x0
        preserves x4, x1, x19, x20, x21, x22, x23, x24, x25, x26, x27, x28, x29
    } {
        sub sp, sp, 32
        str x30, [sp, 0]
        str x19, [sp, 8]
        str x20, [sp, 16]
        mov x19, x2
        mov x20, x3
        place {
            fact pos <= x19
            fact x19 <= x20
            fact x20 == end
            fact spec.der_seq(buf, pos, end, 3) == spec.der_seq(buf, x19, x20, 3)
            decreases x20 - x19
        }
    @loop:
        cmp x19, x20
        b.hs @ok
        add x7, x19, 2
        cmp x7, x20
        b.hi @bad
        add x9, x4, x19
        ldrb w6, [x9, 1]
        cmp x6, 128
        b.lo @len_short
        cmp x6, 129
        b.eq @len81
        cmp x6, 130
        b.eq @len82
        b @bad
    @len_short:
        mov x5, 2
        b @have_len
    @len81:
        add x7, x19, 3
        cmp x7, x20
        b.hi @bad
        ldrb w6, [x9, 2]
        cmp x6, 128
        b.lo @bad
        mov x5, 3
        b @have_len
    @len82:
        add x7, x19, 4
        cmp x7, x20
        b.hi @bad
        ldrb w6, [x9, 2]
        cmp x6, 1
        b.lo @bad
        lsl x6, x6, 8
        ldrb w8, [x9, 3]
        add x6, x6, x8
        mov x5, 4
        place {
            fact pos <= x19
            fact x19 < x20
            fact x20 == end
            fact 2 <= x5
            fact x5 <= 4
            fact 0 <= x6
            fact x6 <= 65535
            fact x19 + x5 <= x20
            fact x5 == spec.der_hdr_len(buf, x19, x20)
            fact x6 == spec.der_val_len(buf, x19, x20)
            fact spec.der_seq(buf, pos, end, 3) == spec.der_seq(buf, x19, x20, 3)
        }
    @have_len:
        add x7, x19, x5
        add x8, x7, x6
        cmp x8, x20
        b.hi @bad
        add x9, x4, x19
        ldrb w5, [x9, 0]
        mov x2, x7
        mov x19, x8
        cmp x5, 48
        b.eq @nested
        mov x3, x6
        bl der_prim_ok_fn
        cmp x0, 0
        b.eq @bad
        b @loop
    @nested:
        mov x3, x8
        bl der_seq2
        cmp x0, 0
        b.eq @bad
        b @loop
    @ok:
        mov x0, 1
        ldr x20, [sp, 16]
        ldr x19, [sp, 8]
        ldr x30, [sp, 0]
        add sp, sp, 32
        ret
    @bad:
        mov x0, 0
        ldr x20, [sp, 16]
        ldr x19, [sp, 8]
        ldr x30, [sp, 0]
        add sp, sp, 32
        ret
    }
}

fn der_valid(buf: n bytes, n: number)
    requires n <= 65536
    returns spec.der_valid(buf)
    trace depends on buf, n
    stack 512
{
    for x86_64 {
        cmp rsi, 0
        je @empty
        xor edx, edx
        mov rcx, rsi
        jmp der_seq3
    @empty:
        xor eax, eax
        ret
    }
    for arm64 {
        cmp x1, 0
        b.eq @empty
        mov x4, x0
        mov x2, 0
        mov x3, x1
        b der_seq3
    @empty:
        mov x0, 0
        ret
    }
}
