use spec = "tnysjfpacbfkbh2oms4mepxfyntpuun4ln4udnlu4wv4aavsbtuq"  // der_valid_spec.ode

fn check_oid(buf: n bytes, n: number, vpos: u64, end: u64) -> u64
    requires vpos <= end, end <= n, n <= 65536
    returns spec.oid_ok(buf, vpos, end, 1)
    trace depends on buf, n, vpos, end
{
    var at_start: u64 := 1
    for i in vpos..end
        maintains 0 <= at_start, at_start <= 1
        maintains spec.oid_ok(buf, vpos, end, 1) == spec.oid_ok(buf, i, end, at_start)
    {
        let b: u64 := buf[i]
        if at_start == 1 && b == 128 { return 0 }
        if b >= 128 {
            at_start := 0
        } else {
            at_start := 1
        }
    }
    return at_start
}

fn check_prim(buf: n bytes, n: number, tag: u64, vpos: u64, vlen: u64) -> u64
    requires vpos + vlen <= n, n <= 65536
    returns spec.der_prim_ok(buf, tag, vpos, vlen)
    trace depends on buf, n, tag, vpos, vlen
{
    if tag == 1 {
        if vlen != 1 { return 0 }
        let b: u64 := buf[vpos]
        if b == 0 || b == 255 { return 1 }
        return 0
    }
    if tag == 2 {
        if vlen == 0 { return 0 }
        if vlen == 1 { return 1 }
        let b0: u64 := buf[vpos]
        let b1: u64 := buf[vpos + 1]
        if b0 == 0 && b1 < 128 { return 0 }
        if b0 == 255 && b1 >= 128 { return 0 }
        return 1
    }
    if tag == 3 {
        if vlen == 0 { return 0 }
        let u: u64 := buf[vpos]
        if u > 7 { return 0 }
        if vlen == 1 {
            if u == 0 { return 1 }
            return 0
        }
        let last: u64 := buf[vpos + vlen - 1]
        if u == 0 { return 1 }
        if u == 1 { if (last & 1) == 0 { return 1 } else { return 0 } }
        if u == 2 { if (last & 3) == 0 { return 1 } else { return 0 } }
        if u == 3 { if (last & 7) == 0 { return 1 } else { return 0 } }
        if u == 4 { if (last & 15) == 0 { return 1 } else { return 0 } }
        if u == 5 { if (last & 31) == 0 { return 1 } else { return 0 } }
        if u == 6 { if (last & 63) == 0 { return 1 } else { return 0 } }
        if (last & 127) == 0 { return 1 }
        return 0
    }
    if tag == 4 { return 1 }
    if tag == 5 {
        if vlen == 0 { return 1 }
        return 0
    }
    if tag == 6 {
        if vlen == 0 { return 0 }
        return check_oid(buf, n, vpos, vpos + vlen)
    }
    return 0
}

fn der_seq(buf: n bytes, n: number, pos: u64, end: u64, depth: u64) -> u64
    requires pos <= end, end <= n, n <= 65536, depth <= 3
    returns spec.der_seq(buf, pos, end, depth)
    decreases depth
    trace depends on buf, n, pos, end, depth
    stack 96 + 96 * depth
{
    var p: u64 := pos
    while p < end
        maintains pos <= p, p <= end
        maintains spec.der_seq(buf, pos, end, depth) == spec.der_seq(buf, p, end, depth)
        decreases end - p
    {
        if p + 2 > end { return 0 }
        let lb: u64 := buf[p + 1]
        var hlen: u64 := 0
        var vlen: u64 := 0
        if lb < 128 {
            hlen := 2
            vlen := lb
        } else if lb == 129 {
            if p + 3 > end { return 0 }
            let l1: u64 := buf[p + 2]
            if l1 < 128 { return 0 }
            hlen := 3
            vlen := l1
        } else if lb == 130 {
            if p + 4 > end { return 0 }
            let l1: u64 := buf[p + 2]
            if l1 < 1 { return 0 }
            hlen := 4
            vlen := (l1 << 8) + buf[p + 3]
        } else {
            return 0
        }
        join maintains spec.der_seq(buf, pos, end, depth) == spec.der_step(buf, p, end, depth, hlen, vlen),
                       2 <= hlen, hlen <= 4, vlen <= 65535
        stack(x86_64) let vpos: u64 := p + hlen
        stack(x86_64) let next_p: u64 := vpos + vlen
        if next_p > end { return 0 }
        let tag: u64 := buf[p]
        if tag == 48 {
            if depth == 0 { return 0 }
            if der_seq(buf, n, vpos, next_p, depth - 1) == 0 { return 0 }
        } else {
            if check_prim(buf, n, tag, vpos, vlen) == 0 { return 0 }
        }
        p := next_p
    }
    return 1
}

fn der_valid(buf: n bytes, n: number)
    requires n <= 65536
    returns spec.der_valid(buf)
    trace depends on buf, n
    stack 512
{
    if n == 0 { return 0 }
    return der_seq(buf, n, 0, n, 3)
}
