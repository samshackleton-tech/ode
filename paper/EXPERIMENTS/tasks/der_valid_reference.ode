fn bitstr_low_zero_fn(b: number, u: number)
    requires b <= 255
    requires u <= 7
    returns spec.bitstr_low_zero(b, u)
    trace depends on b, u
    stack 0
{
    for x86_64 calling {
        in b = r10, u = r11
        out = rax
        preserves rdi, rsi, rdx, rcx, r8, r9, rbx, rbp, r12, r13, r14, r15
    } {
        cmp r11, 0
        je @ok
        cmp r11, 1
        je @u1
        cmp r11, 2
        je @u2
        cmp r11, 3
        je @u3
        cmp r11, 4
        je @u4
        cmp r11, 5
        je @u5
        cmp r11, 6
        je @u6
        and r10, 127
        cmp r10, 0
        je @ok
        xor eax, eax
        ret
    @u1:
        and r10, 1
        cmp r10, 0
        je @ok
        xor eax, eax
        ret
    @u2:
        and r10, 3
        cmp r10, 0
        je @ok
        xor eax, eax
        ret
    @u3:
        and r10, 7
        cmp r10, 0
        je @ok
        xor eax, eax
        ret
    @u4:
        and r10, 15
        cmp r10, 0
        je @ok
        xor eax, eax
        ret
    @u5:
        and r10, 31
        cmp r10, 0
        je @ok
        xor eax, eax
        ret
    @u6:
        and r10, 63
        cmp r10, 0
        je @ok
        xor eax, eax
        ret
    @ok:
        mov rax, 1
        ret
    }
    for arm64 calling {
        in b = x6, u = x7
        out = x0
        preserves x4, x1, x2, x3, x5, x19, x20, x21, x22, x23, x24, x25, x26, x27, x28, x29
    } {
        cmp x7, 0
        b.eq @ok
        cmp x7, 1
        b.eq @u1
        cmp x7, 2
        b.eq @u2
        cmp x7, 3
        b.eq @u3
        cmp x7, 4
        b.eq @u4
        cmp x7, 5
        b.eq @u5
        cmp x7, 6
        b.eq @u6
        mov x8, 127
        and x6, x6, x8
        cmp x6, 0
        b.eq @ok
        mov x0, 0
        ret
    @u1:
        mov x8, 1
        and x6, x6, x8
        cmp x6, 0
        b.eq @ok
        mov x0, 0
        ret
    @u2:
        mov x8, 3
        and x6, x6, x8
        cmp x6, 0
        b.eq @ok
        mov x0, 0
        ret
    @u3:
        mov x8, 7
        and x6, x6, x8
        cmp x6, 0
        b.eq @ok
        mov x0, 0
        ret
    @u4:
        mov x8, 15
        and x6, x6, x8
        cmp x6, 0
        b.eq @ok
        mov x0, 0
        ret
    @u5:
        mov x8, 31
        and x6, x6, x8
        cmp x6, 0
        b.eq @ok
        mov x0, 0
        ret
    @u6:
        mov x8, 63
        and x6, x6, x8
        cmp x6, 0
        b.eq @ok
        mov x0, 0
        ret
    @ok:
        mov x0, 1
        ret
    }
}

fn oid_ok_fn(buf: n bytes, n: number, start: number, end: number)
    requires start <= end
    requires end <= n
    requires n <= 65536
    returns spec.oid_ok(buf, start, end, 1)
