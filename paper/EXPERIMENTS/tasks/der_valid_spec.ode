// Canonical ASN.1 / X.690 DER TLV validator (nesting depth <= 3).
//
// Supported tags:
//   0x01 BOOLEAN           (length 1; value 0x00 or 0xFF)
//   0x02 INTEGER           (length >= 1; minimal two's-complement prefix)
//   0x03 BIT STRING        (length >= 1; unused bits 0..7, 0 if empty, trailing bits zero)
//   0x04 OCTET STRING      (any length)
//   0x05 NULL              (length 0)
//   0x06 OBJECT IDENTIFIER (length >= 1; canonical base-128 subidentifiers)
//   0x30 SEQUENCE          (constructed; inner elements valid at depth - 1)
//
// Canonical lengths:
//   0x00..0x7F             short form (2-byte header)
//   0x81 L                 1-byte long form, requires L >= 128 (3-byte header)
//   0x82 L1 L2             2-byte long form, requires L1 >= 1 (4-byte header)

def der_hdr_len(buf, pos, end) {
    if pos + 2 > end then 0
    else if buf[pos + 1] < 128 then 2
    else if buf[pos + 1] == 129 then (
        if pos + 3 <= end && buf[pos + 2] >= 128 then 3 else 0
    )
    else if buf[pos + 1] == 130 then (
        if pos + 4 <= end && buf[pos + 2] >= 1 then 4 else 0
    )
    else 0
}

def der_val_len(buf, pos, end) {
    if pos + 2 > end then 0
    else if buf[pos + 1] < 128 then buf[pos + 1]
    else if buf[pos + 1] == 129 then (
        if pos + 3 <= end && buf[pos + 2] >= 128 then buf[pos + 2] else 0
    )
    else if buf[pos + 1] == 130 then (
        if pos + 4 <= end && buf[pos + 2] >= 1 then 256 * buf[pos + 2] + buf[pos + 3] else 0
    )
    else 0
}

def bitstr_low_zero(b, u) {
    if u == 0 then 1
    else if u == 1 then (if b % 2 == 0 then 1 else 0)
    else if u == 2 then (if b % 4 == 0 then 1 else 0)
    else if u == 3 then (if b % 8 == 0 then 1 else 0)
    else if u == 4 then (if b % 16 == 0 then 1 else 0)
    else if u == 5 then (if b % 32 == 0 then 1 else 0)
    else if u == 6 then (if b % 64 == 0 then 1 else 0)
    else if u == 7 then (if b % 128 == 0 then 1 else 0)
    else 0
}

def oid_ok(buf, i, end, at_start) {
    if i >= end then at_start
    else if at_start == 1 && buf[i] == 128 then 0
    else if buf[i] >= 128 then oid_ok(buf, i + 1, end, 0)
    else oid_ok(buf, i + 1, end, 1)
}

def der_prim_ok(buf, tag, vpos, vlen) {
    if tag == 1 then (
        if vlen == 1 && (buf[vpos] == 0 || buf[vpos] == 255) then 1 else 0
    )
    else if tag == 2 then (
        if vlen == 0 then 0
        else if vlen == 1 then 1
        else if buf[vpos] == 0 && buf[vpos + 1] < 128 then 0
        else if buf[vpos] == 255 && buf[vpos + 1] >= 128 then 0
        else 1
    )
    else if tag == 3 then (
        if vlen == 0 then 0
        else if buf[vpos] > 7 then 0
        else if vlen == 1 then (if buf[vpos] == 0 then 1 else 0)
        else bitstr_low_zero(buf[vpos + vlen - 1], buf[vpos])
    )
    else if tag == 4 then 1
    else if tag == 5 then (if vlen == 0 then 1 else 0)
    else if tag == 6 then (
        if vlen == 0 then 0 else oid_ok(buf, vpos, vpos + vlen, 1)
    )
    else 0
}

def der_step(buf, pos, end, depth, hlen, vlen) {
    if hlen == 0 then 0
    else if pos + hlen + vlen > end then 0
    else if buf[pos] == 48 then (
        if depth == 0 then 0
        else if der_seq(buf, pos + hlen, pos + hlen + vlen, depth - 1) == 0 then 0
        else der_seq(buf, pos + hlen + vlen, end, depth)
    )
    else if der_prim_ok(buf, buf[pos], pos + hlen, vlen) == 0 then 0
    else der_seq(buf, pos + hlen + vlen, end, depth)
}

def der_seq(buf, pos, end, depth) {
    if pos >= end then (if pos == end then 1 else 0)
    else der_step(buf, pos, end, depth, der_hdr_len(buf, pos, end), der_val_len(buf, pos, end))
}

def der_valid(buf) {
    if len(buf) == 0 then 0 else der_seq(buf, 0, len(buf), 3)
}
