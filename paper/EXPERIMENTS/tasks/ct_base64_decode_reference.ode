use spec = "rvp5rdmmqprcrnoonholzl5ui74mpffwfy7mhsnrplhuo46dgnkq"  // ct_base64_decode_spec.ode

fn b64_dec(c: u8) -> u64
    returns spec.b64_dec(c)
    trace depends on nothing
{
    var r: u64 := 0
    r := select(c == 47, 127, r)
    r := select(c == 43, 126, r)
    r := select(48 <= c && c <= 57, c + 68, r)
    r := select(97 <= c && c <= 122, c -% 7, r)
    r := select(65 <= c && c <= 90, c -% 1, r)
    return r
}

fn ct_base64_decode(out: 192 bytes, src: n bytes, n: number)
    requires disjoint(out, src, 1)
    requires n >= 256
    requires n <= 256
    ensures out = spec.b64_decode(src)
    returns spec.b64_valid(src)
    trace depends on n
    stack 64
{
    var ok: u64 := 1
    for g in 0..64
        maintains 0 <= ok, ok <= 1
        maintains spec.b64_valid(src) == spec.b64_valid_from(src, 4 * g, ok)
        writes out[.. 3 * g] = spec.b64_decode(src)
    {
        let si: u64 := g << 2
        let di: u64 := (g << 1) + g
        let d0: u64 := b64_dec(src[si])
        let d1: u64 := b64_dec(src[si + 1])
        let d2: u64 := b64_dec(src[si + 2])
        let d3: u64 := b64_dec(src[si + 3])
        ok := select(d0 < 64, 0, ok)
        ok := select(d1 < 64, 0, ok)
        ok := select(d2 < 64, 0, ok)
        ok := select(d3 < 64, 0, ok)
        let v0: u64 := d0 & 63
        let v1: u64 := d1 & 63
        let v2: u64 := d2 & 63
        let v3: u64 := d3 & 63
        out[di] := (v0 << 2) + (v1 >> 4)
        out[di + 1] := ((v1 & 15) << 4) + (v2 >> 2)
        out[di + 2] := ((v2 & 3) << 6) + v3
    }
    return ok
}
