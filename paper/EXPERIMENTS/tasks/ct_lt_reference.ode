use spec = "dgq3l4gvriw55as3gylubcaxotdgyg2wfanwfra72ri3doo5ayva"  // ct_lt_spec.ode

fn ct_bytes_lt(a: n bytes, b: n bytes, n: number)
    requires n < 1000000000
    returns spec.bytes_lt(a, b)
    trace depends on n
    stack 0
{
    var i: u64 := n
    var lt: u64 := 0
    while i > 0
        maintains i <= n, lt <= 1
        maintains spec.bytes_lt(a, b) == spec.lt_from(a, b, i, lt)
        decreases i
    {
        i -= 1
        let ai: u64 := a[i]
        let bi: u64 := b[i]
        lt := ((bi << 1) + lt + 511 - (ai << 1)) >> 9
    }
    return lt
}
