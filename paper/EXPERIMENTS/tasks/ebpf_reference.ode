use bpf = "ebpf_spec.ode"

fn ebpf_alu_fn(op: u64, lhs: u64, rhs: u64)
    requires op <= 255
    requires lhs < 4294967296
    requires rhs < 4294967296
    returns bpf.ebpf_alu(op, lhs, rhs)
    trace depends on op, lhs, rhs
{
    if op == 183 { return rhs }
    if op == 191 { return rhs }
    if op == 7 {
        let s: u64 := lhs + rhs
        if s >= 4294967296 { return s - 4294967296 }
        return s
    }
    if op == 15 {
        let s: u64 := lhs + rhs
        if s >= 4294967296 { return s - 4294967296 }
        return s
    }
    if op == 23 {
        if lhs >= rhs { return lhs - rhs }
        return lhs + 4294967296 - rhs
    }
    if op == 31 {
        if lhs >= rhs { return lhs - rhs }
        return lhs + 4294967296 - rhs
    }
    return 4294967296
}

fn ebpf_cond_fn(op: u64, lhs: u64, imm: u64)
    requires op <= 255
    requires lhs < 4294967296
    requires imm < 4294967296
    returns bpf.ebpf_cond(op, lhs, imm)
    trace depends on op, lhs, imm
{
    if op == 21 {
        if lhs == imm { return 1 }
        return 0
    }
    if op == 85 {
        if lhs != imm { return 1 }
        return 0
    }
    if op == 37 {
        if lhs > imm { return 1 }
        return 0
    }
    return 2
}

fn ebpf_jump_pc_fn(pc: u64, u16: u64)
    requires pc < 2305843009213693951
    requires u16 < 65536
    returns bpf.ebpf_jump_pc(pc, u16)
    trace depends on pc, u16
{
    let t: u64 := pc + 1 + u16
    if u16 >= 32768 {
        if t < 65536 { return 4294967296 }
        return t - 65536
    }
    return t
}

fn ebpf_run(prog: n bytes, n: number, fuel: number, arg1: number)
    requires n < 18446744073709551615
    requires arg1 < 4294967296
    returns bpf.ebpf_run(prog, fuel, arg1)
    trace depends on prog, n, fuel, arg1
    stack 128
{
    var pc: u64 := 0
    var rem: u64 := fuel
    var r0: u64 := 0
    var r1: u64 := arg1
    var r2: u64 := 0
    var r3: u64 := 0
    while rem > 0
        maintains bpf.ebpf_run(prog, fuel, arg1) == bpf.ebpf_step(prog, pc, rem, r0, r1, r2, r3)
        maintains r0 < 4294967296, r1 < 4294967296, r2 < 4294967296, r3 < 4294967296
        decreases rem
    {
        if pc >= 2305843009213693951 { return 4294967296 }
        stack let off: u64 := pc << 3
        if off + 8 > n { return 4294967296 }
        stack let op: u64 := prog[off]
        if op == 149 { return r0 }
        if op == 5 {
            let j16: u64 := prog.u16(off + 2)
            let npc: u64 := ebpf_jump_pc_fn(pc, j16)
            if npc >= 4294967296 { return 4294967296 }
            pc := npc
            rem -= 1
            continue
        }
        stack let regs: u64 := prog[off + 1]
        stack let dst: u64 := regs & 15
        if dst >= 4 { return 4294967296 }
        stack let lhs: u64 := select(dst == 0, r0, select(dst == 1, r1, select(dst == 2, r2, r3)))
        let imm: u64 := prog.u32(off + 4)
        let cond: u64 := ebpf_cond_fn(op, lhs, imm)
        if cond < 2 {
            if cond == 1 {
                let j16: u64 := prog.u16(off + 2)
                let npc: u64 := ebpf_jump_pc_fn(pc, j16)
                if npc >= 4294967296 { return 4294967296 }
                pc := npc
                rem -= 1
                continue
            }
            pc += 1
            rem -= 1
            continue
        }
        if op == 7 || op == 23 || op == 183 {
            let imm2: u64 := prog.u32(off + 4)
            let res: u64 := ebpf_alu_fn(op, lhs, imm2)
            if res >= 4294967296 { return 4294967296 }
            if dst == 0 { r0 := res }
            else if dst == 1 { r1 := res }
            else if dst == 2 { r2 := res }
            else { r3 := res }
            pc += 1
            rem -= 1
            continue
        }
        let src: u64 := regs >> 4
        if src >= 4 { return 4294967296 }
        let rhs: u64 := select(src == 0, r0, select(src == 1, r1, select(src == 2, r2, r3)))
        let res2: u64 := ebpf_alu_fn(op, lhs, rhs)
        if res2 >= 4294967296 { return 4294967296 }
        if dst == 0 { r0 := res2 }
        else if dst == 1 { r1 := res2 }
        else if dst == 2 { r2 := res2 }
        else { r3 := res2 }
        pc += 1
        rem -= 1
    }
    return 4294967296
}
