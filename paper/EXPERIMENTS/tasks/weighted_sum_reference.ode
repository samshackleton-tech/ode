use spec = "untujqjtr7sld2gngyxc2qulhulrfh35zxed7odf3zwkami5wuea"  // weighted_sum_spec.ode

fn weighted_sum(a: n bytes, n: number)
    requires n <= 4096
    returns spec.weighted_sum(a)
    trace depends on n
    stack 0
{
    var i: u64 := 0
    var s1: u64 := 0
    var s2: u64 := 0
    while i + 4 <= n
        maintains i <= n, s1 <= i * 255, s2 <= i * 1044480
        maintains spec.weighted_sum(a) == spec.wsum_from(a, i, s1, s2)
        decreases n - i
    {
        s1 += a[i]
        s2 += s1
        s1 += a[i + 1]
        s2 += s1
        s1 += a[i + 2]
        s2 += s1
        s1 += a[i + 3]
        s2 += s1
        i += 4
    }
    while i < n
        maintains i <= n, s1 <= i * 255, s2 <= i * 1044480
        maintains spec.weighted_sum(a) == spec.wsum_from(a, i, s1, s2)
        decreases n - i
    {
        s1 += a[i]
        s2 += s1
        i += 1
    }
    return s2
}
