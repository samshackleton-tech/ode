use spec = "r6y26tckd64yc2ryvfe6ekd6tcepzrjmksdufiqqx6xmqvoix2ta"  // chacha20_4way_spec.ode
use vec = "7zpczpzr6tshzr6ew4fnhluakp3vs4q3xu4pndhflmztv6rdpqra"  // std/vec.ode

inline fn qr16(var a: u32x16, var b: u32x16, var c: u32x16, var d: u32x16) {
    a +%= b
    d := vec.rotl32_x16(d ^ a, 16)
    c +%= d
    b := vec.rotl32_x16(b ^ c, 12)
    a +%= b
    d := vec.rotl32_x16(d ^ a, 8)
    c +%= d
    b := vec.rotl32_x16(b ^ c, 7)
}

// Self-inverse 4x4 word transpose within each 128-bit quarter of 4 x u32x16.
inline fn transpose_in_q(var x0: u32x16, var x1: u32x16, var x2: u32x16, var x3: u32x16) {
    let u0: u32x16 := unpacklo32(x0, x1)
    let u1: u32x16 := unpackhi32(x0, x1)
    let u2: u32x16 := unpacklo32(x2, x3)
    let u3: u32x16 := unpackhi32(x2, x3)
    x0 := unpacklo64(u0, u2)
    x1 := unpackhi64(u0, u2)
    x2 := unpacklo64(u1, u3)
    x3 := unpackhi64(u1, u3)
}

// Self-inverse 4x4 128-bit quarter transpose across 4 x u32x16.
inline fn transpose_q(var c0: u32x16, var c1: u32x16, var c2: u32x16, var c3: u32x16) {
    let q0: u32x16 := shufi32x4(c0, c1, 0x44)
    let q1: u32x16 := shufi32x4(c0, c1, 0xEE)
    let q2: u32x16 := shufi32x4(c2, c3, 0x44)
    let q3: u32x16 := shufi32x4(c2, c3, 0xEE)
    c0 := shufi32x4(q0, q2, 0x88)
    c1 := shufi32x4(q0, q2, 0xDD)
    c2 := shufi32x4(q1, q3, 0x88)
    c3 := shufi32x4(q1, q3, 0xDD)
}

// 4-way interleaved 128-bit ChaCha20 quarter-round (fills all 4 NEON pipes, zero spills).
inline fn qr4_quad(
    var a0: u32x4, var b0: u32x4, var c0: u32x4, var d0: u32x4,
    var a1: u32x4, var b1: u32x4, var c1: u32x4, var d1: u32x4,
    var a2: u32x4, var b2: u32x4, var c2: u32x4, var d2: u32x4,
    var a3: u32x4, var b3: u32x4, var c3: u32x4, var d3: u32x4
) {
    a0 +%= b0
    a1 +%= b1
    a2 +%= b2
    a3 +%= b3
    d0 := vec.rotl32(d0 ^ a0, 16)
    d1 := vec.rotl32(d1 ^ a1, 16)
    d2 := vec.rotl32(d2 ^ a2, 16)
    d3 := vec.rotl32(d3 ^ a3, 16)
    c0 +%= d0
    c1 +%= d1
    c2 +%= d2
    c3 +%= d3
    b0 := vec.rotl32(b0 ^ c0, 12)
    b1 := vec.rotl32(b1 ^ c1, 12)
    b2 := vec.rotl32(b2 ^ c2, 12)
    b3 := vec.rotl32(b3 ^ c3, 12)
    a0 +%= b0
    a1 +%= b1
    a2 +%= b2
    a3 +%= b3
    d0 := vec.rotl32(d0 ^ a0, 8)
    d1 := vec.rotl32(d1 ^ a1, 8)
    d2 := vec.rotl32(d2 ^ a2, 8)
    d3 := vec.rotl32(d3 ^ a3, 8)
    c0 +%= d0
    c1 +%= d1
    c2 +%= d2
    c3 +%= d3
    b0 := vec.rotl32(b0 ^ c0, 7)
    b1 := vec.rotl32(b1 ^ c1, 7)
    b2 := vec.rotl32(b2 ^ c2, 7)
    b3 := vec.rotl32(b3 ^ c3, 7)
}

fn chacha20_4way(out: 256 bytes, st: 256 bytes)
    requires disjoint(out, st, 1)
    ensures out = bytes_of(spec.chacha20_4way(words(st)))
    stack 256
for x86_64 needs avx needs avx512 {
    var a: u32x16 := st.u32x16(0)
    var b: u32x16 := st.u32x16(64)
    var c: u32x16 := st.u32x16(128)
    var d: u32x16 := st.u32x16(192)
    transpose_in_q(a, b, c, d)
    transpose_q(a, b, c, d)
    let a0: u32x16 := a
    let b0: u32x16 := b
    let c0: u32x16 := c
    let d0: u32x16 := d
    for r in 0..10 unroll {
        qr16(a, b, c, d)
        b := shufi32x4(b, b, 0x39)
        c := shufi32x4(c, c, 0x4E)
        d := shufi32x4(d, d, 0x93)
        qr16(a, b, c, d)
        b := shufi32x4(b, b, 0x93)
        c := shufi32x4(c, c, 0x4E)
        d := shufi32x4(d, d, 0x39)
    }
    a +%= a0
    b +%= b0
    c +%= c0
    d +%= d0
    transpose_q(a, b, c, d)
    transpose_in_q(a, b, c, d)
    out.u32x16(0) := a
    out.u32x16(64) := b
    out.u32x16(128) := c
    out.u32x16(192) := d
}
for arm64 {
    var a0: u32x4 := st.u32x4(0)
    var b0: u32x4 := st.u32x4(16)
    var c0: u32x4 := st.u32x4(32)
    var d0: u32x4 := st.u32x4(48)
    var a1: u32x4 := st.u32x4(64)
    var b1: u32x4 := st.u32x4(80)
    var c1: u32x4 := st.u32x4(96)
    var d1: u32x4 := st.u32x4(112)
    var a2: u32x4 := st.u32x4(128)
    var b2: u32x4 := st.u32x4(144)
    var c2: u32x4 := st.u32x4(160)
    var d2: u32x4 := st.u32x4(176)
    var a3: u32x4 := st.u32x4(192)
    var b3: u32x4 := st.u32x4(208)
    var c3: u32x4 := st.u32x4(224)
    var d3: u32x4 := st.u32x4(240)
    for r in 0..10 unroll {
        qr4_quad(a0, b0, c0, d0, a1, b1, c1, d1, a2, b2, c2, d2, a3, b3, c3, d3)
        b0 := ext4(b0, b0)
        b1 := ext4(b1, b1)
        b2 := ext4(b2, b2)
        b3 := ext4(b3, b3)
        c0 := ext8(c0, c0)
        c1 := ext8(c1, c1)
        c2 := ext8(c2, c2)
        c3 := ext8(c3, c3)
        d0 := ext12(d0, d0)
        d1 := ext12(d1, d1)
        d2 := ext12(d2, d2)
        d3 := ext12(d3, d3)
        qr4_quad(a0, b0, c0, d0, a1, b1, c1, d1, a2, b2, c2, d2, a3, b3, c3, d3)
        b0 := ext12(b0, b0)
        b1 := ext12(b1, b1)
        b2 := ext12(b2, b2)
        b3 := ext12(b3, b3)
        c0 := ext8(c0, c0)
        c1 := ext8(c1, c1)
        c2 := ext8(c2, c2)
        c3 := ext8(c3, c3)
        d0 := ext4(d0, d0)
        d1 := ext4(d1, d1)
        d2 := ext4(d2, d2)
        d3 := ext4(d3, d3)
    }
    out.u32x4(0) := a0 +% st.u32x4(0)
    out.u32x4(16) := b0 +% st.u32x4(16)
    out.u32x4(32) := c0 +% st.u32x4(32)
    out.u32x4(48) := d0 +% st.u32x4(48)
    out.u32x4(64) := a1 +% st.u32x4(64)
    out.u32x4(80) := b1 +% st.u32x4(80)
    out.u32x4(96) := c1 +% st.u32x4(96)
    out.u32x4(112) := d1 +% st.u32x4(112)
    out.u32x4(128) := a2 +% st.u32x4(128)
    out.u32x4(144) := b2 +% st.u32x4(144)
    out.u32x4(160) := c2 +% st.u32x4(160)
    out.u32x4(176) := d2 +% st.u32x4(176)
    out.u32x4(192) := a3 +% st.u32x4(192)
    out.u32x4(208) := b3 +% st.u32x4(208)
    out.u32x4(224) := c3 +% st.u32x4(224)
    out.u32x4(240) := d3 +% st.u32x4(240)
}
