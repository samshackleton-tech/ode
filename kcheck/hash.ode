  lea rcx, [rsp + 0]
  mov rdx, qword ptr [rsp + 8456]
  shl rdx, 3
  add rcx, rdx
  mov qword ptr [rcx], rax
  jmp @l55
@l54:
  // else
  // u64[ptrs + (i << 3)] = c
  lea rax, [rsp + 7424]
  lea rcx, [rsp + 0]
  mov rdx, qword ptr [rsp + 8456]
  shl rdx, 3
  add rcx, rdx
  mov qword ptr [rcx], rax
@l55:
  // i = i + 1
  mov rax, qword ptr [rsp + 8456]
  add rax, 1
  mov qword ptr [rsp + 8456], rax
  jmp @l52
@l53:
  // blake3_servil_avx512_p16(ptrs, 1, kf, 0, pp, d)
  lea rdi, [rsp + 0]
  mov rsi, 1
  mov rdx, r12
  mov rcx, 0
  mov r8, qword ptr [rsp + 8448]
  lea r9, [rsp + 7936]
  call blake3_servil_avx512_p16
  // i = 0
  mov rax, 0
  mov qword ptr [rsp + 8456], rax
  // while i < 16
@l56:
  mov rax, qword ptr [rsp + 8456]
  mov rcx, 16
  cmp rax, rcx
  jae @l57
  // if i < 1
  mov rax, qword ptr [rsp + 8456]
  mov rcx, 1
  cmp rax, rcx
  jae @l58
  // u64[ptrs + (i << 3)] = d + (i << 6)
  lea rax, [rsp + 7936]
  mov rcx, qword ptr [rsp + 8456]
  shl rcx, 6
  add rax, rcx
  lea rcx, [rsp + 0]
  mov rdx, qword ptr [rsp + 8456]
  shl rdx, 3
  add rcx, rdx
  mov qword ptr [rcx], rax
  jmp @l59
@l58:
  // else
  // u64[ptrs + (i << 3)] = d
  lea rax, [rsp + 7936]
  lea rcx, [rsp + 0]
  mov rdx, qword ptr [rsp + 8456]
  shl rdx, 3
  add rcx, rdx
  mov qword ptr [rcx], rax
@l59:
  // i = i + 1
  mov rax, qword ptr [rsp + 8456]
  add rax, 1
  mov qword ptr [rsp + 8456], rax
  jmp @l56
@l57:
  // blake3_servil_avx512_p16(ptrs, 1, kf, 0, pp, c)
  lea rdi, [rsp + 0]
  mov rsi, 1
  mov rdx, r12
  mov rcx, 0
  mov r8, qword ptr [rsp + 8448]
  lea r9, [rsp + 7424]
  call blake3_servil_avx512_p16
  // copy 32 bytes: out <- c
  lea rax, [rsp + 7424]
  mov rcx, rbx
  movups xmm0, xmmword ptr [rax + 0]
  movups xmmword ptr [rcx + 0], xmm0
  movups xmm0, xmmword ptr [rax + 16]
  movups xmmword ptr [rcx + 16], xmm0
  add rsp, 8488
  pop r15
  pop r14
  pop r13
  pop r12
  pop rbp
  pop rbx
  ret
}

// The chaining value of the tree over the len bytes at input (1 or more; chunks numbered from t), where the
// values of its chunks of 1024 bytes are at cvs already, one after another (the contract says what each is).
// The specification's two parts again; a chunk of 1024 bytes is taken from cvs, a shorter last one is hashed.
// take(out, input, len, kf, t, cvs): arguments in rdi, rsi, rdx, rcx, r8, r9, as C passes them. Saved and
//   restored: rbx, rbp, r12, r13, r14, r15. Kept: out in rbx, input in rbp, len in r12, kf in r13, t in r14,
//   cvs in r15, flags at [rsp + 192], c at [rsp + 200], k at [rsp + 208], k2 at [rsp + 216], n at [rsp +
//   224], right at [rsp + 232], rest at [rsp + 240], restlen at [rsp + 248], rt at [rsp + 256], rcvs at [rsp
//   + 264], pf at [rsp + 272]. Buffers: nd at [rsp + 0], blk at [rsp + 128]. Frame: 280 bytes.
fn take as "b3l_take" {
  push rbx
  push rbp
  push r12
  push r13
  push r14
  push r15
  sub rsp, 280
  mov rbx, rdi
  mov rbp, rsi
  mov r12, rdx
  mov r13, rcx
  mov r14, r8
  mov r15, r9
  // flags = u64[kf + 32]
  mov rax, r13
  add rax, 32
  mov rax, qword ptr [rax]
  mov qword ptr [rsp + 192], rax
  // c = 0
  mov rax, 0
  mov qword ptr [rsp + 200], rax
  // k = 0
  mov rax, 0
  mov qword ptr [rsp + 208], rax
  // k2 = 0
  mov rax, 0
  mov qword ptr [rsp + 216], rax
  // if 1024 < len
  mov rax, 1024
  mov rcx, r12
  cmp rax, rcx
  jae @l0
  // c = ((len - 1) >> 10) + 1
  mov rax, r12
  sub rax, 1
  shr rax, 10
  add rax, 1
  mov qword ptr [rsp + 200], rax
  // k = 1
  mov rax, 1
  mov qword ptr [rsp + 208], rax
  // k2 = 2
  mov rax, 2
  mov qword ptr [rsp + 216], rax
  // while k2 < c
@l2:
  mov rax, qword ptr [rsp + 216]
  mov rcx, qword ptr [rsp + 200]
  cmp rax, rcx
  jae @l3
  // k = k2
  mov rax, qword ptr [rsp + 216]
  mov qword ptr [rsp + 208], rax
  // k2 = k2 << 1
  mov rax, qword ptr [rsp + 216]
  shl rax, 1
  mov qword ptr [rsp + 216], rax
  jmp @l2
@l3:
  // n = k << 10
  mov rax, qword ptr [rsp + 208]
  shl rax, 10
  mov qword ptr [rsp + 224], rax
  // right = blk + 32
  lea rax, [rsp + 128]
  add rax, 32
  mov qword ptr [rsp + 232], rax
  // rest = input + n
  mov rax, rbp
  add rax, qword ptr [rsp + 224]
  mov qword ptr [rsp + 240], rax
  // restlen = len - n
  mov rax, r12
  sub rax, qword ptr [rsp + 224]
  mov qword ptr [rsp + 248], rax
  // rt = t + k
  mov rax, r14
  add rax, qword ptr [rsp + 208]
  mov qword ptr [rsp + 256], rax
  // rcvs = cvs + (k << 5)
  mov rax, r15
  mov rcx, qword ptr [rsp + 208]
  shl rcx, 5
  add rax, rcx
  mov qword ptr [rsp + 264], rax
  // pf = flags | 4
  mov rax, qword ptr [rsp + 192]
  or rax, 4
  mov qword ptr [rsp + 272], rax
  // b3l_take(blk, input, n, kf, t, cvs)
  lea rdi, [rsp + 128]
  mov rsi, rbp
  mov rdx, qword ptr [rsp + 224]
  mov rcx, r13
  mov r8, r14
  mov r9, r15
  call b3l_take
  // b3l_take(right, rest, restlen, kf, rt, rcvs)
  mov rdi, qword ptr [rsp + 232]
  mov rsi, qword ptr [rsp + 240]
  mov rdx, qword ptr [rsp + 248]
  mov rcx, r13
  mov r8, qword ptr [rsp + 256]
  mov r9, qword ptr [rsp + 264]
  call b3l_take
  // copy 32 bytes: out <- kf
  mov rax, r13
  mov rcx, rbx
  movups xmm0, xmmword ptr [rax + 0]
  movups xmmword ptr [rcx + 0], xmm0
  movups xmm0, xmmword ptr [rax + 16]
  movups xmmword ptr [rcx + 16], xmm0
  // blake3_servil_compress_in_place_avx512(out, blk, 64, 0, pf)
  mov rdi, rbx
  lea rsi, [rsp + 128]
  mov rdx, 64
  mov rcx, 0
  mov r8, qword ptr [rsp + 272]
  call blake3_servil_compress_in_place_avx512
  jmp @l1
@l0:
  // else
  // if len == 1024
  mov rax, r12
  mov rcx, 1024
  cmp rax, rcx
  jne @l4
  // copy 32 bytes: out <- cvs
  mov rax, r15
  mov rcx, rbx
  movups xmm0, xmmword ptr [rax + 0]
  movups xmmword ptr [rcx + 0], xmm0
  movups xmm0, xmmword ptr [rax + 16]
  movups xmmword ptr [rcx + 16], xmm0
  jmp @l5
@l4:
  // else
  // copy 32 bytes: nd <- kf
  mov rax, r13
  lea rcx, [rsp + 0]
  movups xmm0, xmmword ptr [rax + 0]
  movups xmmword ptr [rcx + 0], xmm0
  movups xmm0, xmmword ptr [rax + 16]
  movups xmmword ptr [rcx + 16], xmm0
  // b3l_chunk_node(nd, input, len, t, flags, 5)
  lea rdi, [rsp + 0]
  mov rsi, rbp
  mov rdx, r12
  mov rcx, r14
  mov r8, qword ptr [rsp + 192]
  mov r9, 5
  call b3l_chunk_node
  // b3l_node_out(out, nd, 0, 5)
  mov rdi, rbx
  lea rsi, [rsp + 0]
  mov rdx, 0
  mov rcx, 5
  call b3l_node_out
@l5:
@l1:
  add rsp, 280
  pop r15
  pop r14
  pop r13
  pop r12
  pop rbp
  pop rbx
  ret
}

// The chaining value of the tree over 2 to 32 chunks (more than 1024 bytes, at most 32768), on a machine with
// AVX-512: the values of the chunks of 1024 bytes by one call of the 32-lane chunk kernel (the lanes past
// them hash the first chunk again, unused), then the tree by `take`.
// part32(out, input, len, kf, t): arguments in rdi, rsi, rdx, rcx, r8, as C passes them. Saved and restored:
//   rbx, rbp, r12, r13, r14, r15. Kept: out in rbx, input in rbp, len in r12, kf in r13, t in r14, flags in
//   r15, kp at [rsp + 1280], whole at [rsp + 1288], i at [rsp + 1296]. Buffers: ptrs at [rsp + 0], cvs at
//   [rsp + 256]. Frame: 1304 bytes.
fn part32 as "b3l_part32" {
  push rbx
  push rbp
  push r12
  push r13
  push r14
  push r15
  sub rsp, 1304
  mov rbx, rdi
  mov rbp, rsi
  mov r12, rdx
  mov r13, rcx
  mov r14, r8
  // flags = u64[kf + 32]
  mov rax, r13
  add rax, 32
  mov rax, qword ptr [rax]
  mov r15, rax
  // kp = flags | 0x40020100
  mov rax, r15
  or rax, 1073873152
  mov qword ptr [rsp + 1280], rax
  // whole = len >> 10
  mov rax, r12
  shr rax, 10
  mov qword ptr [rsp + 1288], rax
  // i = 0
  mov rax, 0
  mov qword ptr [rsp + 1296], rax
  // i = 0
  mov rax, 0
  mov qword ptr [rsp + 1296], rax
  // while i < 32
@l0:
  mov rax, qword ptr [rsp + 1296]
  mov rcx, 32
  cmp rax, rcx
  jae @l1
  // if i < whole
  mov rax, qword ptr [rsp + 1296]
  mov rcx, qword ptr [rsp + 1288]
  cmp rax, rcx
  jae @l2
  // u64[ptrs + (i << 3)] = input + (i << 10)
  mov rax, rbp
  mov rcx, qword ptr [rsp + 1296]
  shl rcx, 10
  add rax, rcx
  lea rcx, [rsp + 0]
  mov rdx, qword ptr [rsp + 1296]
  shl rdx, 3
  add rcx, rdx
  mov qword ptr [rcx], rax
  jmp @l3
@l2:
  // else
  // u64[ptrs + (i << 3)] = input
  mov rax, rbp
  lea rcx, [rsp + 0]
  mov rdx, qword ptr [rsp + 1296]
  shl rdx, 3
  add rcx, rdx
  mov qword ptr [rcx], rax
@l3:
  // i = i + 1
  mov rax, qword ptr [rsp + 1296]
  add rax, 1
  mov qword ptr [rsp + 1296], rax
  jmp @l0
@l1:
  // blake3_servil_avx512_k32(ptrs, 16, kf, t, kp, cvs)
  lea rdi, [rsp + 0]
  mov rsi, 16
  mov rdx, r13
  mov rcx, r14
  mov r8, qword ptr [rsp + 1280]
  lea r9, [rsp + 256]
  call blake3_servil_avx512_k32
  // b3l_take(out, input, len, kf, t, cvs)
  mov rdi, rbx
  mov rsi, rbp
  mov rdx, r12
  mov rcx, r13
  mov r8, r14
  lea r9, [rsp + 256]
  call b3l_take
  add rsp, 1304
  pop r15
  pop r14
  pop r13
  pop r12
  pop rbp
  pop rbx
  ret
}

// The chaining value of the tree over the len bytes at input (1 or more), whose chunks are numbered from t.
// kf: the key (32 bytes) and the flags (8 bytes). Where the machine has AVX-512, a whole tree of 32 chunks
// or of 128 goes to the wide kernels, and a smaller one of more than one chunk to the chunk kernel.
// subtree(out, input, len, kf, t, plat): arguments in rdi, rsi, rdx, rcx, r8, r9, as C passes them. Saved and
//   restored: rbx, rbp, r12, r13, r14, r15. Kept: out in rbx, input in rbp, len in r12, kf in r13, t in r14,
//   plat in r15, flags at [rsp + 192], c at [rsp + 200], k at [rsp + 208], k2 at [rsp + 216], wide at [rsp +
//   224], n at [rsp + 232], right at [rsp + 240], rest at [rsp + 248], restlen at [rsp + 256], rt at [rsp +
//   264], pf at [rsp + 272]. Buffers: nd at [rsp + 0], blk at [rsp + 128]. Frame: 280 bytes.
fn subtree as "b3l_subtree" {
  push rbx
  push rbp
  push r12
  push r13
  push r14
  push r15
  sub rsp, 280
  mov rbx, rdi
  mov rbp, rsi
  mov r12, rdx
  mov r13, rcx
  mov r14, r8
  mov r15, r9
  // flags = u64[kf + 32]
  mov rax, r13
  add rax, 32
  mov rax, qword ptr [rax]
  mov qword ptr [rsp + 192], rax
  // c = 0
  mov rax, 0
  mov qword ptr [rsp + 200], rax
  // k = 0
  mov rax, 0
  mov qword ptr [rsp + 208], rax
  // k2 = 0
  mov rax, 0
  mov qword ptr [rsp + 216], rax
  // wide = 0
  mov rax, 0
  mov qword ptr [rsp + 224], rax
  // if plat == 5
  mov rax, r15
  mov rcx, 5
  cmp rax, rcx
  jne @l0
  // if len == 0x20000
  mov rax, r12
  mov rcx, 131072
  cmp rax, rcx
  jne @l2
  // wide = 3
  mov rax, 3
  mov qword ptr [rsp + 224], rax
  jmp @l3
@l2:
  // else
  // if len == 32768
  mov rax, r12
  mov rcx, 32768
  cmp rax, rcx
  jne @l4
  // wide = 1
  mov rax, 1
  mov qword ptr [rsp + 224], rax
  jmp @l5
@l4:
  // else
  // if 1024 < len
  mov rax, 1024
  mov rcx, r12
  cmp rax, rcx
  jae @l6
  // if len < 32768
  mov rax, r12
  mov rcx, 32768
  cmp rax, rcx
  jae @l8
  // wide = 2
  mov rax, 2
  mov qword ptr [rsp + 224], rax
@l8:
@l6:
@l5:
@l3:
@l0:
  // if wide == 3
  mov rax, qword ptr [rsp + 224]
  mov rcx, 3
  cmp rax, rcx
  jne @l10
  // b3l_wide128(out, input, kf, t)
  mov rdi, rbx
  mov rsi, rbp
  mov rdx, r13
  mov rcx, r14
  call b3l_wide128
  jmp @l11
@l10:
  // else
  // if wide == 1
  mov rax, qword ptr [rsp + 224]
  mov rcx, 1
  cmp rax, rcx
  jne @l12
  // b3l_wide32(out, input, kf, t)
  mov rdi, rbx
  mov rsi, rbp
  mov rdx, r13
  mov rcx, r14
  call b3l_wide32
  jmp @l13
@l12:
  // else
  // if wide == 2
  mov rax, qword ptr [rsp + 224]
  mov rcx, 2
  cmp rax, rcx
  jne @l14
  // b3l_part32(out, input, len, kf, t)
  mov rdi, rbx
  mov rsi, rbp
  mov rdx, r12
  mov rcx, r13
  mov r8, r14
  call b3l_part32
  jmp @l15
@l14:
  // else
  // if 1024 < len
  mov rax, 1024
  mov rcx, r12
  cmp rax, rcx
  jae @l16
  // c = ((len - 1) >> 10) + 1
  mov rax, r12
  sub rax, 1
  shr rax, 10
  add rax, 1
  mov qword ptr [rsp + 200], rax
  // k = 1
  mov rax, 1
  mov qword ptr [rsp + 208], rax
  // k2 = 2
  mov rax, 2
  mov qword ptr [rsp + 216], rax
  // while k2 < c
@l18:
  mov rax, qword ptr [rsp + 216]
  mov rcx, qword ptr [rsp + 200]
  cmp rax, rcx
  jae @l19
  // k = k2
  mov rax, qword ptr [rsp + 216]
  mov qword ptr [rsp + 208], rax
  // k2 = k2 << 1
  mov rax, qword ptr [rsp + 216]
  shl rax, 1
  mov qword ptr [rsp + 216], rax
  jmp @l18
@l19:
  // n = k << 10
  mov rax, qword ptr [rsp + 208]
  shl rax, 10
  mov qword ptr [rsp + 232], rax
  // right = blk + 32
  lea rax, [rsp + 128]
  add rax, 32
  mov qword ptr [rsp + 240], rax
  // rest = input + n
  mov rax, rbp
  add rax, qword ptr [rsp + 232]
  mov qword ptr [rsp + 248], rax
  // restlen = len - n
  mov rax, r12
  sub rax, qword ptr [rsp + 232]
  mov qword ptr [rsp + 256], rax
  // rt = t + k
  mov rax, r14
  add rax, qword ptr [rsp + 208]
  mov qword ptr [rsp + 264], rax
  // pf = flags | 4
  mov rax, qword ptr [rsp + 192]
  or rax, 4
  mov qword ptr [rsp + 272], rax
  // b3l_subtree(blk, input, n, kf, t, plat)
  lea rdi, [rsp + 128]
  mov rsi, rbp
  mov rdx, qword ptr [rsp + 232]
  mov rcx, r13
  mov r8, r14
  mov r9, r15
  call b3l_subtree
  // b3l_subtree(right, rest, restlen, kf, rt, plat)
  mov rdi, qword ptr [rsp + 240]
  mov rsi, qword ptr [rsp + 248]
  mov rdx, qword ptr [rsp + 256]
  mov rcx, r13
  mov r8, qword ptr [rsp + 264]
  mov r9, r15
  call b3l_subtree
  // copy 32 bytes: out <- kf
  mov rax, r13
  mov rcx, rbx
  movups xmm0, xmmword ptr [rax + 0]
  movups xmmword ptr [rcx + 0], xmm0
  movups xmm0, xmmword ptr [rax + 16]
  movups xmmword ptr [rcx + 16], xmm0
  // if plat == 5
  mov rax, r15
  mov rcx, 5
  cmp rax, rcx
  jne @l20
  // blake3_servil_compress_in_place_avx512(out, blk, 64, 0, pf)
  mov rdi, rbx
  lea rsi, [rsp + 128]
  mov rdx, 64
  mov rcx, 0
  mov r8, qword ptr [rsp + 272]
  call blake3_servil_compress_in_place_avx512
  jmp @l21
@l20:
  // else
  // blake3_servil_compress_in_place_sse41(out, blk, 64, 0, pf)
  mov rdi, rbx
  lea rsi, [rsp + 128]
  mov rdx, 64
  mov rcx, 0
  mov r8, qword ptr [rsp + 272]
  call blake3_servil_compress_in_place_sse41
@l21:
  jmp @l17
@l16:
  // else
  // copy 32 bytes: nd <- kf
  mov rax, r13
  lea rcx, [rsp + 0]
  movups xmm0, xmmword ptr [rax + 0]
  movups xmmword ptr [rcx + 0], xmm0
  movups xmm0, xmmword ptr [rax + 16]
  movups xmmword ptr [rcx + 16], xmm0
  // b3l_chunk_node(nd, input, len, t, flags, plat)
  lea rdi, [rsp + 0]
  mov rsi, rbp
  mov rdx, r12
  mov rcx, r14
  mov r8, qword ptr [rsp + 192]
  mov r9, r15
  call b3l_chunk_node
  // b3l_node_out(out, nd, 0, plat)
  mov rdi, rbx
  lea rsi, [rsp + 0]
  mov rdx, 0
  mov rcx, r15
  call b3l_node_out
@l17:
@l15:
@l13:
@l11:
  add rsp, 280
  pop r15
  pop r14
  pop r13
  pop r12
  pop rbp
  pop rbx
  ret
}

// The hash: the tree over the whole message, its last compression with ROOT. Where the machine has AVX-512
// and the message is of 2 to 32 chunks, their values come from one call of the chunk kernel, as in part32.
// hashr(out, input, len, key, flags, plat): arguments in rdi, rsi, rdx, rcx, r8, r9, as C passes them. Saved
//   and restored: rbx, rbp, r12, r13, r14, r15. Kept: out in rbx, input in rbp, len in r12, key in r13, flags
//   in r14, plat in r15, c at [rsp + 1520], k at [rsp + 1528], k2 at [rsp + 1536], i at [rsp + 1544], wide at
//   [rsp + 1552], kp at [rsp + 1560], whole at [rsp + 1568], wn at [rsp + 1576], wright at [rsp + 1584],
//   wrest at [rsp + 1592], wrestlen at [rsp + 1600], wcvs at [rsp + 1608], wpf at [rsp + 1616], n at [rsp +
//   1624], right at [rsp + 1632], rest at [rsp + 1640], restlen at [rsp + 1648], pf at [rsp + 1656]. Buffers:
//   kf at [rsp + 0], nd at [rsp + 48], blk at [rsp + 176], ptrs at [rsp + 240], cvs at [rsp + 496]. Frame:
//   1672 bytes.
fn hashr as "b3l_hashr" {
  push rbx
  push rbp
  push r12
  push r13
  push r14
  push r15
  sub rsp, 1672
  mov rbx, rdi
  mov rbp, rsi
  mov r12, rdx
  mov r13, rcx
  mov r14, r8
  mov r15, r9
  // c = 0
  mov rax, 0
  mov qword ptr [rsp + 1520], rax
  // k = 0
  mov rax, 0
  mov qword ptr [rsp + 1528], rax
  // k2 = 0
  mov rax, 0
  mov qword ptr [rsp + 1536], rax
  // i = 0
  mov rax, 0
  mov qword ptr [rsp + 1544], rax
  // wide = 0
  mov rax, 0
  mov qword ptr [rsp + 1552], rax
  // copy 32 bytes: kf <- key
  mov rax, r13
  lea rcx, [rsp + 0]
  movups xmm0, xmmword ptr [rax + 0]
  movups xmmword ptr [rcx + 0], xmm0
  movups xmm0, xmmword ptr [rax + 16]
  movups xmmword ptr [rcx + 16], xmm0
  // u64[kf + 32] = flags
  mov rax, r14
  lea rcx, [rsp + 0]
  add rcx, 32
  mov qword ptr [rcx], rax
  // if plat == 5
  mov rax, r15
  mov rcx, 5
  cmp rax, rcx
  jne @l0
  // if 1024 < len
  mov rax, 1024
  mov rcx, r12
  cmp rax, rcx
  jae @l2
  // if 32768 < len
  mov rax, 32768
  mov rcx, r12
  cmp rax, rcx
  jae @l4
  jmp @l5
@l4:
  // else
  // wide = 1
  mov rax, 1
  mov qword ptr [rsp + 1552], rax
@l5:
@l2:
@l0:
  // if wide == 1
  mov rax, qword ptr [rsp + 1552]
  mov rcx, 1
  cmp rax, rcx
  jne @l6
  // kp = flags | 0x40020100
  mov rax, r14
  or rax, 1073873152
  mov qword ptr [rsp + 1560], rax
  // whole = len >> 10
  mov rax, r12
  shr rax, 10
  mov qword ptr [rsp + 1568], rax
  // i = 0
  mov rax, 0
  mov qword ptr [rsp + 1544], rax
  // while i < 32
@l8:
  mov rax, qword ptr [rsp + 1544]
  mov rcx, 32
  cmp rax, rcx
  jae @l9
  // if i < whole
  mov rax, qword ptr [rsp + 1544]
  mov rcx, qword ptr [rsp + 1568]
  cmp rax, rcx
  jae @l10
  // u64[ptrs + (i << 3)] = input + (i << 10)
  mov rax, rbp
  mov rcx, qword ptr [rsp + 1544]
  shl rcx, 10
  add rax, rcx
  lea rcx, [rsp + 240]
  mov rdx, qword ptr [rsp + 1544]
  shl rdx, 3
  add rcx, rdx
  mov qword ptr [rcx], rax
  jmp @l11
@l10:
  // else
  // u64[ptrs + (i << 3)] = input
  mov rax, rbp
  lea rcx, [rsp + 240]
  mov rdx, qword ptr [rsp + 1544]
  shl rdx, 3
  add rcx, rdx
  mov qword ptr [rcx], rax
@l11:
  // i = i + 1
  mov rax, qword ptr [rsp + 1544]
  add rax, 1
  mov qword ptr [rsp + 1544], rax
  jmp @l8
@l9:
  // blake3_servil_avx512_k32(ptrs, 16, kf, 0, kp, cvs)
  lea rdi, [rsp + 240]
  mov rsi, 16
  lea rdx, [rsp + 0]
  mov rcx, 0
  mov r8, qword ptr [rsp + 1560]
  lea r9, [rsp + 496]
  call blake3_servil_avx512_k32
  // c = ((len - 1) >> 10) + 1
  mov rax, r12
  sub rax, 1
  shr rax, 10
  add rax, 1
  mov qword ptr [rsp + 1520], rax
  // k = 1
  mov rax, 1
  mov qword ptr [rsp + 1528], rax
  // k2 = 2
  mov rax, 2
  mov qword ptr [rsp + 1536], rax
  // while k2 < c
@l12:
  mov rax, qword ptr [rsp + 1536]
  mov rcx, qword ptr [rsp + 1520]
  cmp rax, rcx
  jae @l13
  // k = k2
  mov rax, qword ptr [rsp + 1536]
  mov qword ptr [rsp + 1528], rax
  // k2 = k2 << 1
  mov rax, qword ptr [rsp + 1536]
  shl rax, 1
  mov qword ptr [rsp + 1536], rax
  jmp @l12
@l13:
  // wn = k << 10
  mov rax, qword ptr [rsp + 1528]
  shl rax, 10
  mov qword ptr [rsp + 1576], rax
  // wright = blk + 32
  lea rax, [rsp + 176]
  add rax, 32
  mov qword ptr [rsp + 1584], rax
  // wrest = input + wn
  mov rax, rbp
  add rax, qword ptr [rsp + 1576]
  mov qword ptr [rsp + 1592], rax
  // wrestlen = len - wn
  mov rax, r12
  sub rax, qword ptr [rsp + 1576]
  mov qword ptr [rsp + 1600], rax
  // wcvs = cvs + (k << 5)
  lea rax, [rsp + 496]
  mov rcx, qword ptr [rsp + 1528]
  shl rcx, 5
  add rax, rcx
  mov qword ptr [rsp + 1608], rax
  // wpf = (flags | 4) | 8
  mov rax, r14
  or rax, 4
  or rax, 8
  mov qword ptr [rsp + 1616], rax
  // b3l_take(blk, input, wn, kf, 0, cvs)
  lea rdi, [rsp + 176]
  mov rsi, rbp
  mov rdx, qword ptr [rsp + 1576]
  lea rcx, [rsp + 0]
  mov r8, 0
  lea r9, [rsp + 496]
  call b3l_take
  // b3l_take(wright, wrest, wrestlen, kf, k, wcvs)
  mov rdi, qword ptr [rsp + 1584]
  mov rsi, qword ptr [rsp + 1592]
  mov rdx, qword ptr [rsp + 1600]
  lea rcx, [rsp + 0]
  mov r8, qword ptr [rsp + 1528]
  mov r9, qword ptr [rsp + 1608]
  call b3l_take
  // copy 32 bytes: out <- key
  mov rax, r13
  mov rcx, rbx
  movups xmm0, xmmword ptr [rax + 0]
  movups xmmword ptr [rcx + 0], xmm0
  movups xmm0, xmmword ptr [rax + 16]
  movups xmmword ptr [rcx + 16], xmm0
  // blake3_servil_compress_in_place_avx512(out, blk, 64, 0, wpf)
  mov rdi, rbx
  lea rsi, [rsp + 176]
  mov rdx, 64
  mov rcx, 0
  mov r8, qword ptr [rsp + 1616]
  call blake3_servil_compress_in_place_avx512
  jmp @l7
@l6:
  // else
  // if 1024 < len
  mov rax, 1024
  mov rcx, r12
  cmp rax, rcx
  jae @l14
  // c = ((len - 1) >> 10) + 1
  mov rax, r12
  sub rax, 1
  shr rax, 10
  add rax, 1
  mov qword ptr [rsp + 1520], rax
  // k = 1
  mov rax, 1
  mov qword ptr [rsp + 1528], rax
  // k2 = 2
  mov rax, 2
  mov qword ptr [rsp + 1536], rax
  // while k2 < c
@l16:
  mov rax, qword ptr [rsp + 1536]
  mov rcx, qword ptr [rsp + 1520]
  cmp rax, rcx
  jae @l17
  // k = k2
  mov rax, qword ptr [rsp + 1536]
  mov qword ptr [rsp + 1528], rax
  // k2 = k2 << 1
  mov rax, qword ptr [rsp + 1536]
  shl rax, 1
  mov qword ptr [rsp + 1536], rax
  jmp @l16
@l17:
  // n = k << 10
  mov rax, qword ptr [rsp + 1528]
  shl rax, 10
  mov qword ptr [rsp + 1624], rax
  // right = blk + 32
  lea rax, [rsp + 176]
  add rax, 32
  mov qword ptr [rsp + 1632], rax
  // rest = input + n
  mov rax, rbp
  add rax, qword ptr [rsp + 1624]
  mov qword ptr [rsp + 1640], rax
  // restlen = len - n
  mov rax, r12
  sub rax, qword ptr [rsp + 1624]
  mov qword ptr [rsp + 1648], rax
  // pf = (flags | 4) | 8
  mov rax, r14
  or rax, 4
  or rax, 8
  mov qword ptr [rsp + 1656], rax
  // b3l_subtree(blk, input, n, kf, 0, plat)
  lea rdi, [rsp + 176]
  mov rsi, rbp
  mov rdx, qword ptr [rsp + 1624]
  lea rcx, [rsp + 0]
  mov r8, 0
  mov r9, r15
  call b3l_subtree
  // b3l_subtree(right, rest, restlen, kf, k, plat)
  mov rdi, qword ptr [rsp + 1632]
  mov rsi, qword ptr [rsp + 1640]
  mov rdx, qword ptr [rsp + 1648]
  lea rcx, [rsp + 0]
  mov r8, qword ptr [rsp + 1528]
  mov r9, r15
  call b3l_subtree
  // copy 32 bytes: out <- key
  mov rax, r13
  mov rcx, rbx
  movups xmm0, xmmword ptr [rax + 0]
  movups xmmword ptr [rcx + 0], xmm0
  movups xmm0, xmmword ptr [rax + 16]
  movups xmmword ptr [rcx + 16], xmm0
  // if plat == 5
  mov rax, r15
  mov rcx, 5
  cmp rax, rcx
  jne @l18
  // blake3_servil_compress_in_place_avx512(out, blk, 64, 0, pf)
  mov rdi, rbx
  lea rsi, [rsp + 176]
  mov rdx, 64
  mov rcx, 0
  mov r8, qword ptr [rsp + 1656]
  call blake3_servil_compress_in_place_avx512
  jmp @l19
@l18:
  // else
  // blake3_servil_compress_in_place_sse41(out, blk, 64, 0, pf)
  mov rdi, rbx
  lea rsi, [rsp + 176]
  mov rdx, 64
  mov rcx, 0
  mov r8, qword ptr [rsp + 1656]
  call blake3_servil_compress_in_place_sse41
@l19:
  jmp @l15
@l14:
  // else
  // copy 32 bytes: nd <- key
  mov rax, r13
  lea rcx, [rsp + 48]
  movups xmm0, xmmword ptr [rax + 0]
  movups xmmword ptr [rcx + 0], xmm0
  movups xmm0, xmmword ptr [rax + 16]
  movups xmmword ptr [rcx + 16], xmm0
