// BLAKE3's hash of a message, written to be proved.
//
// The code is in the shape of the specification (blake3.spec): `subtree` is the specification's `subtree`, in two
// parts by the same rule, each part by a call of itself; `chunk_node` and `node_out` are the specification's.
// So nothing has to be shown about a stack of subtrees or a counter of them: the verifier (kfn.py) follows each
// function once, takes a call by the callee's contract (a call of itself by its own), and compares what is
// left with the specification's definition unfolded once. No loop here needs a proof: each runs a number of
// times the paths fix (a chunk's 16 blocks, a block's 64 bytes, the 54 doublings of a count of chunks).
//
// Ode has one layer since November 18, 2026: a function is its instructions. These nine functions were first written in a
// word-level layer (variables, `if`, `while`), which a compiler turned into instructions. That layer and its
// compiler are gone. What stands here is what the compiler last printed, instruction for instruction, but
// where a function says it was written by hand (`node_out`, so far). The comment before a group of
// instructions says what the group does, in the old layer's words. The compiler's code is longer than it
// need be (every value goes through rax, and registers are saved for values that a scratch register would
// hold): it is to be written again by hand, function by function.

// A chunk's last block as a compression reads it: the n bytes at src (at most 64), then zeros to 64.
// pad(block, src, n): arguments in rdi, rsi, rdx, as C passes them. Saved and restored: rbx, rbp, r12, r13.
//   Kept: block in rbx, src in rbp, n in r12, i in r13. Frame: 8 bytes.
fn pad as "b3l_pad" {
  push rbx
  push rbp
  push r12
  push r13
  sub rsp, 8
  mov rbx, rdi
  mov rbp, rsi
  mov r12, rdx
  // i = 64
  mov rax, 64
  mov r13, rax
  // while 0 < i
@l0:
  mov rax, 0
  mov rcx, r13
  cmp rax, rcx
  jae @l1
  // i = i - 1
  mov rax, r13
  sub rax, 1
  mov r13, rax
  // if i < n
  mov rax, r13
  mov rcx, r12
  cmp rax, rcx
  jae @l2
  // u8[block + i] = u8[src + i]
  mov rax, rbp
  add rax, r13
  movzx eax, byte ptr [rax]
  mov rcx, rbx
  add rcx, r13
  mov byte ptr [rcx], al
  jmp @l3
@l2:
  // else
  // u8[block + i] = 0
  mov rax, 0
  mov rcx, rbx
  add rcx, r13
  mov byte ptr [rcx], al
@l3:
  jmp @l0
@l1:
  add rsp, 8
  pop r13
  pop r12
  pop rbp
  pop rbx
  ret
}

// A chunk's node: h, the chaining value after every block but the last (the key is in the node's h at the
// call); the last block, padded; the chunk's number; the last block's length; its flags. 120 bytes.
// chunk_node(nd, input, len, counter, flags, plat): arguments in rdi, rsi, rdx, rcx, r8, r9, as C passes
//   them. Saved and restored: rbx, rbp, r12, r13, r14, r15. Kept: nd in r13, counter in r14, plat in r15,
//   first in r12, p in rbx, rem in rbp, input at [rsp + 0], len at [rsp + 8], flags at [rsp + 16], f at [rsp
//   + 24], blk at [rsp + 32]. Frame: 40 bytes.
fn chunk_node as "b3l_chunk_node" {
  push rbx
  push rbp
  push r12
  push r13
  push r14
  push r15
  sub rsp, 40
  mov r13, rdi
  mov qword ptr [rsp + 0], rsi
  mov qword ptr [rsp + 8], rdx
  mov r14, rcx
  mov qword ptr [rsp + 16], r8
  mov r15, r9
  // first = 1
  mov rax, 1
  mov r12, rax
  // p = input
  mov rax, qword ptr [rsp + 0]
  mov rbx, rax
  // rem = len
  mov rax, qword ptr [rsp + 8]
  mov rbp, rax
  // while 64 < rem
@l0:
  mov rax, 64
  mov rcx, rbp
  cmp rax, rcx
  jae @l1
  // f = flags | first
  mov rax, qword ptr [rsp + 16]
  or rax, r12
  mov qword ptr [rsp + 24], rax
  // if plat == 5
  mov rax, r15
  mov rcx, 5
  cmp rax, rcx
  jne @l2
  // blake3_servil_compress_in_place_avx512(nd, p, 64, counter, f)
  mov rdi, r13
  mov rsi, rbx
  mov rdx, 64
  mov rcx, r14
  mov r8, qword ptr [rsp + 24]
  call blake3_servil_compress_in_place_avx512
  jmp @l3
@l2:
  // else
  // blake3_servil_compress_in_place_sse41(nd, p, 64, counter, f)
  mov rdi, r13
  mov rsi, rbx
  mov rdx, 64
  mov rcx, r14
  mov r8, qword ptr [rsp + 24]
  call blake3_servil_compress_in_place_sse41
@l3:
  // first = 0
  mov rax, 0
  mov r12, rax
  // p = p + 64
  mov rax, rbx
  add rax, 64
  mov rbx, rax
  // rem = rem - 64
  mov rax, rbp
  sub rax, 64
  mov rbp, rax
  jmp @l0
@l1:
  // blk = nd + 32
  mov rax, r13
  add rax, 32
  mov qword ptr [rsp + 32], rax
  // b3l_pad(blk, p, rem)
  mov rdi, qword ptr [rsp + 32]
  mov rsi, rbx
  mov rdx, rbp
  call b3l_pad
  // u64[nd + 96] = counter
  mov rax, r14
  mov rcx, r13
  add rcx, 96
  mov qword ptr [rcx], rax
  // u64[nd + 104] = rem
  mov rax, rbp
  mov rcx, r13
  add rcx, 104
  mov qword ptr [rcx], rax
  // u64[nd + 112] = (flags | first) | 2
  mov rax, qword ptr [rsp + 16]
  or rax, r12
  or rax, 2
  mov rcx, r13
  add rcx, 112
  mov qword ptr [rcx], rax
  add rsp, 40
  pop r15
  pop r14
  pop r13
  pop r12
  pop rbp
  pop rbx
  ret
}

// A node's compression: its chaining value, or with root = ROOT the hash.
// node_out(out, nd, root, plat): arguments in rdi, rsi, rdx, rcx, as C passes them.
//   Written by hand (November 18, 2026; the compiler's was 58 instructions). The kernels take (h, block,
//   length, counter, flags) in rdi, rsi, rdx, rcx, r8 and compress in place, so the node's chaining value
//   goes to out first and out is the kernel's h: rdi stays as it came. plat waits in rax. No register a
//   caller keeps is used, so none is saved. Frame: 8 bytes, there only to put the stack pointer on a
//   16-byte boundary for the call.
fn node_out as "b3l_node_out" {
  // out[0 .. 32] = the node's chaining value
  movups xmm0, xmmword ptr [rsi + 0]
  movups xmmword ptr [rdi + 0], xmm0
  movups xmm0, xmmword ptr [rsi + 16]
  movups xmmword ptr [rdi + 16], xmm0
  // flags = u64[nd + 112] | root; length = u64[nd + 104]; counter = u64[nd + 96]; block = nd + 32
  mov r8, qword ptr [rsi + 112]
  or r8, rdx
  mov rdx, qword ptr [rsi + 104]
  mov rax, rcx
  mov rcx, qword ptr [rsi + 96]
  add rsi, 32
  sub rsp, 8
  // if plat == 5
  cmp rax, 5
  jne @sse41
  call blake3_servil_compress_in_place_avx512
  jmp @done
@sse41:
  call blake3_servil_compress_in_place_sse41
@done:
  add rsp, 8
  ret
}

// The chaining value of the tree over 32 whole chunks (32768 bytes), numbered from t, on a machine with
// AVX-512: the 32 chunks' values by the 32-lane chunk kernel, then their parents, 16, 8, 4, 2 and 1 of them,
// by the 16-lane parent kernel.
// wide32(out, input, kf, t): arguments in rdi, rsi, rdx, rcx, as C passes them. Saved and restored: rbx, rbp,
//   r12, r13, r14, r15. Kept: out in rbx, input in rbp, kf in r12, t in r13, flags in r14, kp in r15, pp at
//   [rsp + 2304], i at [rsp + 2312]. Buffers: ptrs at [rsp + 0], cvs at [rsp + 256], a at [rsp + 1280], b at
//   [rsp + 1792]. Frame: 2328 bytes.
fn wide32 as "b3l_wide32" {
  push rbx
  push rbp
  push r12
  push r13
  push r14
  push r15
  sub rsp, 2328
  mov rbx, rdi
  mov rbp, rsi
  mov r12, rdx
  mov r13, rcx
  // flags = u64[kf + 32]
  mov rax, r12
  add rax, 32
  mov rax, qword ptr [rax]
  mov r14, rax
  // kp = flags | 0x40020100
  mov rax, r14
  or rax, 1073873152
  mov r15, rax
  // pp = flags | 0x40000004
  mov rax, r14
  or rax, 1073741828
  mov qword ptr [rsp + 2304], rax
  // i = 0
  mov rax, 0
  mov qword ptr [rsp + 2312], rax
  // i = 0
  mov rax, 0
  mov qword ptr [rsp + 2312], rax
  // while i < 32
@l0:
  mov rax, qword ptr [rsp + 2312]
  mov rcx, 32
  cmp rax, rcx
  jae @l1
  // if i < 32
  mov rax, qword ptr [rsp + 2312]
  mov rcx, 32
  cmp rax, rcx
  jae @l2
  // u64[ptrs + (i << 3)] = input + (i << 10)
  mov rax, rbp
  mov rcx, qword ptr [rsp + 2312]
  shl rcx, 10
  add rax, rcx
  lea rcx, [rsp + 0]
  mov rdx, qword ptr [rsp + 2312]
  shl rdx, 3
  add rcx, rdx
  mov qword ptr [rcx], rax
  jmp @l3
@l2:
  // else
  // u64[ptrs + (i << 3)] = input
  mov rax, rbp
  lea rcx, [rsp + 0]
  mov rdx, qword ptr [rsp + 2312]
  shl rdx, 3
  add rcx, rdx
  mov qword ptr [rcx], rax
@l3:
  // i = i + 1
  mov rax, qword ptr [rsp + 2312]
  add rax, 1
  mov qword ptr [rsp + 2312], rax
  jmp @l0
@l1:
  // blake3_servil_avx512_k32(ptrs, 16, kf, t, kp, cvs)
  lea rdi, [rsp + 0]
  mov rsi, 16
  mov rdx, r12
  mov rcx, r13
  mov r8, r15
  lea r9, [rsp + 256]
  call blake3_servil_avx512_k32
  // i = 0
  mov rax, 0
  mov qword ptr [rsp + 2312], rax
  // while i < 16
@l4:
  mov rax, qword ptr [rsp + 2312]
  mov rcx, 16
  cmp rax, rcx
  jae @l5
  // if i < 16
  mov rax, qword ptr [rsp + 2312]
  mov rcx, 16
  cmp rax, rcx
  jae @l6
  // u64[ptrs + (i << 3)] = cvs + (i << 6)
  lea rax, [rsp + 256]
  mov rcx, qword ptr [rsp + 2312]
  shl rcx, 6
  add rax, rcx
  lea rcx, [rsp + 0]
  mov rdx, qword ptr [rsp + 2312]
  shl rdx, 3
  add rcx, rdx
  mov qword ptr [rcx], rax
  jmp @l7
@l6:
  // else
  // u64[ptrs + (i << 3)] = cvs
  lea rax, [rsp + 256]
  lea rcx, [rsp + 0]
  mov rdx, qword ptr [rsp + 2312]
  shl rdx, 3
  add rcx, rdx
  mov qword ptr [rcx], rax
@l7:
  // i = i + 1
  mov rax, qword ptr [rsp + 2312]
  add rax, 1
  mov qword ptr [rsp + 2312], rax
  jmp @l4
@l5:
  // blake3_servil_avx512_p16(ptrs, 1, kf, 0, pp, a)
  lea rdi, [rsp + 0]
  mov rsi, 1
  mov rdx, r12
  mov rcx, 0
  mov r8, qword ptr [rsp + 2304]
  lea r9, [rsp + 1280]
  call blake3_servil_avx512_p16
  // i = 0
  mov rax, 0
  mov qword ptr [rsp + 2312], rax
  // while i < 16
@l8:
  mov rax, qword ptr [rsp + 2312]
  mov rcx, 16
  cmp rax, rcx
  jae @l9
  // if i < 8
  mov rax, qword ptr [rsp + 2312]
  mov rcx, 8
  cmp rax, rcx
  jae @l10
  // u64[ptrs + (i << 3)] = a + (i << 6)
  lea rax, [rsp + 1280]
  mov rcx, qword ptr [rsp + 2312]
  shl rcx, 6
  add rax, rcx
  lea rcx, [rsp + 0]
  mov rdx, qword ptr [rsp + 2312]
  shl rdx, 3
  add rcx, rdx
  mov qword ptr [rcx], rax
  jmp @l11
@l10:
  // else
  // u64[ptrs + (i << 3)] = a
  lea rax, [rsp + 1280]
  lea rcx, [rsp + 0]
  mov rdx, qword ptr [rsp + 2312]
  shl rdx, 3
  add rcx, rdx
  mov qword ptr [rcx], rax
@l11:
  // i = i + 1
  mov rax, qword ptr [rsp + 2312]
  add rax, 1
  mov qword ptr [rsp + 2312], rax
  jmp @l8
@l9:
  // blake3_servil_avx512_p16(ptrs, 1, kf, 0, pp, b)
  lea rdi, [rsp + 0]
  mov rsi, 1
  mov rdx, r12
  mov rcx, 0
  mov r8, qword ptr [rsp + 2304]
  lea r9, [rsp + 1792]
  call blake3_servil_avx512_p16
  // i = 0
  mov rax, 0
  mov qword ptr [rsp + 2312], rax
  // while i < 16
@l12:
  mov rax, qword ptr [rsp + 2312]
  mov rcx, 16
  cmp rax, rcx
  jae @l13
  // if i < 4
  mov rax, qword ptr [rsp + 2312]
  mov rcx, 4
  cmp rax, rcx
  jae @l14
  // u64[ptrs + (i << 3)] = b + (i << 6)
  lea rax, [rsp + 1792]
  mov rcx, qword ptr [rsp + 2312]
  shl rcx, 6
  add rax, rcx
  lea rcx, [rsp + 0]
  mov rdx, qword ptr [rsp + 2312]
  shl rdx, 3
  add rcx, rdx
  mov qword ptr [rcx], rax
  jmp @l15
@l14:
  // else
  // u64[ptrs + (i << 3)] = b
  lea rax, [rsp + 1792]
  lea rcx, [rsp + 0]
  mov rdx, qword ptr [rsp + 2312]
  shl rdx, 3
  add rcx, rdx
  mov qword ptr [rcx], rax
@l15:
  // i = i + 1
  mov rax, qword ptr [rsp + 2312]
  add rax, 1
  mov qword ptr [rsp + 2312], rax
  jmp @l12
@l13:
  // blake3_servil_avx512_p16(ptrs, 1, kf, 0, pp, a)
  lea rdi, [rsp + 0]
  mov rsi, 1
  mov rdx, r12
  mov rcx, 0
  mov r8, qword ptr [rsp + 2304]
  lea r9, [rsp + 1280]
  call blake3_servil_avx512_p16
  // i = 0
  mov rax, 0
  mov qword ptr [rsp + 2312], rax
  // while i < 16
@l16:
  mov rax, qword ptr [rsp + 2312]
  mov rcx, 16
  cmp rax, rcx
  jae @l17
  // if i < 2
  mov rax, qword ptr [rsp + 2312]
  mov rcx, 2
  cmp rax, rcx
  jae @l18
  // u64[ptrs + (i << 3)] = a + (i << 6)
  lea rax, [rsp + 1280]
  mov rcx, qword ptr [rsp + 2312]
  shl rcx, 6
  add rax, rcx
  lea rcx, [rsp + 0]
  mov rdx, qword ptr [rsp + 2312]
  shl rdx, 3
  add rcx, rdx
  mov qword ptr [rcx], rax
  jmp @l19
@l18:
  // else
  // u64[ptrs + (i << 3)] = a
  lea rax, [rsp + 1280]
  lea rcx, [rsp + 0]
  mov rdx, qword ptr [rsp + 2312]
  shl rdx, 3
  add rcx, rdx
  mov qword ptr [rcx], rax
@l19:
  // i = i + 1
  mov rax, qword ptr [rsp + 2312]
  add rax, 1
  mov qword ptr [rsp + 2312], rax
  jmp @l16
@l17:
  // blake3_servil_avx512_p16(ptrs, 1, kf, 0, pp, b)
  lea rdi, [rsp + 0]
  mov rsi, 1
  mov rdx, r12
  mov rcx, 0
  mov r8, qword ptr [rsp + 2304]
  lea r9, [rsp + 1792]
  call blake3_servil_avx512_p16
  // i = 0
  mov rax, 0
  mov qword ptr [rsp + 2312], rax
  // while i < 16
@l20:
  mov rax, qword ptr [rsp + 2312]
  mov rcx, 16
  cmp rax, rcx
  jae @l21
  // if i < 1
  mov rax, qword ptr [rsp + 2312]
  mov rcx, 1
  cmp rax, rcx
  jae @l22
  // u64[ptrs + (i << 3)] = b + (i << 6)
  lea rax, [rsp + 1792]
  mov rcx, qword ptr [rsp + 2312]
  shl rcx, 6
  add rax, rcx
  lea rcx, [rsp + 0]
  mov rdx, qword ptr [rsp + 2312]
  shl rdx, 3
  add rcx, rdx
  mov qword ptr [rcx], rax
  jmp @l23
@l22:
  // else
  // u64[ptrs + (i << 3)] = b
  lea rax, [rsp + 1792]
  lea rcx, [rsp + 0]
  mov rdx, qword ptr [rsp + 2312]
  shl rdx, 3
  add rcx, rdx
  mov qword ptr [rcx], rax
@l23:
  // i = i + 1
  mov rax, qword ptr [rsp + 2312]
  add rax, 1
  mov qword ptr [rsp + 2312], rax
  jmp @l20
@l21:
  // blake3_servil_avx512_p16(ptrs, 1, kf, 0, pp, a)
  lea rdi, [rsp + 0]
  mov rsi, 1
  mov rdx, r12
  mov rcx, 0
  mov r8, qword ptr [rsp + 2304]
  lea r9, [rsp + 1280]
  call blake3_servil_avx512_p16
  // copy 32 bytes: out <- a
  lea rax, [rsp + 1280]
  mov rcx, rbx
  movups xmm0, xmmword ptr [rax + 0]
  movups xmmword ptr [rcx + 0], xmm0
  movups xmm0, xmmword ptr [rax + 16]
  movups xmmword ptr [rcx + 16], xmm0
  add rsp, 2328
  pop r15
  pop r14
  pop r13
  pop r12
  pop rbp
  pop rbx
  ret
}

// The chaining value of the tree over 128 whole chunks (131072 bytes), numbered from t, on a machine with
// AVX-512: four calls of the chunk kernel, then the parents level by level, sixteen to a call of the parent
// kernel while a level has as many (64, 32 and 16 parents; then 8, 4, 2 and 1).
// wide128(out, input, kf, t): arguments in rdi, rsi, rdx, rcx, as C passes them. Saved and restored: rbx,
//   rbp, r12, r13, r14, r15. Kept: out in rbx, input in rbp, kf in r12, t in r13, flags in r14, kp in r15, pp
//   at [rsp + 8448], i at [rsp + 8456], p at [rsp + 8464], q at [rsp + 8472], tt at [rsp + 8480]. Buffers:
//   ptrs at [rsp + 0], cvs at [rsp + 256], a at [rsp + 4352], b at [rsp + 6400], c at [rsp + 7424], d at [rsp
//   + 7936]. Frame: 8488 bytes.
fn wide128 as "b3l_wide128" {
  push rbx
  push rbp
  push r12
  push r13
  push r14
  push r15
  sub rsp, 8488
  mov rbx, rdi
  mov rbp, rsi
  mov r12, rdx
  mov r13, rcx
  // flags = u64[kf + 32]
  mov rax, r12
  add rax, 32
  mov rax, qword ptr [rax]
  mov r14, rax
  // kp = flags | 0x40020100
  mov rax, r14
  or rax, 1073873152
  mov r15, rax
  // pp = flags | 0x40000004
  mov rax, r14
  or rax, 1073741828
  mov qword ptr [rsp + 8448], rax
  // i = 0
  mov rax, 0
  mov qword ptr [rsp + 8456], rax
  // p = 0
  mov rax, 0
  mov qword ptr [rsp + 8464], rax
  // q = 0
  mov rax, 0
  mov qword ptr [rsp + 8472], rax
  // tt = 0
  mov rax, 0
  mov qword ptr [rsp + 8480], rax
  // p = input + 0
  mov rax, rbp
  add rax, 0
  mov qword ptr [rsp + 8464], rax
  // q = cvs + 0
  lea rax, [rsp + 256]
  add rax, 0
  mov qword ptr [rsp + 8472], rax
  // tt = t + 0
  mov rax, r13
  add rax, 0
  mov qword ptr [rsp + 8480], rax
  // i = 0
  mov rax, 0
  mov qword ptr [rsp + 8456], rax
  // while i < 32
@l0:
  mov rax, qword ptr [rsp + 8456]
  mov rcx, 32
  cmp rax, rcx
  jae @l1
  // if i < 32
  mov rax, qword ptr [rsp + 8456]
  mov rcx, 32
  cmp rax, rcx
  jae @l2
  // u64[ptrs + (i << 3)] = p + (i << 10)
  mov rax, qword ptr [rsp + 8464]
  mov rcx, qword ptr [rsp + 8456]
  shl rcx, 10
  add rax, rcx
  lea rcx, [rsp + 0]
  mov rdx, qword ptr [rsp + 8456]
  shl rdx, 3
  add rcx, rdx
  mov qword ptr [rcx], rax
  jmp @l3
@l2:
  // else
  // u64[ptrs + (i << 3)] = p
  mov rax, qword ptr [rsp + 8464]
  lea rcx, [rsp + 0]
  mov rdx, qword ptr [rsp + 8456]
  shl rdx, 3
  add rcx, rdx
  mov qword ptr [rcx], rax
@l3:
  // i = i + 1
  mov rax, qword ptr [rsp + 8456]
  add rax, 1
  mov qword ptr [rsp + 8456], rax
  jmp @l0
@l1:
  // blake3_servil_avx512_k32(ptrs, 16, kf, tt, kp, q)
  lea rdi, [rsp + 0]
  mov rsi, 16
  mov rdx, r12
  mov rcx, qword ptr [rsp + 8480]
  mov r8, r15
  mov r9, qword ptr [rsp + 8472]
