  lea rdi, [rsp + 48]
  mov rsi, rbp
  mov rdx, r12
  mov rcx, 0
  mov r8, r14
  mov r9, r15
  call b3l_chunk_node
  // b3l_node_out(out, nd, 8, plat)
  mov rdi, rbx
  lea rsi, [rsp + 48]
  mov rdx, 8
  mov rcx, r15
  call b3l_node_out
@l15:
@l7:
  add rsp, 1672
  pop r15
  pop r14
  pop r13
  pop r12
  pop rbp
  pop rbx
  ret
