// Whether n bytes are well-formed UTF-8, and how many code points they hold: written to be proved against
// utf8.spec. It gives the count, or NO.
//
// It looks at a sequence in the specification's order: the first byte, and how many bytes it begins; then
// each byte after it (is it there? is it 0x80 to 0xBF?); and only then whether the number held is one the
// sequence's length is the fewest bytes for, is no surrogate, and is not above 0x10FFFF. Those three it tells from the first two
// bytes: 0xC0 and 0xC1 begin only numbers below 0x80; after 0xE0 a byte below 0xA0 gives a number below
// 0x800, after 0xED one from 0xA0 a surrogate; after 0xF0 a byte below 0x90 gives a number below 0x10000,
// after 0xF4 one from 0x90, and anything after 0xF5 to 0xF7, a number above 0x10FFFF.
//
// state: 0 going on, 1 the bytes are all looked at, 2 not well-formed.
//
// Ode has one layer since November 18, 2026: a function is its instructions. This function was first written in a
// word-level layer (variables, `if`, `while`), which a compiler turned into instructions. That layer and its
// compiler are gone. What stands here is what the compiler last printed, instruction for instruction: the
// bytes are the same. The comment before a group of instructions says what the group does, in the old
// layer's words. The code is longer than it need be (every value goes through rax, and registers are saved
// for values that a scratch register would hold): it is to be written again by hand, function by function.

// utf8(input, n): arguments in rdi, rsi, as C passes them. Saved and restored: rbx, rbp, r12, r13, r14, r15.
//   Kept: input in rbx, n in rbp, i in r12, count in r13, b in r14, c1 in r15, c at [rsp + 0], need at [rsp +
//   8], state at [rsp + 16], result at [rsp + 24]. Frame: 40 bytes.
fn utf8 as "ode_utf8" {
  push rbx
  push rbp
  push r12
  push r13
  push r14
  push r15
  sub rsp, 40
  mov rbx, rdi
  mov rbp, rsi
  // i = 0
  mov rax, 0
  mov r12, rax
  // count = 0
  mov rax, 0
  mov r13, rax
  // b = 0
  mov rax, 0
  mov r14, rax
  // c1 = 0
  mov rax, 0
  mov r15, rax
  // c = 0
  mov rax, 0
  mov qword ptr [rsp + 0], rax
  // need = 0
  mov rax, 0
  mov qword ptr [rsp + 8], rax
  // state = 0
  mov rax, 0
  mov qword ptr [rsp + 16], rax
  // while state == 0
@l0:
  mov rax, qword ptr [rsp + 16]
  mov rcx, 0
  cmp rax, rcx
  jne @l1
  // if i < n
  mov rax, r12
  mov rcx, rbp
  cmp rax, rcx
  jae @l2
  // b = u8[input + i]
  mov rax, rbx
  add rax, r12
  movzx eax, byte ptr [rax]
  mov r14, rax
  // if b < 128
  mov rax, r14
  mov rcx, 128
  cmp rax, rcx
  jae @l4
  // i = i + 1
  mov rax, r12
  add rax, 1
  mov r12, rax
  // count = count + 1
  mov rax, r13
  add rax, 1
  mov r13, rax
  jmp @l5
@l4:
  // else
  // if b < 192
  mov rax, r14
  mov rcx, 192
  cmp rax, rcx
  jae @l6
  // state = 2
  mov rax, 2
  mov qword ptr [rsp + 16], rax
  jmp @l7
@l6:
  // else
  // if b < 248
  mov rax, r14
  mov rcx, 248
  cmp rax, rcx
  jae @l8
  // need = 2
  mov rax, 2
  mov qword ptr [rsp + 8], rax
  // if b < 224
  mov rax, r14
  mov rcx, 224
  cmp rax, rcx
  jae @l10
  jmp @l11
@l10:
  // else
  // need = 3
  mov rax, 3
  mov qword ptr [rsp + 8], rax
@l11:
  // if b < 240
  mov rax, r14
  mov rcx, 240
  cmp rax, rcx
  jae @l12
  jmp @l13
@l12:
  // else
  // need = 4
  mov rax, 4
  mov qword ptr [rsp + 8], rax
@l13:
  // if i + 1 < n
  mov rax, r12
  add rax, 1
  mov rcx, rbp
  cmp rax, rcx
  jae @l14
  // c1 = u8[(input + i) + 1]
  mov rax, rbx
  add rax, r12
  add rax, 1
  movzx eax, byte ptr [rax]
  mov r15, rax
  // if c1 < 128
  mov rax, r15
  mov rcx, 128
  cmp rax, rcx
  jae @l16
  // state = 2
  mov rax, 2
  mov qword ptr [rsp + 16], rax
  jmp @l17
@l16:
  // else
  // if c1 < 192
  mov rax, r15
  mov rcx, 192
  cmp rax, rcx
  jae @l18
  jmp @l19
@l18:
  // else
  // state = 2
  mov rax, 2
  mov qword ptr [rsp + 16], rax
@l19:
@l17:
  jmp @l15
@l14:
  // else
  // state = 2
  mov rax, 2
  mov qword ptr [rsp + 16], rax
@l15:
  // if state == 0
  mov rax, qword ptr [rsp + 16]
  mov rcx, 0
  cmp rax, rcx
  jne @l20
  // if need < 3
  mov rax, qword ptr [rsp + 8]
  mov rcx, 3
  cmp rax, rcx
  jae @l22
  jmp @l23
@l22:
  // else
  // if i + 2 < n
  mov rax, r12
  add rax, 2
  mov rcx, rbp
  cmp rax, rcx
  jae @l24
  // c = u8[(input + i) + 2]
  mov rax, rbx
  add rax, r12
  add rax, 2
  movzx eax, byte ptr [rax]
  mov qword ptr [rsp + 0], rax
  // if c < 128
  mov rax, qword ptr [rsp + 0]
  mov rcx, 128
  cmp rax, rcx
  jae @l26
  // state = 2
  mov rax, 2
  mov qword ptr [rsp + 16], rax
  jmp @l27
@l26:
  // else
  // if c < 192
  mov rax, qword ptr [rsp + 0]
  mov rcx, 192
  cmp rax, rcx
  jae @l28
  jmp @l29
@l28:
  // else
  // state = 2
  mov rax, 2
  mov qword ptr [rsp + 16], rax
@l29:
@l27:
  jmp @l25
@l24:
  // else
  // state = 2
  mov rax, 2
  mov qword ptr [rsp + 16], rax
@l25:
@l23:
@l20:
  // if state == 0
  mov rax, qword ptr [rsp + 16]
  mov rcx, 0
  cmp rax, rcx
  jne @l30
  // if need < 4
  mov rax, qword ptr [rsp + 8]
  mov rcx, 4
  cmp rax, rcx
  jae @l32
  jmp @l33
@l32:
  // else
  // if i + 3 < n
  mov rax, r12
  add rax, 3
  mov rcx, rbp
  cmp rax, rcx
  jae @l34
  // c = u8[(input + i) + 3]
  mov rax, rbx
  add rax, r12
  add rax, 3
  movzx eax, byte ptr [rax]
  mov qword ptr [rsp + 0], rax
  // if c < 128
  mov rax, qword ptr [rsp + 0]
  mov rcx, 128
  cmp rax, rcx
  jae @l36
  // state = 2
  mov rax, 2
  mov qword ptr [rsp + 16], rax
  jmp @l37
@l36:
  // else
  // if c < 192
  mov rax, qword ptr [rsp + 0]
  mov rcx, 192
  cmp rax, rcx
  jae @l38
  jmp @l39
@l38:
  // else
  // state = 2
  mov rax, 2
  mov qword ptr [rsp + 16], rax
@l39:
@l37:
  jmp @l35
@l34:
  // else
  // state = 2
  mov rax, 2
  mov qword ptr [rsp + 16], rax
@l35:
@l33:
@l30:
  // if state == 0
  mov rax, qword ptr [rsp + 16]
  mov rcx, 0
  cmp rax, rcx
  jne @l40
  // if need < 3
  mov rax, qword ptr [rsp + 8]
  mov rcx, 3
  cmp rax, rcx
  jae @l42
  // if b < 194
  mov rax, r14
  mov rcx, 194
  cmp rax, rcx
  jae @l44
  // state = 2
  mov rax, 2
  mov qword ptr [rsp + 16], rax
  jmp @l45
@l44:
  // else
  // i = i + 2
  mov rax, r12
  add rax, 2
  mov r12, rax
  // count = count + 1
  mov rax, r13
  add rax, 1
  mov r13, rax
@l45:
  jmp @l43
@l42:
  // else
  // if need < 4
  mov rax, qword ptr [rsp + 8]
  mov rcx, 4
  cmp rax, rcx
  jae @l46
  // if b == 224
  mov rax, r14
  mov rcx, 224
  cmp rax, rcx
  jne @l48
  // if c1 < 160
  mov rax, r15
  mov rcx, 160
  cmp rax, rcx
  jae @l50
  // state = 2
  mov rax, 2
  mov qword ptr [rsp + 16], rax
@l50:
  jmp @l49
@l48:
  // else
  // if b < 237
  mov rax, r14
  mov rcx, 237
  cmp rax, rcx
  jae @l52
  jmp @l53
@l52:
  // else
  // if b < 238
  mov rax, r14
  mov rcx, 238
  cmp rax, rcx
  jae @l54
  // if c1 < 160
  mov rax, r15
  mov rcx, 160
  cmp rax, rcx
  jae @l56
  jmp @l57
@l56:
  // else
  // state = 2
  mov rax, 2
  mov qword ptr [rsp + 16], rax
@l57:
@l54:
@l53:
@l49:
  // if state == 0
  mov rax, qword ptr [rsp + 16]
  mov rcx, 0
  cmp rax, rcx
  jne @l58
  // i = i + 3
  mov rax, r12
  add rax, 3
  mov r12, rax
  // count = count + 1
  mov rax, r13
  add rax, 1
  mov r13, rax
@l58:
  jmp @l47
@l46:
  // else
  // if b == 240
  mov rax, r14
  mov rcx, 240
  cmp rax, rcx
  jne @l60
  // if c1 < 144
  mov rax, r15
  mov rcx, 144
  cmp rax, rcx
  jae @l62
  // state = 2
  mov rax, 2
  mov qword ptr [rsp + 16], rax
@l62:
  jmp @l61
@l60:
  // else
  // if b < 244
  mov rax, r14
  mov rcx, 244
  cmp rax, rcx
  jae @l64
  jmp @l65
@l64:
  // else
  // if b < 245
  mov rax, r14
  mov rcx, 245
  cmp rax, rcx
  jae @l66
  // if c1 < 144
  mov rax, r15
  mov rcx, 144
  cmp rax, rcx
  jae @l68
  jmp @l69
@l68:
  // else
  // state = 2
  mov rax, 2
  mov qword ptr [rsp + 16], rax
@l69:
  jmp @l67
@l66:
  // else
  // state = 2
  mov rax, 2
  mov qword ptr [rsp + 16], rax
@l67:
@l65:
@l61:
  // if state == 0
  mov rax, qword ptr [rsp + 16]
  mov rcx, 0
  cmp rax, rcx
  jne @l70
  // i = i + 4
  mov rax, r12
  add rax, 4
  mov r12, rax
  // count = count + 1
  mov rax, r13
  add rax, 1
  mov r13, rax
@l70:
@l47:
@l43:
@l40:
  jmp @l9
@l8:
  // else
  // state = 2
  mov rax, 2
  mov qword ptr [rsp + 16], rax
@l9:
@l7:
@l5:
  jmp @l3
@l2:
  // else
  // state = 1
  mov rax, 1
  mov qword ptr [rsp + 16], rax
@l3:
  jmp @l0
@l1:
  // result = 0xffffffffffffffff
  mov rax, 18446744073709551615
  mov qword ptr [rsp + 24], rax
  // if state == 1
  mov rax, qword ptr [rsp + 16]
  mov rcx, 1
  cmp rax, rcx
  jne @l72
  // result = count
  mov rax, r13
  mov qword ptr [rsp + 24], rax
@l72:
  mov rax, qword ptr [rsp + 24]
  add rsp, 40
  pop r15
  pop r14
  pop r13
  pop r12
  pop rbp
  pop rbx
  ret
}
