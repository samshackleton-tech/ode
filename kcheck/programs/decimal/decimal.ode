// A count read as a proof's header writes it, written to be proved against decimal.spec: one to nine
// decimal digits. It gives the count, or NO.
//
// state: 0 going on, 1 the bytes are all read, 2 not a count.
//
// Ode has one layer since November 18, 2026: a function is its instructions. This function was first written in a
// word-level layer (variables, `if`, `while`), which a compiler turned into instructions. That layer and its
// compiler are gone. What stands here is what the compiler last printed, instruction for instruction: the
// bytes are the same. The comment before a group of instructions says what the group does, in the old
// layer's words. The code is longer than it need be (every value goes through rax, and registers are saved
// for values that a scratch register would hold): it is to be written again by hand, function by function.

// decimal(input, n): arguments in rdi, rsi, as C passes them. Saved and restored: rbx, rbp, r12, r13, r14,
//   r15. Kept: input in rbx, n in rbp, i in r12, v in r13, b in r15, state in r14, r at [rsp + 0]. Frame: 8
//   bytes.
fn decimal as "ode_decimal" {
  push rbx
  push rbp
  push r12
  push r13
  push r14
  push r15
  sub rsp, 8
  mov rbx, rdi
  mov rbp, rsi
  // i = 0
  mov rax, 0
  mov r12, rax
  // v = 0
  mov rax, 0
  mov r13, rax
  // b = 0
  mov rax, 0
  mov r15, rax
  // state = 0
  mov rax, 0
  mov r14, rax
  // r = 0
  mov rax, 0
  mov qword ptr [rsp + 0], rax
  // if n == 0
  mov rax, rbp
  mov rcx, 0
  cmp rax, rcx
  jne @l0
  // state = 2
  mov rax, 2
  mov r14, rax
@l0:
  // if 9 < n
  mov rax, 9
  mov rcx, rbp
  cmp rax, rcx
  jae @l2
  // state = 2
  mov rax, 2
  mov r14, rax
@l2:
  // while state == 0
@l4:
  mov rax, r14
  mov rcx, 0
  cmp rax, rcx
  jne @l5
  // if i < n
  mov rax, r12
  mov rcx, rbp
  cmp rax, rcx
  jae @l6
  // b = u8[input + i]
  mov rax, rbx
  add rax, r12
  movzx eax, byte ptr [rax]
  mov r15, rax
  // if b < 48
  mov rax, r15
  mov rcx, 48
  cmp rax, rcx
  jae @l8
  // state = 2
  mov rax, 2
  mov r14, rax
  jmp @l9
@l8:
  // else
  // if 57 < b
  mov rax, 57
  mov rcx, r15
  cmp rax, rcx
  jae @l10
  // state = 2
  mov rax, 2
  mov r14, rax
  jmp @l11
@l10:
  // else
  // v = (((v << 3) + (v << 1)) + b) - 48
  mov rax, r13
  shl rax, 3
  mov rcx, r13
  shl rcx, 1
  add rax, rcx
  add rax, r15
  sub rax, 48
  mov r13, rax
  // i = i + 1
  mov rax, r12
  add rax, 1
  mov r12, rax
@l11:
@l9:
  jmp @l7
@l6:
  // else
  // state = 1
  mov rax, 1
  mov r14, rax
@l7:
  jmp @l4
@l5:
  // r = v
  mov rax, r13
  mov qword ptr [rsp + 0], rax
  // if state == 2
  mov rax, r14
  mov rcx, 2
  cmp rax, rcx
  jne @l12
  // r = 0xffffffffffffffff
  mov rax, 18446744073709551615
  mov qword ptr [rsp + 0], rax
@l12:
  mov rax, qword ptr [rsp + 0]
  add rsp, 8
  pop r15
  pop r14
  pop r13
  pop r12
  pop rbp
  pop rbx
  ret
}
