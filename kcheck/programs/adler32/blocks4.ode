// Ode has one layer since November 18, 2026: a function is its instructions. This function was first written in a
// word-level layer (variables, `if`, `while`), which a compiler turned into instructions. That layer and its
// compiler are gone. What stands here is what the compiler last printed, instruction for instruction: the
// bytes are the same. The comment before a group of instructions says what the group does, in the old
// layer's words. The code is longer than it need be (every value goes through rax, and registers are saved
// for values that a scratch register would hold): it is to be written again by hand, function by function.

// Adler-32 with the sums brought below 65521 once in 5552 bytes, four bytes a turn: blocks.ode with its
// inner loop written out four times, to see what the compiler's loop costs.
// adler32_blocks4(input, n): arguments in rdi, rsi, as C passes them. Saved and restored: rbx, rbp, r12, r13,
//   r14, r15. Kept: input in rbx, n in rbp, i in r12, a in r13, b in r14, end in r15. Frame: 8 bytes.
fn adler32_blocks4 as "ode_adler32_blocks4" {
  push rbx
  push rbp
  push r12
  push r13
  push r14
  push r15
  sub rsp, 8
  mov rbx, rdi
  mov rbp, rsi
  // i = 0
  mov rax, 0
  mov r12, rax
  // a = 1
  mov rax, 1
  mov r13, rax
  // b = 0
  mov rax, 0
  mov r14, rax
  // end = 0
  mov rax, 0
  mov r15, rax
  // while i < n
@l0:
  // The places of the three loops, for the prover of the verifier in Lean (proof-core).
  // As ode_adler32_blocks, with the bytes of a block taken four at a turn while four are
  // left, and then one at a turn: three places, the two inside a block saying the same.
  place {
    name i = r12
    name a = r13
    name b = r14
    fact i <= len
    fact a <= 65520
    fact b <= 65520
    fact a == s1(input)[i]
    fact b == s2(input)[i]
    decreases len - i
  }
  mov rax, r12
  mov rcx, rbp
  cmp rax, rcx
  jae @l1
  // end = n
  mov rax, rbp
  mov r15, rax
  // if 5552 < n - i
  mov rax, 5552
  mov rcx, rbp
  sub rcx, r12
  cmp rax, rcx
  jae @l2
  // end = i + 5552
  mov rax, r12
  add rax, 5552
  mov r15, rax
@l2:
  // while 3 < end - i
@l4:
  place {
    name i = r12
    name a = r13
    name b = r14
    name end = r15
    keep r15
    fact i <= end
    fact end <= len
    fact a + 255 * (end - i) <= 1481280
    fact b + 1481280 * (end - i) <= 8224132080
    fact a % 65521 == s1(input)[i]
    fact b % 65521 == s2(input)[i]
    decreases end - i
  }
  mov rax, 3
  mov rcx, r15
  sub rcx, r12
  cmp rax, rcx
  jae @l5
  // a = a + u8[input + i]
  mov rax, r13
  mov rcx, rbx
  add rcx, r12
  movzx ecx, byte ptr [rcx]
  add rax, rcx
  mov r13, rax
  // b = b + a
  mov rax, r14
  add rax, r13
  mov r14, rax
  // a = a + u8[(input + i) + 1]
  mov rax, r13
  mov rcx, rbx
  add rcx, r12
  add rcx, 1
  movzx ecx, byte ptr [rcx]
  add rax, rcx
  mov r13, rax
  // b = b + a
  mov rax, r14
  add rax, r13
  mov r14, rax
  // a = a + u8[(input + i) + 2]
  mov rax, r13
  mov rcx, rbx
  add rcx, r12
  add rcx, 2
  movzx ecx, byte ptr [rcx]
  add rax, rcx
  mov r13, rax
  // b = b + a
  mov rax, r14
  add rax, r13
  mov r14, rax
  // a = a + u8[(input + i) + 3]
  mov rax, r13
  mov rcx, rbx
  add rcx, r12
  add rcx, 3
  movzx ecx, byte ptr [rcx]
  add rax, rcx
  mov r13, rax
  // b = b + a
  mov rax, r14
  add rax, r13
  mov r14, rax
  // i = i + 4
  mov rax, r12
  add rax, 4
  mov r12, rax
  jmp @l4
@l5:
  // while i < end
@l6:
  place {
    name i = r12
    name a = r13
    name b = r14
    name end = r15
    keep r15
    fact i <= end
    fact end <= len
    fact a + 255 * (end - i) <= 1481280
    fact b + 1481280 * (end - i) <= 8224132080
    fact a % 65521 == s1(input)[i]
    fact b % 65521 == s2(input)[i]
    decreases end - i
  }
  mov rax, r12
  mov rcx, r15
  cmp rax, rcx
  jae @l7
  // a = a + u8[input + i]
  mov rax, r13
  mov rcx, rbx
  add rcx, r12
  movzx ecx, byte ptr [rcx]
  add rax, rcx
  mov r13, rax
  // b = b + a
  mov rax, r14
  add rax, r13
  mov r14, rax
  // i = i + 1
  mov rax, r12
  add rax, 1
  mov r12, rax
  jmp @l6
@l7:
  // a = ((a & 65535) + ((a >> 16) << 4)) - (a >> 16)
  mov rax, r13
  and rax, 65535
  mov rcx, r13
  shr rcx, 16
  shl rcx, 4
  add rax, rcx
  mov rcx, r13
  shr rcx, 16
  sub rax, rcx
  mov r13, rax
  // a = ((a & 65535) + ((a >> 16) << 4)) - (a >> 16)
  mov rax, r13
  and rax, 65535
  mov rcx, r13
  shr rcx, 16
  shl rcx, 4
  add rax, rcx
  mov rcx, r13
  shr rcx, 16
  sub rax, rcx
  mov r13, rax
  // if a < 65521
  mov rax, r13
  mov rcx, 65521
  cmp rax, rcx
  jae @l8
  jmp @l9
@l8:
  // else
  // a = a - 65521
  mov rax, r13
  sub rax, 65521
  mov r13, rax
@l9:
  // b = ((b & 65535) + ((b >> 16) << 4)) - (b >> 16)
  mov rax, r14
  and rax, 65535
  mov rcx, r14
  shr rcx, 16
  shl rcx, 4
  add rax, rcx
  mov rcx, r14
  shr rcx, 16
  sub rax, rcx
  mov r14, rax
  // b = ((b & 65535) + ((b >> 16) << 4)) - (b >> 16)
  mov rax, r14
  and rax, 65535
  mov rcx, r14
  shr rcx, 16
  shl rcx, 4
  add rax, rcx
  mov rcx, r14
  shr rcx, 16
  sub rax, rcx
  mov r14, rax
  // if b < 65521
  mov rax, r14
  mov rcx, 65521
  cmp rax, rcx
  jae @l10
  jmp @l11
@l10:
  // else
  // b = b - 65521
  mov rax, r14
  sub rax, 65521
  mov r14, rax
@l11:
  jmp @l0
@l1:
  mov rax, r14
  shl rax, 16
  add rax, r13
  add rsp, 8
  pop r15
  pop r14
  pop r13
  pop r12
  pop rbp
  pop rbx
  ret
}
