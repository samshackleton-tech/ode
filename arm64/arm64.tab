# A first table of AArch64 instruction forms, one row a form: a measurement, not yet a model anybody relies on.
#
#     NAME | ASM | ROW | EFFECT
#
# The columns are those of ../core/x86.tab, and the EFFECT is in the same language (../core/table.py), with
# the same meaning on numbers (../core/conc.py):
#
# ASM     how an assembler writes an instance. Random instances are assembled from it and run on a processor
#         (cross.py): everything the EFFECT assigns must be what the processor leaves, and everything else
#         must be as it was. `-`: not run on a processor.
# ROW     the decoded instruction, as the decoder writes it (word.py).
# EFFECT  what the instruction does: statements, left to right.
#
# Under a row, the ways its instances are written, one a line:
#
#         = BITS ; NOTES
#
# BITS    the instruction word's 32 bits, the highest first; blanks are for the eye. `0` and `1` are that
#         bit. A letter is a field: every place with that letter, which must lie together, holds one number.
# NOTES   `N=n*8`: the row's N is the field n times 8 (a displacement counted in units of its size).
#         `I=32-i`: the row's I is 32 less the field i. `call=I`: the field is where the function called is
#         (the file's relocations speak for it). `pc=I`: the field is a signed count of instruction words
#         from this instruction to the target byte offset I (`I = pc + sign_extend(i) * 4`).
#
# In ASM and ROW: D, S, P, B are general registers x0 to x30 (D64 its 64-bit name, D32 its 32-bit name; B is
# one that holds an address); X, Y, Z are vector registers v0 to v31; I is a number, N a displacement.
# A field of D, S, P or B that holds 31 is no instance of the row: there the processor means the register
# that reads as zero or the stack pointer, by the instruction, and this table has a row of its own wherever
# it has the instruction at all (`add sp, sp, I`; `ldr D64, [sp, N]`).
# In EFFECT: D, S, P, B are those registers' 64 bits; sp is the stack pointer; x30 is that register; X, Y, Z
# are a vector register's 128 bits as four 32-bit lanes; mem32/mem64/mem128(b, n) the bytes at b + n, the
# lowest first. on16(sp) is the stack pointer where it is a multiple of 16: where it is not, the processor
# faults at a load or store whose base is the stack pointer, and the row has no state after it.
# `call I link x30`: a call that puts the address to come back to in x30 (on x86-64 a call puts it below the
# stack pointer). `return x30`: the function returns to the address x30 holds.
# Flags: `zf` holds 1 when two compared values are equal (hardware PSTATE.Z). `cf` holds 1 when the first
# operand is unsigned-below the second (the inverse of AArch64's hardware borrow-free carry PSTATE.C, so
# `b.hs` jumps on `not cf` and `b.lo` jumps on `cf`). Rows that do not write `zf`/`cf` leave NZCV unchanged.
#
# An instance is written in ONE way by each line, and four bytes are read as an instance only if this
# writes those very bytes for it (word.py).

# -- general registers
mov_rr       | mov D64, S64                 | .mov .D .S           | D = S
             = 1 01 01010 00 0 SSSSS 000000 11111 DDDDD
mov_ri       | mov D64, I                   | .movi .D I           | D = I
             = 1 10 100101 00 IIIIIIIIIIIIIIII DDDDD
mov32_ri     | mov D32, I                   | .movi32 .D I         | D = I
             = 0 10 100101 00 IIIIIIIIIIIIIIII DDDDD
add_rrr      | add D64, S64, P64            | .add .D .S .P        | D = add64(S, P)
             = 1 0 0 01011 00 0 PPPPP 000000 SSSSS DDDDD
sub_rrr      | sub D64, S64, P64            | .sub .D .S .P        | D = sub64(S, P)
             = 1 1 0 01011 00 0 PPPPP 000000 SSSSS DDDDD
add_rri      | add D64, S64, I              | .addi .D .S I        | D = add64(S, I)
             = 1 0 0 100010 0 IIIIIIIIIIII SSSSS DDDDD
sub_rri      | sub D64, S64, I              | .subi .D .S I        | D = sub64(S, I)
             = 1 1 0 100010 0 IIIIIIIIIIII SSSSS DDDDD
lsl_ri       | lsl D64, S64, I              | .lsl .D .S I         | D = shl64(S, I)
             = 1 10 100110 1 rrrrrr ssssss SSSSS DDDDD ; I=64-r I=63-s
lsr_ri       | lsr D64, S64, I              | .lsr .D .S I         | D = shr64(S, I)
             = 1 10 100110 1 IIIIII 111111 SSSSS DDDDD
orr_rrr      | orr D64, S64, P64            | .orr64 .D .S .P      | D = or64(S, P)
             = 1 01 01010 00 0 PPPPP 000000 SSSSS DDDDD
and_rrr      | and D64, S64, P64            | .and64 .D .S .P      | D = and64(S, P)
             = 1 00 01010 00 0 PPPPP 000000 SSSSS DDDDD

# -- the stack pointer
add_sp       | add sp, sp, I                | .add_sp I            | sp = add64(sp, I)
             = 1 0 0 100010 0 IIIIIIIIIIII 11111 11111
sub_sp       | sub sp, sp, I                | .sub_sp I            | sp = sub64(sp, I)
             = 1 1 0 100010 0 IIIIIIIIIIII 11111 11111
add_of_sp    | add D64, sp, I               | .add_of_sp .D I      | D = add64(sp, I)
             = 1 0 0 100010 0 IIIIIIIIIIII 11111 DDDDD

# -- memory: a base register x0 to x30 and a displacement that is not below zero
ldr64        | ldr D64, [B64, N]            | .ldr64 .D .B N       | D = mem64(B, N)
             = 11 111 0 01 01 nnnnnnnnnnnn BBBBB DDDDD ; N=n*8
str64        | str S64, [B64, N]            | .str64 .S .B N       | mem64(B, N) = S
             = 11 111 0 01 00 nnnnnnnnnnnn BBBBB SSSSS ; N=n*8
ldr32        | ldr D32, [B64, N]            | .ldr32 .D .B N       | D = low32(mem32(B, N))
             = 10 111 0 01 01 nnnnnnnnnnnn BBBBB DDDDD ; N=n*4
str32        | str S32, [B64, N]            | .str32 .S .B N       | mem32(B, N) = low32(S)
             = 10 111 0 01 00 nnnnnnnnnnnn BBBBB SSSSS ; N=n*4
ldrb         | ldrb D32, [B64, N]           | .ldrb .D .B N        | D = mem8(B, N)
             = 00 111 0 01 01 NNNNNNNNNNNN BBBBB DDDDD
strb         | strb S32, [B64, N]           | .strb .S .B N        | mem8(B, N) = low8(S)
             = 00 111 0 01 00 NNNNNNNNNNNN BBBBB SSSSS

# -- memory at the stack pointer, which must be a multiple of 16
ldr64_sp     | ldr D64, [sp, N]             | .ldr64_sp .D N       | D = mem64(on16(sp), N)
             = 11 111 0 01 01 nnnnnnnnnnnn 11111 DDDDD ; N=n*8
str64_sp     | str S64, [sp, N]             | .str64_sp .S N       | mem64(on16(sp), N) = S
             = 11 111 0 01 00 nnnnnnnnnnnn 11111 SSSSS ; N=n*8

# -- comparisons, branches, calls, returns
cmp_rr       | cmp S64, P64                 | .cmp .S .P           | zf = equal(S, P); cf = below(S, P)
             = 1 1 1 01011 00 0 PPPPP 000000 SSSSS 11111
cmp_ri       | cmp S64, I                   | .cmpi .S I           | zf = equal(S, I); cf = below(S, I)
             = 1 1 1 100010 0 IIIIIIIIIIII SSSSS 11111
b            | -                            | .b I                 | jump I
             = 0 00101 iiiiiiiiiiiiiiiiiiiiiiiiii ; pc=I
b_eq         | -                            | .beq I               | jump I if zf
             = 0101010 0 iiiiiiiiiiiiiiiiiii 0 0000 ; pc=I
b_ne         | -                            | .bne I               | jump I if not zf
             = 0101010 0 iiiiiiiiiiiiiiiiiii 0 0001 ; pc=I
b_hs         | -                            | .bhs I               | jump I if not cf
             = 0101010 0 iiiiiiiiiiiiiiiiiii 0 0010 ; pc=I
b_lo         | -                            | .blo I               | jump I if cf
             = 0101010 0 iiiiiiiiiiiiiiiiiii 0 0011 ; pc=I
b_hi         | -                            | .bhi I               | jump I if hi
             = 0101010 0 iiiiiiiiiiiiiiiiiii 0 1000 ; pc=I
b_ls         | -                            | .bls I               | jump I if not hi
             = 0101010 0 iiiiiiiiiiiiiiiiiii 0 1001 ; pc=I
bl           | -                            | .bl I                | call I link x30
             = 1 00101 IIIIIIIIIIIIIIIIIIIIIIIIII ; call=I
ret          | -                            | .ret                 | return x30
             = 1101011 0 0 10 11111 0000 0 0 11110 00000
nop          | nop                          | .nop                 | nothing
             = 1101 0101 0000 0011 0010 0000 0001 1111

# -- vectors of four 32-bit lanes
ld1_4s       | ld1 {vX.4s}, [B64]           | .ld1 X .B            | X = mem128(B, 0)
             = 0 1 001100 0 1 0 00000 0111 10 BBBBB XXXXX
st1_4s       | st1 {vX.4s}, [B64]           | .st1 X .B            | mem128(B, 0) = X
             = 0 1 001100 0 0 0 00000 0111 10 BBBBB XXXXX
ldr128       | ldr qX, [B64, N]             | .ldr128 X .B N       | X = mem128(B, N)
             = 00 111 1 01 11 nnnnnnnnnnnn BBBBB XXXXX ; N=n*16
str128       | str qX, [B64, N]             | .str128 X .B N       | mem128(B, N) = X
             = 00 111 1 01 10 nnnnnnnnnnnn BBBBB XXXXX ; N=n*16
ldr128_sp    | ldr qX, [sp, N]              | .ldr128_sp X N       | X = mem128(on16(sp), N)
             = 00 111 1 01 11 nnnnnnnnnnnn 11111 XXXXX ; N=n*16
str128_sp    | str qX, [sp, N]              | .str128_sp X N       | mem128(on16(sp), N) = X
             = 00 111 1 01 10 nnnnnnnnnnnn 11111 XXXXX ; N=n*16
eor_v        | eor vX.16b, vY.16b, vZ.16b   | .eor X Y Z           | X = each32(xor32, Y, Z)
             = 0 1 1 01110 00 1 ZZZZZ 00011 1 YYYYY XXXXX
orr_v        | orr vX.16b, vY.16b, vZ.16b   | .orr X Y Z           | X = each32(or32, Y, Z)
             = 0 1 0 01110 10 1 ZZZZZ 00011 1 YYYYY XXXXX
and_v        | and vX.16b, vY.16b, vZ.16b   | .andv X Y Z          | X = each32(and32, Y, Z)
             = 0 1 0 01110 00 1 ZZZZZ 00011 1 YYYYY XXXXX
add_4s       | add vX.4s, vY.4s, vZ.4s      | .add4s X Y Z         | X = each32(add32, Y, Z)
             = 0 1 0 01110 10 1 ZZZZZ 10000 1 YYYYY XXXXX
rev32_8h     | rev32 vX.8h, vY.8h           | .rev32 X Y           | X = each32(ror32, Y, 16)
             = 0 1 1 01110 01 10000 00000 10 YYYYY XXXXX
ushr_4s      | ushr vX.4s, vY.4s, I         | .ushr X Y I          | X = each32(shr32, Y, I)
             = 0 1 1 011110 01 iiiii 00000 1 YYYYY XXXXX ; I=32-i
shl_4s       | shl vX.4s, vY.4s, I          | .shl X Y I           | X = each32(shl32, Y, I)
             = 0 1 0 011110 01 IIIII 01010 1 YYYYY XXXXX
fmov_d       | fmov dX, S64                 | .fmovd X .S          | X = lanes_of64(S)
             = 1 00 11110 01 1 00 111 000000 SSSSS XXXXX
uzp1_4s      | uzp1 vX.4s, vY.4s, vZ.4s     | .uzp1_4s X Y Z       | X = lanes(Y.0, Y.2, Z.0, Z.2)
             = 0 1 0 01110 10 0 ZZZZZ 0 001 10 YYYYY XXXXX
uzp2_4s      | uzp2 vX.4s, vY.4s, vZ.4s     | .uzp2_4s X Y Z       | X = lanes(Y.1, Y.3, Z.1, Z.3)
             = 0 1 0 01110 10 0 ZZZZZ 0 101 10 YYYYY XXXXX
zip1_4s      | zip1 vX.4s, vY.4s, vZ.4s     | .zip1_4s X Y Z       | X = lanes(Y.0, Z.0, Y.1, Z.1)
             = 0 1 0 01110 10 0 ZZZZZ 0 011 10 YYYYY XXXXX
zip2_4s      | zip2 vX.4s, vY.4s, vZ.4s     | .zip2_4s X Y Z       | X = lanes(Y.2, Z.2, Y.3, Z.3)
             = 0 1 0 01110 10 0 ZZZZZ 0 111 10 YYYYY XXXXX
zip1_2d      | zip1 vX.2d, vY.2d, vZ.2d     | .zip1_2d X Y Z       | X = lanes(Y.0, Y.1, Z.0, Z.1)
             = 0 1 0 01110 11 0 ZZZZZ 0 011 10 YYYYY XXXXX
zip2_2d      | zip2 vX.2d, vY.2d, vZ.2d     | .zip2_2d X Y Z       | X = lanes(Y.2, Y.3, Z.2, Z.3)
             = 0 1 0 01110 11 0 ZZZZZ 0 111 10 YYYYY XXXXX
ext_4        | ext vX.16b, vY.16b, vZ.16b, 4  | .ext4 X Y Z        | X = lanes(Y.1, Y.2, Y.3, Z.0)
             = 0 1 1 01110 000 ZZZZZ 0 0100 0 YYYYY XXXXX
ext_8        | ext vX.16b, vY.16b, vZ.16b, 8  | .ext8 X Y Z        | X = lanes(Y.2, Y.3, Z.0, Z.1)
             = 0 1 1 01110 000 ZZZZZ 0 1000 0 YYYYY XXXXX
ext_12       | ext vX.16b, vY.16b, vZ.16b, 12 | .ext12 X Y Z       | X = lanes(Y.3, Z.0, Z.1, Z.2)
             = 0 1 1 01110 000 ZZZZZ 0 1100 0 YYYYY XXXXX
sha256h      | sha256h qX, qY, vZ.4s        | .sha256h X Y Z        | X = sha256h(X, Y, Z)
             = 0 1 0 11110 00 0 ZZZZZ 0 100 00 YYYYY XXXXX
sha256h2     | sha256h2 qX, qY, vZ.4s       | .sha256h2 X Y Z       | X = sha256h2(X, Y, Z)
             = 0 1 0 11110 00 0 ZZZZZ 0 101 00 YYYYY XXXXX
sha256su0    | sha256su0 vX.4s, vY.4s       | .sha256su0 X Y        | X = sha256msg1(X, Y)
             = 0 1 0 11110 00 10100 0 0010 10 YYYYY XXXXX
sha256su1    | sha256su1 vX.4s, vY.4s, vZ.4s | .sha256su1 X Y Z     | X = sha256su1(X, Y, Z)
             = 0 1 0 11110 00 0 ZZZZZ 0 110 00 YYYYY XXXXX
