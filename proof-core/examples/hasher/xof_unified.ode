// BLAKE3 64-byte XOF root output block for x86-64 (AVX-512VL) and AArch64 (NEON).
// Zero stack, zero read-only data, constant-time (`trace depends on nothing`).
use b3 = "../hashr_arm64_fast/blake3_spec.ode"
use xof = "xof_spec.ode"

inline fn g_sse2 for x86_64 (a: xmm, b: xmm, c: xmm, d: xmm, x: xmm, y: xmm, t: xmm) distinct(a, b, c, d, x, y, t) changes a, b, c, d, t {
  paddd a, x
  paddd a, b
  pxor d, a
  movdqa t, d
  pslld d, 16
  psrld t, 16
  por d, t
  paddd c, d
  pxor b, c
  movdqa t, b
  pslld b, 20
  psrld t, 12
  por b, t
  paddd a, y
  paddd a, b
  pxor d, a
  movdqa t, d
  pslld d, 24
  psrld t, 8
  por d, t
  paddd c, d
  pxor b, c
  movdqa t, b
  pslld b, 25
  psrld t, 7
  por b, t
}

inline fn g_neon for arm64 (a: vec, b: vec, c: vec, d: vec, mx: vec, my: vec, t: vec) distinct(a, b, c, d, mx, my, t) changes a, b, c, d, t {
  add a.4s, a.4s, mx.4s
  add a.4s, a.4s, b.4s
  eor d.16b, d.16b, a.16b
  rev32 d.8h, d.8h
  add c.4s, c.4s, d.4s
  eor b.16b, b.16b, c.16b
  ushr t.4s, b.4s, 12
  shl b.4s, b.4s, 20
  orr b.16b, b.16b, t.16b
  add a.4s, a.4s, my.4s
  add a.4s, a.4s, b.4s
  eor d.16b, d.16b, a.16b
  ushr t.4s, d.4s, 8
  shl d.4s, d.4s, 24
  orr d.16b, d.16b, t.16b
  add c.4s, c.4s, d.4s
  eor b.16b, b.16b, c.16b
  ushr t.4s, b.4s, 7
  shl b.4s, b.4s, 25
  orr b.16b, b.16b, t.16b
}

inline fn permute_msg for arm64 (m0: vec, m1: vec, m2: vec, m3: vec, t0: vec, t1: vec, t2: vec, t3: vec, t4: vec, t5: vec, t6: vec) distinct(m0, m1, m2, m3, t0, t1, t2, t3, t4, t5, t6) changes m0, m1, m2, m3, t0, t1, t2, t3, t4, t5, t6 {
  uzp2 t0.4s, m1.4s, m0.4s
  zip1 t1.2d, m0.2d, t0.2d
  ext t2.16b, m0.16b, m0.16b, 8
  ext t3.16b, m2.16b, m0.16b, 4
  uzp2 t4.4s, m0.4s, t3.4s
  ext t5.16b, m3.16b, m0.16b, 12
  ext m0.16b, t1.16b, t2.16b, 4
  uzp1 t0.4s, m3.4s, m1.4s
  ext t1.16b, m2.16b, m3.16b, 12
  zip2 t2.4s, m1.4s, m3.4s
  zip1 t3.2d, m2.2d, t2.2d
  ext t6.16b, m1.16b, m2.16b, 4
  ext m1.16b, t4.16b, t5.16b, 4
  uzp1 m2.4s, t0.4s, t1.4s
  uzp2 m3.4s, t3.4s, t6.4s
}

data xof_iv = 0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A

fn compress_xof(out: 2 cvs, h: cv, m: block, length: word, t: counter, flags: low word)
    requires no_overlap(out, h, m)
    ensures out[i] = xof.compress_xof_half(h, m, t, length, flags, i) for i in 0..2
    trace depends on nothing
    stack 0
{
    for x86_64 {
        // rdi = out (64 B), rsi = h (32 B), rdx = m (64 B), rcx = length, r8 = t, r9 = flags
        movups xmm0, xmmword ptr [rsi]
        movups xmm1, xmmword ptr [rsi+0x10]
        movaps xmm2, xmmword ptr [rip + #xof_iv]
        shl r9, 32
        add rcx, r9
        movq xmm3, r8
        movq xmm4, rcx
        punpcklqdq xmm3, xmm4

        movups xmm8, xmmword ptr [rdx]
        movups xmm9, xmmword ptr [rdx+0x10]
        movdqa xmm4, xmm8
        shufps xmm4, xmm9, 136
        movdqa xmm5, xmm8
        shufps xmm5, xmm9, 221
        movups xmm8, xmmword ptr [rdx+0x20]
        movups xmm9, xmmword ptr [rdx+0x30]
        movdqa xmm6, xmm8
        shufps xmm6, xmm9, 136
        movdqa xmm7, xmm8
        shufps xmm7, xmm9, 221
        pshufd xmm6, xmm6, 0x93
        pshufd xmm7, xmm7, 0x93
        mov al, 7
    @round:
        g_sse2(xmm0, xmm1, xmm2, xmm3, xmm4, xmm5, xmm10)
        pshufd xmm0, xmm0, 0x93
        pshufd xmm3, xmm3, 0x4E
        pshufd xmm2, xmm2, 0x39
        g_sse2(xmm0, xmm1, xmm2, xmm3, xmm6, xmm7, xmm10)
        pshufd xmm0, xmm0, 0x39
        pshufd xmm3, xmm3, 0x4E
        pshufd xmm2, xmm2, 0x93
        dec al
        jz @done
        movdqa xmm8, xmm4
        shufps xmm8, xmm5, 214
        pshufd xmm9, xmm4, 0x0F
        pshufd xmm4, xmm8, 0x39
        movdqa xmm8, xmm6
        shufps xmm8, xmm7, 250
        // blend4(xmm9, xmm8, 0xA) = [xmm9[0], xmm8[1], xmm9[2], xmm8[3]]
        shufps xmm9, xmm9, 0x88
        shufps xmm8, xmm8, 0xDD
        punpckldq xmm9, xmm8
        movdqa xmm8, xmm7
        punpcklqdq xmm8, xmm5
        // blend4(xmm8, xmm6, 0x8) = [xmm8[0], xmm8[1], xmm8[2], xmm6[3]]
        movdqa xmm10, xmm8
        shufps xmm10, xmm6, 0xEE
        shufps xmm8, xmm10, 0xC4
        pshufd xmm8, xmm8, 0x78
        punpckhdq xmm5, xmm7
        punpckldq xmm6, xmm5
        pshufd xmm7, xmm6, 0x1E
        movdqa xmm5, xmm9
        movdqa xmm6, xmm8
        jmp @round
    @done:
        movups xmm10, xmmword ptr [rsi]
        movups xmm11, xmmword ptr [rsi+0x10]
        pxor xmm0, xmm2
        pxor xmm1, xmm3
        pxor xmm2, xmm10
        pxor xmm3, xmm11
        movups xmmword ptr [rdi], xmm0
        movups xmmword ptr [rdi+0x10], xmm1
        movups xmmword ptr [rdi+0x20], xmm2
        movups xmmword ptr [rdi+0x30], xmm3
        ret
    }
    for arm64 {
        reg outp = x0, hptr = x1, mptr = x2, blen = x3, ctr = x4, flg = x5
        reg addr = x9, tmp = x10, rounds = x11

        ld1 {v0.4s}, [hptr]
        add addr, hptr, 16
        ld1 {v1.4s}, [addr]

        addr := 0xBB67
        lsl addr, addr, 16
        tmp := 0xAE85
        add addr, addr, tmp
        lsl addr, addr, 16
        tmp := 0x6A09
        add addr, addr, tmp
        lsl addr, addr, 16
        tmp := 0xE667
        add addr, addr, tmp
        fmov d2, addr

        addr := 0xA54F
        lsl addr, addr, 16
        tmp := 0xF53A
        add addr, addr, tmp
        lsl addr, addr, 16
        tmp := 0x3C6E
        add addr, addr, tmp
        lsl addr, addr, 16
        tmp := 0xF372
        add addr, addr, tmp
        fmov d16, addr
        zip1 v2.2d, v2.2d, v16.2d

        lsl tmp, flg, 32
        add addr, blen, tmp
        fmov d3, ctr
        fmov d16, addr
        zip1 v3.2d, v3.2d, v16.2d

        ld1 {v16.4s}, [mptr]
        add addr, mptr, 16
        ld1 {v17.4s}, [addr]
        add addr, mptr, 32
        ld1 {v18.4s}, [addr]
        add addr, mptr, 48
        ld1 {v19.4s}, [addr]

        uzp1 v4.4s, v16.4s, v17.4s
        uzp2 v5.4s, v16.4s, v17.4s
        uzp1 v20.4s, v18.4s, v19.4s
        ext v6.16b, v20.16b, v20.16b, 12
        uzp2 v21.4s, v18.4s, v19.4s
        ext v7.16b, v21.16b, v21.16b, 12

        rounds := 7
    @round:
        g_neon(v0, v1, v2, v3, v4, v5, v16)
        ext v0.16b, v0.16b, v0.16b, 12
        ext v3.16b, v3.16b, v3.16b, 8
        ext v2.16b, v2.16b, v2.16b, 4
        g_neon(v0, v1, v2, v3, v6, v7, v16)
        ext v0.16b, v0.16b, v0.16b, 4
        ext v3.16b, v3.16b, v3.16b, 8
        ext v2.16b, v2.16b, v2.16b, 12
        sub rounds, rounds, 1
        cmp rounds, 0
        b.eq @done
        permute_msg(v4, v5, v6, v7, v16, v17, v18, v19, v20, v21, v22)
        b @round

    @done:
        ld1 {v16.4s}, [hptr]
        add addr, hptr, 16
        ld1 {v17.4s}, [addr]
        eor v0.16b, v0.16b, v2.16b
        eor v1.16b, v1.16b, v3.16b
        eor v2.16b, v2.16b, v16.16b
        eor v3.16b, v3.16b, v17.16b
        st1 {v0.4s}, [outp]
        add addr, outp, 16
        st1 {v1.4s}, [addr]
        add addr, outp, 32
        st1 {v2.4s}, [addr]
        add addr, outp, 48
        st1 {v3.4s}, [addr]
        ret
    }
}
