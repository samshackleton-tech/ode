// One block compressed from a key, as examples/keyed does it, but the kernel is handed its flags packed
// into a larger number: the record's flags put together with PARENT (4) and with the bit 2^34. The kernel
// reads the low 32 bits of the register it is given the flags in, so the bit 2^34 changes nothing, and the
// block is compressed with the flags and PARENT. The hash's upper functions pack the flags of their wide
// kernels in this way (`flags | 0x40020100`: the flags' byte, and three bytes more above it).
// high(out, m, kf): arguments in rdi, rsi, rdx, as C passes them.
fn high as "ode_high" {
  sub rsp, 8
  movups xmm0, xmmword ptr [rdx + 0]
  movups xmmword ptr [rdi + 0], xmm0
  movups xmm0, xmmword ptr [rdx + 16]
  movups xmmword ptr [rdi + 16], xmm0
  mov r8, qword ptr [rdx + 32]
  // packed = flags | ((1 << 34) | 4)
  mov rax, 1
  shl rax, 34
  or rax, 4
  or r8, rax
  mov rdx, 64
  mov rcx, 0
  call blake3_servil_compress_in_place_sse41
  add rsp, 8
  ret
}
