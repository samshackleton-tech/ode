// The last block of the left part of a message of more than one chunk. BLAKE3 splits such a message in
// two: the left part is the greatest power-of-two count of chunks that leaves bytes for the right. The
// function finds that count as the hash's b3l_take and b3l_subtree do: c = ((len - 1) >> 10) + 1 is the
// count of chunks, the last one whole or not; k starts at 1 and takes the value of its double k2 while
// k2 is below c. It gives the one-block kernel the address of the 64 bytes that end the left part.
// left_last(h, input, len): arguments in rdi, rsi, rdx, as C passes them.
fn left_last as "ode_left_last" {
  sub rsp, 8
  mov rcx, rdx
  sub rcx, 1
  shr rcx, 10
  add rcx, 1
  mov r9, 1
  mov rax, 2
@l2:
  cmp rax, rcx
  jae @l3
  mov r9, rax
  shl rax, 1
  jmp @l2
@l3:
  shl r9, 10
  add rsi, r9
  sub rsi, 64
  mov rdx, 64
  mov rcx, 0
  mov r8, 0
  call blake3_servil_compress_in_place_sse41
  add rsp, 8
  ret
}
