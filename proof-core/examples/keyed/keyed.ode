// One block compressed from a key, with the flags that lie beside the key. The record is the hash's own
// `keyed`: a key of 32 bytes, then the flags as a number of eight bytes. The function copies the key to
// `out` (sixteen bytes at a time, through a vector register), reads the flags, and calls the one-block
// kernel, which reads and writes `out`. This is how the hash's `b3l_take` and `b3l_subtree` begin a parent.
// keyed(out, m, kf): arguments in rdi, rsi, rdx, as C passes them.
fn keyed as "ode_keyed" {
  sub rsp, 8
  movups xmm0, xmmword ptr [rdx + 0]
  movups xmmword ptr [rdi + 0], xmm0
  movups xmm0, xmmword ptr [rdx + 16]
  movups xmmword ptr [rdi + 16], xmm0
  mov r8, qword ptr [rdx + 32]
  mov rdx, 64
  mov rcx, 0
  call blake3_servil_compress_in_place_sse41
  add rsp, 8
  ret
}
