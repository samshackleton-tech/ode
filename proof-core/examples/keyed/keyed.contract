// The contract of ode_keyed (keyed.ode). `out` becomes the compression of the block `m` from the key, with
// the record's flags, as ../../../kcheck/blake3.spec defines `compress`. The layout is the one
// ../../../kcheck/proofs/inner.spec has for the hash.
// There is no `trace` line: which instructions run and which addresses are touched depend on nothing that
// is given, so not on a byte of the block or of the record (the key and the flags). The flags are read
// from the record and handed to the kernel in a register; the kernel's contract hides its flags, so the
// call is accepted with something hidden there.
layout keyed 40 { key: cv at 0, flags: byte at 32 }

contract ode_keyed(out: cv, m: block, kf: keyed) {
    requires no_overlap(out, m, kf)
    ensures out = compress(kf.key, m, counter(0), 64, kf.flags)
    stack 64
    needs sse41
}
