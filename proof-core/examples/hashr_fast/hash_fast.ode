// Fast short-input x86-64 BLAKE3 glue using Phase 1 custom `calling { ... }` conventions
// and zero-spill fast paths (`len <= 1024`) in `b3l_hashr`.
//
// Meets the EXACT SAME canonical `.ocl` contract (`blake3.spec` `b3l_hashr`,
// contract ID `7jb2pyzuwz6tqd3qmjsra3mk36tl4547sfpy3at5scbk772lbila`) as `kcheck/hash.ode`.

// Fast leaf `pad` with custom Ode calling convention:
//   in:  block = r10, src = rsi, n = rdx
//   preserves: rdi, rsi, rdx, r8, r9, rbx, rbp, r12, r13, r14, r15
//   stack: 0 bytes (ZERO callee-saved pushes or pops!)
//
// - Fast path (`n == 64`): 0 branches, 0 loop overhead, direct `[rsi + K]` -> `[r10 + K]` copy.
// - General path (`n < 64`): two branch-free loops (zero `[n..64)` then copy `[0..n)`).
fn pad_fast as "b3l_pad_fast" {
  cmp rdx, 64
  jne @lt64
  // Fast 64-byte path: 8-byte-step loop (8 iterations total, 0 inner branches, stack 0!)
  mov rcx, 64
  mov r8, 8
@l64:
  place {
    name i = rcx
    name k = r8
    fact k <= 8
    fact i == 8 * k
    wrote block[i ..] = padded(src)
    decreases k
  }
  cmp r8, 0
  je @done
  sub r8, 1
  sub rcx, 8
  mov rax, rsi
  add rax, rcx
  mov r11, r10
  add r11, rcx
  movzx r9d, byte ptr [rax + 7]
  mov byte ptr [r11 + 7], r9b
  movzx r9d, byte ptr [rax + 6]
  mov byte ptr [r11 + 6], r9b
  movzx r9d, byte ptr [rax + 5]
  mov byte ptr [r11 + 5], r9b
  movzx r9d, byte ptr [rax + 4]
  mov byte ptr [r11 + 4], r9b
  movzx r9d, byte ptr [rax + 3]
  mov byte ptr [r11 + 3], r9b
  movzx r9d, byte ptr [rax + 2]
  mov byte ptr [r11 + 2], r9b
  movzx r9d, byte ptr [rax + 1]
  mov byte ptr [r11 + 1], r9b
  movzx r9d, byte ptr [rax + 0]
  mov byte ptr [r11 + 0], r9b
  jmp @l64

@lt64:
  // Zero [n..64) with zero inner branch, then copy [0..n) with zero inner branch.
  mov rcx, 64
@zloop:
  place {
    name i = rcx
    fact i <= 64
    fact n <= i
    wrote block[i ..] = padded(src)
    decreases i
  }
  cmp rcx, rdx
  je @cloop
  sub rcx, 1
  mov r11, r10
  add r11, rcx
  mov byte ptr [r11], 0
  jmp @zloop

@cloop:
  place {
    name i = rcx
    fact i <= n
    wrote block[i ..] = padded(src)
    decreases i
  }
  cmp rcx, 0
  je @done
  sub rcx, 1
  mov rax, rsi
  add rax, rcx
  movzx eax, byte ptr [rax]
  mov r11, r10
  add r11, rcx
  mov byte ptr [r11], al
  jmp @cloop
@done:
  ret
}

// Fast `chunk_node` using custom-calling `b3l_pad_fast`:
//   - For single-block chunks (`len <= 64`): ZERO callee-saved pushes/pops, ZERO stack use,
//     tail-jumps directly into `b3l_pad_fast`!
//   - For multi-block chunks (`64 < len <= 1024`): registers hold live state, calls `b3l_pad_fast`.
fn chunk_node_fast as "b3l_chunk_node_fast" {
  cmp rdx, 65
  jae @multi
  mov qword ptr [rdi + 96], rcx
  mov qword ptr [rdi + 104], rdx
  or r8, 1
  or r8, 2
  mov qword ptr [rdi + 112], r8
  lea r10, [rdi + 32]
  jmp b3l_pad_fast

@multi:
  push rbx
  push rbp
  push r12
  push r13
  push r14
  push r15
  sub rsp, 24
  mov r13, rdi
  mov rbx, rsi
  mov rbp, rdx
  mov r14, rcx
  mov qword ptr [rsp + 0], r8
  mov r15, r9
  mov r12, 1
@l0:
  cmp rbp, 65
  jb @l1
  mov r8, qword ptr [rsp + 0]
  or r8, r12
  mov rdi, r13
  mov rsi, rbx
  mov rdx, 64
  mov rcx, r14
  cmp r15, 5
  jne @l2
  call blake3_servil_compress_in_place_avx512
  jmp @l3
@l2:
  call blake3_servil_compress_in_place_sse41
@l3:
  mov r12, 0
  add rbx, 64
  sub rbp, 64
  jmp @l0
@l1:
  lea r10, [r13 + 32]
  mov rsi, rbx
  mov rdx, rbp
  call b3l_pad_fast
  mov qword ptr [r13 + 96], r14
  mov qword ptr [r13 + 104], rbp
  mov rax, qword ptr [rsp + 0]
  or rax, r12
  or rax, 2
  mov qword ptr [r13 + 112], rax
  add rsp, 24
  pop r15
  pop r14
  pop r13
  pop r12
  pop rbp
  pop rbx
  ret
}

// Fast `hashr` entry point:
//   - `len == 64`:   12-instruction ZERO-COPY tail-call fast path! Tail-jumps directly into
//                    `compress_in_place` on `input` (zero stack adjustment, zero pushes/pops,
//                    zero stack block copy, zero `call`/`ret` round-trip!).
// Fast 16-way AVX-512 path for 2..16 chunks (1,025 .. 16,384 bytes): calls `blake3_servil_avx512_k16`
// (16 lanes instead of 32), cutting 4 KiB..16 KiB work in half.
fn hashr_k16 as "b3l_hashr_k16" {
  push rbx
  push rbp
  push r12
  push r13
  push r14
  push r15
  sub rsp, 792
  mov rbx, rdi
  mov rbp, rsi
  mov r12, rdx
  mov r13, rcx
  mov r14, r8

  // kf.key = key[0..32], kf.flags = flags
  movups xmm0, xmmword ptr [r13 + 0]
  movups xmmword ptr [rsp + 0], xmm0
  movups xmm0, xmmword ptr [r13 + 16]
  movups xmmword ptr [rsp + 16], xmm0
  mov qword ptr [rsp + 32], r14

  // whole = len >> 10
  mov r15, r12
  shr r15, 10

  // Fill ptrs[0..16] at [rsp + 112]: pre-fill all 16 with `input`, then overwrite
  // 1..whole with `input + i*1024` (early exit at `whole`: linear paths, zero loop overhead).
  mov qword ptr [rsp + 112], rbp
  mov qword ptr [rsp + 120], rbp
  mov qword ptr [rsp + 128], rbp
  mov qword ptr [rsp + 136], rbp
  mov qword ptr [rsp + 144], rbp
  mov qword ptr [rsp + 152], rbp
  mov qword ptr [rsp + 160], rbp
  mov qword ptr [rsp + 168], rbp
  mov qword ptr [rsp + 176], rbp
  mov qword ptr [rsp + 184], rbp
  mov qword ptr [rsp + 192], rbp
  mov qword ptr [rsp + 200], rbp
  mov qword ptr [rsp + 208], rbp
  mov qword ptr [rsp + 216], rbp
  mov qword ptr [rsp + 224], rbp
  mov qword ptr [rsp + 232], rbp
  mov rax, rbp
  cmp r15, 2
  jb @p16_done
  add rax, 1024
  mov qword ptr [rsp + 120], rax
  cmp r15, 3
  jb @p16_done
  add rax, 1024
  mov qword ptr [rsp + 128], rax
  cmp r15, 4
  jb @p16_done
  add rax, 1024
  mov qword ptr [rsp + 136], rax
  cmp r15, 5
  jb @p16_done
  add rax, 1024
  mov qword ptr [rsp + 144], rax
  cmp r15, 6
  jb @p16_done
  add rax, 1024
  mov qword ptr [rsp + 152], rax
  cmp r15, 7
  jb @p16_done
  add rax, 1024
  mov qword ptr [rsp + 160], rax
  cmp r15, 8
  jb @p16_done
  add rax, 1024
  mov qword ptr [rsp + 168], rax
  cmp r15, 9
  jb @p16_done
  add rax, 1024
  mov qword ptr [rsp + 176], rax
  cmp r15, 10
  jb @p16_done
  add rax, 1024
  mov qword ptr [rsp + 184], rax
  cmp r15, 11
  jb @p16_done
  add rax, 1024
  mov qword ptr [rsp + 192], rax
  cmp r15, 12
  jb @p16_done
  add rax, 1024
  mov qword ptr [rsp + 200], rax
  cmp r15, 13
  jb @p16_done
  add rax, 1024
  mov qword ptr [rsp + 208], rax
  cmp r15, 14
  jb @p16_done
  add rax, 1024
  mov qword ptr [rsp + 216], rax
  cmp r15, 15
  jb @p16_done
  add rax, 1024
  mov qword ptr [rsp + 224], rax
  cmp r15, 16
  jb @p16_done
  add rax, 1024
  mov qword ptr [rsp + 232], rax
@p16_done:

  // kp = flags | 0x40020100 (CHUNK_START=1, CHUNK_END=2, len=64)
  mov r8, r14
  or r8, 1073873152
  lea rdi, [rsp + 112]
  mov rsi, 16
  lea rdx, [rsp + 0]
  mov rcx, 0
  lea r9, [rsp + 240]
  call blake3_servil_avx512_k16

  // c = ((len - 1) >> 10) + 1 (2 <= c <= 16); greatest power of two k < c (k in {1, 2, 4, 8})
  mov r10, r12
  sub r10, 1
  shr r10, 10
  add r10, 1
  mov rax, 1
  cmp r10, 3
  jb @k_done
  mov rax, 2
  cmp r10, 5
  jb @k_done
  mov rax, 4
  cmp r10, 9
  jb @k_done
  mov rax, 8
@k_done:
  mov qword ptr [rsp + 752], rax
  mov rdx, rax
  shl rdx, 10
  mov qword ptr [rsp + 760], rdx

  // b3l_take(blk, input, wn, kf, 0, cvs)
  lea rdi, [rsp + 48]
  mov rsi, rbp
  lea rcx, [rsp + 0]
  mov r8, 0
  lea r9, [rsp + 240]
  call b3l_take

  // b3l_take(blk + 32, input + wn, len - wn, kf, k, cvs + (k << 5))
  lea rdi, [rsp + 80]
  mov rdx, qword ptr [rsp + 760]
  mov rsi, rbp
  add rsi, rdx
  mov rax, r12
  sub rax, rdx
  mov rdx, rax
  lea rcx, [rsp + 0]
  mov r8, qword ptr [rsp + 752]
  lea r9, [rsp + 240]
  mov rax, r8
  shl rax, 5
  add r9, rax
  call b3l_take

  // copy key -> out, then compress(out, blk, 64, 0, flags | PARENT | ROOT)
  movups xmm0, xmmword ptr [r13 + 0]
  movups xmmword ptr [rbx + 0], xmm0
  movups xmm0, xmmword ptr [r13 + 16]
  movups xmmword ptr [rbx + 16], xmm0
  mov r8, r14
  or r8, 4
  or r8, 8
  mov rdi, rbx
  lea rsi, [rsp + 48]
  mov rdx, 64
  mov rcx, 0
  call blake3_servil_compress_in_place_avx512

  add rsp, 792
  pop r15
  pop r14
  pop r13
  pop r12
  pop rbp
  pop rbx
  ret
}

// Fast top-level `b3l_hashr`:
//   - `len == 64`:  ZERO stack frame, ZERO callee-saved pushes/pops, ZERO block copy: copies the
//                   32-byte key into `out`, sets `flags |= 1|2|8`, sets `t = 0`, and tail-jumps
//                   straight into `blake3_servil_compress_in_place_{avx512,sse41}` (`jmp`).
//   - `len <= 1024` (other than 64): ZERO callee-saved pushes/pops in `hashr`, 136-byte stack
//                    (vs 1,672 B!), calls `b3l_chunk_node_fast` (which tail-jumps into
//                    `b3l_pad_fast` with `stack 0` for `len <= 64`) + `b3l_node_out`.
//   - `1025..16384` (AVX-512): tail-jump `jmp b3l_hashr_k16` (16-lane AVX-512 `k16`).
//   - `len > 16384` (or non-AVX-512 `len > 1024`): tail-jump `jmp b3l_hashr_long`.
fn hashr_fast as "b3l_hashr" {
  cmp rdx, 64
  jne @not64
  movups xmm0, xmmword ptr [rcx + 0]
  movups xmmword ptr [rdi + 0], xmm0
  movups xmm0, xmmword ptr [rcx + 16]
  movups xmmword ptr [rdi + 16], xmm0
  or r8, 1
  or r8, 2
  or r8, 8
  mov rcx, 0
  cmp r9, 5
  jne @eq64_sse
  jmp blake3_servil_compress_in_place_avx512
@eq64_sse:
  jmp blake3_servil_compress_in_place_sse41

@not64:
  cmp rdx, 1025
  jae @over1024
  sub rsp, 136
  mov qword ptr [rsp + 120], rdi
  mov qword ptr [rsp + 128], r9
  movups xmm0, xmmword ptr [rcx + 0]
  movups xmmword ptr [rsp + 0], xmm0
  movups xmm0, xmmword ptr [rcx + 16]
  movups xmmword ptr [rsp + 16], xmm0
  lea rdi, [rsp + 0]
  mov rcx, 0
  call b3l_chunk_node_fast
  mov rdi, qword ptr [rsp + 120]
  lea rsi, [rsp + 0]
  mov rdx, 8
  mov rcx, qword ptr [rsp + 128]
  call b3l_node_out
  add rsp, 136
  ret

@over1024:
  cmp r9, 5
  jne @go_long
  cmp rdx, 16385
  jae @go_long
  jmp b3l_hashr_k16
@go_long:
  jmp b3l_hashr_long
}
