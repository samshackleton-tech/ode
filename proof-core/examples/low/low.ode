// The low byte of one number and the low half of another, added. The first function shown by the verifier
// in Lean that uses the rows which write the low half of a register (`movzx eax, dil`, `mov ecx, esi`).
// low(a, b): arguments in rdi, rsi.
fn low as "ode_low" {
  movzx eax, dil
  mov ecx, esi
  add rax, rcx
  ret
}

// A number's quotient by eight, by a shift. The specification's `a / 8` is a quotient the verifier opens for
// itself; that it is the code's is shown by arithmetic.
// eighth(a): the argument in rdi.
fn eighth as "ode_eighth" {
  mov rax, rdi
  shr rax, 3
  ret
}
