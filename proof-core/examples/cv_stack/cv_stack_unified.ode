// Incremental BLAKE3 CvStack finalization (`cv_finalize`) for x86-64 and AArch64.
use b3 = "ya6gqve7vxwsty67gvln6hr4lxkvo2vmknwk4l3prxrvtmuetiqq"  // blake3_spec.ode
use cvspec = "5tpdkdrx6hw6fwbxri6ub5cjpas3ev5zbc4mtjlscsymqkw6dngq"  // cv_stack_spec.ode

data cv_iv = 0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A

inline fn g_sse2 for x86_64 (a: xmm, b: xmm, c: xmm, d: xmm, x: xmm, y: xmm, t: xmm) distinct(a, b, c, d, x, y, t) changes a, b, c, d, t {
  paddd a, x
  paddd a, b
  pxor d, a
  movdqa t, d
  pslld d, 16
  psrld t, 16
  por d, t
  paddd c, d
  pxor b, c
  movdqa t, b
  pslld b, 20
  psrld t, 12
  por b, t
  paddd a, y
  paddd a, b
  pxor d, a
  movdqa t, d
  pslld d, 24
  psrld t, 8
  por d, t
  paddd c, d
  pxor b, c
  movdqa t, b
  pslld b, 25
  psrld t, 7
  por b, t
}

inline fn g_neon for arm64 (a: vec, b: vec, c: vec, d: vec, mx: vec, my: vec, t: vec) distinct(a, b, c, d, mx, my, t) changes a, b, c, d, t {
  add a.4s, a.4s, mx.4s
  add a.4s, a.4s, b.4s
  eor d.16b, d.16b, a.16b
  rev32 d.8h, d.8h
  add c.4s, c.4s, d.4s
  eor b.16b, b.16b, c.16b
  ushr t.4s, b.4s, 12
  shl b.4s, b.4s, 20
  orr b.16b, b.16b, t.16b
  add a.4s, a.4s, my.4s
  add a.4s, a.4s, b.4s
  eor d.16b, d.16b, a.16b
  ushr t.4s, d.4s, 8
  shl d.4s, d.4s, 24
  orr d.16b, d.16b, t.16b
  add c.4s, c.4s, d.4s
  eor b.16b, b.16b, c.16b
  ushr t.4s, b.4s, 7
  shl b.4s, b.4s, 25
  orr b.16b, b.16b, t.16b
}

inline fn permute_msg for arm64 (m0: vec, m1: vec, m2: vec, m3: vec, t0: vec, t1: vec, t2: vec, t3: vec, t4: vec, t5: vec, t6: vec) distinct(m0, m1, m2, m3, t0, t1, t2, t3, t4, t5, t6) changes m0, m1, m2, m3, t0, t1, t2, t3, t4, t5, t6 {
  uzp2 t0.4s, m1.4s, m0.4s
  zip1 t1.2d, m0.2d, t0.2d
  ext t2.16b, m0.16b, m0.16b, 8
  ext t3.16b, m2.16b, m0.16b, 4
  uzp2 t4.4s, m0.4s, t3.4s
  ext t5.16b, m3.16b, m0.16b, 12
  ext m0.16b, t1.16b, t2.16b, 4
  uzp1 t0.4s, m3.4s, m1.4s
  ext t1.16b, m2.16b, m3.16b, 12
  zip2 t2.4s, m1.4s, m3.4s
  zip1 t3.2d, m2.2d, t2.2d
  ext t6.16b, m1.16b, m2.16b, 4
  ext m1.16b, t4.16b, t5.16b, 4
  uzp1 m2.4s, t0.4s, t1.4s
  uzp2 m3.4s, t3.4s, t6.4s
}

fn compress1(h: cv, m: block, length: word, t: counter, flags: low word)
    requires no_overlap(h, m)
    ensures h = b3.compress(h, m, t, length, flags)
    trace depends on nothing
    stack 0
{
    for x86_64 {
        // rdi = h, rsi = m, rdx = length, rcx = t, r8 = flags
        movups xmm0, xmmword ptr [rdi]
        movups xmm1, xmmword ptr [rdi+0x10]
        movaps xmm2, xmmword ptr [rip + #cv_iv]
        shl r8, 32
        add rdx, r8
        movq xmm3, rcx
        movq xmm4, rdx
        punpcklqdq xmm3, xmm4

        movups xmm8, xmmword ptr [rsi]
        movups xmm9, xmmword ptr [rsi+0x10]
        movdqa xmm4, xmm8
        shufps xmm4, xmm9, 136
        movdqa xmm5, xmm8
        shufps xmm5, xmm9, 221
        movups xmm8, xmmword ptr [rsi+0x20]
        movups xmm9, xmmword ptr [rsi+0x30]
        movdqa xmm6, xmm8
        shufps xmm6, xmm9, 136
        movdqa xmm7, xmm8
        shufps xmm7, xmm9, 221
        pshufd xmm6, xmm6, 0x93
        pshufd xmm7, xmm7, 0x93
        mov al, 7
    @round:
        g_sse2(xmm0, xmm1, xmm2, xmm3, xmm4, xmm5, xmm10)
        pshufd xmm0, xmm0, 0x93
        pshufd xmm3, xmm3, 0x4E
        pshufd xmm2, xmm2, 0x39
        g_sse2(xmm0, xmm1, xmm2, xmm3, xmm6, xmm7, xmm10)
        pshufd xmm0, xmm0, 0x39
        pshufd xmm3, xmm3, 0x4E
        pshufd xmm2, xmm2, 0x93
        dec al
        jz @done
        movdqa xmm8, xmm4
        shufps xmm8, xmm5, 214
        pshufd xmm9, xmm4, 0x0F
        pshufd xmm4, xmm8, 0x39
        movdqa xmm8, xmm6
        shufps xmm8, xmm7, 250
        shufps xmm9, xmm9, 0x88
        shufps xmm8, xmm8, 0xDD
        punpckldq xmm9, xmm8
        movdqa xmm8, xmm7
        punpcklqdq xmm8, xmm5
        movdqa xmm10, xmm8
        shufps xmm10, xmm6, 0xEE
        shufps xmm8, xmm10, 0xC4
        pshufd xmm8, xmm8, 0x78
        punpckhdq xmm5, xmm7
        punpckldq xmm6, xmm5
        pshufd xmm7, xmm6, 0x1E
        movdqa xmm5, xmm9
        movdqa xmm6, xmm8
        jmp @round
    @done:
        pxor xmm0, xmm2
        pxor xmm1, xmm3
        movups xmmword ptr [rdi], xmm0
        movups xmmword ptr [rdi+0x10], xmm1
        ret
    }
    for arm64 {
        reg hptr = x0, mptr = x1, blen = x2, ctr = x3, flg = x4
        reg addr = x9, tmp = x10, rounds = x11

        ld1 {v0.4s}, [hptr]
        add addr, hptr, 16
        ld1 {v1.4s}, [addr]

        addr := 0xBB67
        lsl addr, addr, 16
        tmp := 0xAE85
        add addr, addr, tmp
        lsl addr, addr, 16
        tmp := 0x6A09
        add addr, addr, tmp
        lsl addr, addr, 16
        tmp := 0xE667
        add addr, addr, tmp
        fmov d2, addr

        addr := 0xA54F
        lsl addr, addr, 16
        tmp := 0xF53A
        add addr, addr, tmp
        lsl addr, addr, 16
        tmp := 0x3C6E
        add addr, addr, tmp
        lsl addr, addr, 16
        tmp := 0xF372
        add addr, addr, tmp
        fmov d16, addr
        zip1 v2.2d, v2.2d, v16.2d

        lsl tmp, flg, 32
        add addr, blen, tmp
        fmov d3, ctr
        fmov d16, addr
        zip1 v3.2d, v3.2d, v16.2d

        ld1 {v16.4s}, [mptr]
        add addr, mptr, 16
        ld1 {v17.4s}, [addr]
        add addr, mptr, 32
        ld1 {v18.4s}, [addr]
        add addr, mptr, 48
        ld1 {v19.4s}, [addr]

        uzp1 v4.4s, v16.4s, v17.4s
        uzp2 v5.4s, v16.4s, v17.4s
        uzp1 v20.4s, v18.4s, v19.4s
        ext v6.16b, v20.16b, v20.16b, 12
        uzp2 v21.4s, v18.4s, v19.4s
        ext v7.16b, v21.16b, v21.16b, 12

        rounds := 7
    @round:
        g_neon(v0, v1, v2, v3, v4, v5, v16)
        ext v0.16b, v0.16b, v0.16b, 12
        ext v3.16b, v3.16b, v3.16b, 8
        ext v2.16b, v2.16b, v2.16b, 4
        g_neon(v0, v1, v2, v3, v6, v7, v16)
        ext v0.16b, v0.16b, v0.16b, 4
        ext v3.16b, v3.16b, v3.16b, 8
        ext v2.16b, v2.16b, v2.16b, 12
        sub rounds, rounds, 1
        cmp rounds, 0
        b.eq @done
        permute_msg(v4, v5, v6, v7, v16, v17, v18, v19, v20, v21, v22)
        b @round

    @done:
        eor v0.16b, v0.16b, v2.16b
        eor v1.16b, v1.16b, v3.16b
        st1 {v0.4s}, [hptr]
        add addr, hptr, 16
        st1 {v1.4s}, [addr]
        ret
    }
}

fn copy32(dst: 32 bytes, src: m bytes, m: number)
    requires no_overlap(dst, src)
    requires m <= 32
    ensures dst = cvspec.id_bytes(src)
    trace depends on m
    stack 0
{
    for x86_64 {
        reg d = rdi, s = rsi, n = rdx, i = rcx, a1 = r8, a2 = r9, b = rax
        i := 32
        place {
            name k = i
            fact 0 <= k
            fact k <= 32
            wrote dst[k ..] = cvspec.id_bytes(src)
            decreases k
        }
    @lp:
        cmp i, 0
        je @dn
        sub i, 1
        cmp i, n
        jae @zr
        mov a1, s
        add a1, i
        movzx eax, byte ptr [a1]
        jmp @st
    @zr:
        xor eax, eax
    @st:
        mov a2, d
        add a2, i
        mov byte ptr [a2], al
        jmp @lp
    @dn:
        ret
    }
    for arm64 {
        reg d = x0, s = x1, n = x2, i = x3, a1 = x4, a2 = x5, bw = w6
        i := 32
        place {
            name k = i
            fact 0 <= k
            fact k <= 32
            wrote dst[k ..] = cvspec.id_bytes(src)
            decreases k
        }
    @lp:
        cmp i, 0
        b.eq @dn
        sub i, i, 1
        cmp i, n
        b.hs @zr
        add a1, s, i
        ldrb bw, [a1, 0]
        b @st
    @zr:
        mov x6, 0
    @st:
        add a2, d, i
        strb bw, [a2, 0]
        b @lp
    @dn:
        ret
    }
}

fn node_out(out: cv, nd: cvspec.parent104, extra: byte)
    requires no_overlap(out, nd)
    ensures out = cvspec.parent_val(nd, extra)
    trace depends on nothing
    stack 0
{
    for x86_64 {
        movups xmm0, xmmword ptr [rsi]
        movups xmm1, xmmword ptr [rsi+0x10]
        movups xmmword ptr [rdi], xmm0
        movups xmmword ptr [rdi+0x10], xmm1
        mov r8, qword ptr [rsi + 96]
        or r8, rdx
        mov rdx, 64
        xor ecx, ecx
        add rsi, 32
        jmp compress1
    }
    for arm64 {
        ldr q0, [x1, 0]
        ldr q1, [x1, 16]
        str q0, [x0, 0]
        str q1, [x0, 16]
        ldr x4, [x1, 96]
        orr x4, x4, x2
        mov x2, 64
        mov x3, 0
        add x1, x1, 32
        b compress1
    }
}

fn parent_node(nd: cvspec.parent104, left: m bytes, m: number, right: cv, key: cv, flags: byte)
    requires no_overlap(nd, left, right, key)
    requires m <= 32
    ensures nd = cvspec.parent_nd(key, flags, left, right)
    trace depends on m
    stack 64
{
    for x86_64 {
        push rbx
        push r12
        push r13
        push r14
        sub rsp, 8
        mov rbx, rdi
        mov r12, rcx
        mov r13, r8
        mov r14, r9
        add rdi, 32
        call copy32
        movups xmm0, xmmword ptr [r13]
        movups xmm1, xmmword ptr [r13+0x10]
        movups xmmword ptr [rbx], xmm0
        movups xmmword ptr [rbx+0x10], xmm1
        movups xmm0, xmmword ptr [r12]
        movups xmm1, xmmword ptr [r12+0x10]
        movups xmmword ptr [rbx+0x40], xmm0
        movups xmmword ptr [rbx+0x50], xmm1
        or r14, 4
        mov qword ptr [rbx + 96], r14
        add rsp, 8
        pop r14
        pop r13
        pop r12
        pop rbx
        ret
    }
    for arm64 {
        frame {
            saved: 6 * u64
        }
        sub sp, sp, frame.size
        saved[0] := x30
        saved[1] := x19
        saved[2] := x20
        saved[3] := x21
        saved[4] := x22
        x19 := x0
        x20 := x3
        x21 := x4
        x22 := x5
        add x0, x0, 32
        bl copy32
        ldr q0, [x21, 0]
        ldr q1, [x21, 16]
        str q0, [x19, 0]
        str q1, [x19, 16]
        ldr q0, [x20, 0]
        ldr q1, [x20, 16]
        str q0, [x19, 64]
        str q1, [x19, 80]
        x10 := 4
        orr x22, x22, x10
        str x22, [x19, 96]
        x30 := saved[0]
        x19 := saved[1]
        x20 := saved[2]
        x21 := saved[3]
        x22 := saved[4]
        add sp, sp, frame.size
        ret
    }
}

fn cv_finalize(acc: cv, stack: n bytes, n: number, top: number, kf: b3.keyed, budget: number)
    requires no_overlap(acc, stack, kf)
    requires n >= 32 * top
    requires 1 <= top
    requires top <= 54
    requires budget >= 2
    ensures acc = cvspec.finalize_cv(kf.key, kf.flags, stack, top, acc, budget)
    trace depends on top, budget
    decreases top
    stack 288 + 208 * bits(budget)
{
    for x86_64 {
        push rbx
        push r12
        push r13
        push r14
        push r15
        push rbp
        sub rsp, 144

        mov rbx, rdi
        mov r12, rsi
        mov r13, rdx
        mov r14, rcx
        mov r15, r8
        mov rbp, r9

        movups xmm0, xmmword ptr [rbx]
        movups xmm1, xmmword ptr [rbx+0x10]
        movups xmmword ptr [rsp+0x70], xmm0
        movups xmmword ptr [rsp+0x80], xmm1

        cmp r14, 1
        je @root
        cmp rbp, 4
        jb @root

        mov rdi, rsp
        mov rsi, r14
        sub rsi, 1
        shl rsi, 5
        add rsi, r12
        mov rdx, 32
        mov rcx, rsp
        add rcx, 112
        mov r8, r15
        mov r9, qword ptr [r15 + 32]
        call parent_node

        mov rdi, rbx
        mov rsi, rsp
        xor edx, edx
        call node_out

        mov rdi, rbx
        mov rsi, r12
        mov rdx, r13
        mov rcx, r14
        sub rcx, 1
        mov r8, r15
        mov r9, rbp
        shr r9, 1
        call cv_finalize

        add rsp, 144
        pop rbp
        pop r15
        pop r14
        pop r13
        pop r12
        pop rbx
        ret

    @root:
        mov rdi, rsp
        mov rsi, r12
        mov rdx, 32
        mov rcx, rsp
        add rcx, 112
        mov r8, r15
        mov r9, qword ptr [r15 + 32]
        call parent_node

        mov rdi, rbx
        mov rsi, rsp
        mov rdx, 8
        call node_out

        add rsp, 144
        pop rbp
        pop r15
        pop r14
        pop r13
        pop r12
        pop rbx
        ret
    }
    for arm64 {
        frame {
            nd: 14 * u64
            cur: 4 * u64
            saved: 8 * u64
        }
        reg cvp = x19, stkp = x20, len_r = x21, top_r = x22, kfp = x23, bud = x24

        sub sp, sp, frame.size
        saved[0] := x30
        saved[1] := x19
        saved[2] := x20
        saved[3] := x21
        saved[4] := x22
        saved[5] := x23
        saved[6] := x24

        cvp := x0
        stkp := x1
        len_r := x2
        top_r := x3
        kfp := x4
        bud := x5

        x9 := &cur
        ld1 {v0.4s}, [cvp]
        add x10, cvp, 16
        ld1 {v1.4s}, [x10]
        str q0, [x9, 0]
        str q1, [x9, 16]

        cmp top_r, 1
        b.eq @root
        cmp bud, 4
        b.lo @root

        x0 := &nd
        sub x1, top_r, 1
        lsl x1, x1, 5
        add x1, stkp, x1
        x2 := 32
        x3 := &cur
        x4 := kfp
        ldr x5, [kfp, 32]
        bl parent_node

        x0 := cvp
        x1 := &nd
        x2 := 0
        bl node_out

        x0 := cvp
        x1 := stkp
        x2 := len_r
        sub x3, top_r, 1
        x4 := kfp
        lsr x5, bud, 1
        bl cv_finalize

        x30 := saved[0]
        x19 := saved[1]
        x20 := saved[2]
        x21 := saved[3]
        x22 := saved[4]
        x23 := saved[5]
        x24 := saved[6]
        add sp, sp, frame.size
        ret

    @root:
        x0 := &nd
        x1 := stkp
        x2 := 32
        x3 := &cur
        x4 := kfp
        ldr x5, [kfp, 32]
        bl parent_node

        x0 := cvp
        x1 := &nd
        x2 := 8
        bl node_out

        x30 := saved[0]
        x19 := saved[1]
        x20 := saved[2]
        x21 := saved[3]
        x22 := saved[4]
        x23 := saved[5]
        x24 := saved[6]
        add sp, sp, frame.size
        ret
    }
}
