// The contract of ode_split_block (split.ode). `left_chunks` is ../../../kcheck/blake3.spec's own definition:
// `the greatest power of two k with 1024 * k < len(bytes)`. The contract says where the block lies by that
// definition. Whether 2048 is below the message's length is not said by any one known fact: it follows
// from what the function's division and its comparison of the quotient leave, and the proof shows it.
contract ode_split_block(h: cv, input: len bytes, len: number) {
    requires no_overlap(h, input)
    requires len >= 1025
    requires len <= 4096
    ensures h = compress(h, words(input[1024 * left_chunks(input) - 64 .. 1024 * left_chunks(input)]), counter(0), 64, 0)
    stack 64
    needs sse41
}
