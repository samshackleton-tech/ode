// RFC 1035 DNS Wire-Format Header, Domain Name, Compression Pointer, and RR Validators
// in 100% pure High-Level Ode (zero raw assembly).
// Portable across x86-64 and AArch64; dual-verified (`--verifier both`) with identical
// 52-character BLAKE3-256 contract identifiers across both processors.

// ---------------------------------------------------------------------------
// 1. RFC 1035 §2.3.3 Case-Insensitive ASCII DNS Label Comparison
//    Folds 'A'..'Z' (65..90) to 'a'..'z' (97..122). Returns 1 iff equal, 0 otherwise.
// ---------------------------------------------------------------------------
def ascii_lower(c) {
    if c >= 65 && c <= 90 then c + 32 else c
}

def label_eq_from(a, b, i) {
    if i >= len(a) then 1
    else if ascii_lower(a[i]) != ascii_lower(b[i]) then 0
    else label_eq_from(a, b, i + 1)
}

fn dns_label_eq_ci(a: n bytes, b: n bytes, n: number)
    returns label_eq_from(a, b, 0)
    trace depends on a, b, n
    stack 0
{
    for i in 0..n
        maintains label_eq_from(a, b, i) == label_eq_from(a, b, 0)
    {
        var ca: u64 := a[i]
        if ca >= 65 {
            if ca <= 90 { ca += 32 }
        }
        join maintains ca == ascii_lower(a[i])
        var cb: u64 := b[i]
        if cb >= 65 {
            if cb <= 90 { cb += 32 }
        }
        join
            maintains ca == ascii_lower(a[i])
            maintains cb == ascii_lower(b[i])
        if ca != cb { return 0 }
    }
    return 1
}

// ---------------------------------------------------------------------------
// 2. RFC 1035 §4.1.1 12-Byte DNS Header Validator
//    Rejects packets < 12 bytes or with reserved Z bit (byte 3, bit 6) set.
//    Returns (QR << 24) + (OPCODE << 20) + (RCODE << 16) + QDCOUNT, or 0xFFFFFFFF.
// ---------------------------------------------------------------------------
def dns_hdr_of(pkt) {
    if len(pkt) < 12 then 4294967295
    else if (pkt[3] / 64) % 2 != 0 then 4294967295
    else (pkt[2] / 128) * 16777216
       + ((pkt[2] / 8) % 16) * 1048576
       + (pkt[3] % 16) * 65536
       + pkt[4] * 256 + pkt[5]
}

fn dns_hdr_valid(pkt: n bytes, n: number)
    returns dns_hdr_of(pkt)
    trace depends on pkt, n
    stack 0
{
    let one: u64 := 1
    if n < 12 { return (one << 32) - 1 }
    let b3: u64 := pkt[3]
    if ((b3 >> 6) & 1) != 0 { return (one << 32) - 1 }
    let b2: u64 := pkt[2]
    let qr: u64 := b2 >> 7
    let opcode: u64 := (b2 >> 3) & 15
    let rcode: u64 := b3 & 15
    let qdhi: u64 := pkt[4]
    let qdlo: u64 := pkt[5]
    let qdcount: u64 := (qdhi << 8) + qdlo
    return (qr << 24) + (opcode << 20) + (rcode << 16) + qdcount
}

// ---------------------------------------------------------------------------
// 3. RFC 1035 §4.1.4 Wire-Format DNS Name Scanner (strictly backward pointers)
//    Validates labels (1..63), rejects reserved tags (64..191), checks packet bounds
//    and <= 255 wire length, rejects forward/self compression pointers (ptr >= pos).
//    Returns exact wire bytes consumed (>= 1), or 0 if malformed.
// ---------------------------------------------------------------------------
def name_wire_step(pkt, off, pos) {
    if pos >= len(pkt) then 0
    else if pkt[pos] == 0 then
        if pos + 1 - off > 255 then 0 else pos + 1 - off
    else if pkt[pos] <= 63 then
        if pos + 1 + pkt[pos] > len(pkt) then 0
        else if pos + 1 + pkt[pos] - off > 254 then 0
        else name_wire_step(pkt, off, pos + 1 + pkt[pos])
    else if pkt[pos] >= 192 then
        if pos + 2 > len(pkt) then 0
        else if (pkt[pos] - 192) * 256 + pkt[pos + 1] >= pos then 0
        else pos + 2 - off
    else 0
}

def name_wire_len(pkt, off) {
    name_wire_step(pkt, off, off)
}

fn dns_name_wire_len(pkt: n bytes, n: number, off: number)
    requires off <= n
    requires n <= 65535
    returns name_wire_len(pkt, off)
    trace depends on pkt, n, off
    stack 0
{
    var pos: u64 := off
    while pos < n
        maintains off <= pos
        maintains pos <= n
        maintains pos - off <= 254
        maintains name_wire_step(pkt, off, pos) == name_wire_len(pkt, off)
        decreases n - pos
    {
        let tag: u64 := pkt[pos]
        if tag == 0 {
            return pos + 1 - off
        }
        if tag <= 63 {
            let next_pos: u64 := pos + 1 + tag
            if next_pos > n { return 0 }
            if next_pos - off > 254 { return 0 }
            pos := next_pos
        } else if tag >= 192 {
            if pos + 2 > n { return 0 }
            let lo: u64 := pkt[pos + 1]
            let ptr: u64 := ((tag - 192) << 8) + lo
            if ptr >= pos { return 0 }
            return pos + 2 - off
        } else {
            return 0
        }
    }
    return 0
}

// ---------------------------------------------------------------------------
// 4. RFC 1035 §4.1.4 Compression-Pointer-Following DNS Name Expansion Validator
//    Follows strictly backward compression pointers (`ptr < bound`, `bound := ptr`),
//    proving acyclicity & termination via `bound * 256 + (255 - out_len)`.
//    Enforces RFC 1035 §2.3.4 total expanded wire length <= 255.
//    Returns expanded wire length (1..255), or 0 if malformed/cyclic/overlong.
// ---------------------------------------------------------------------------
def name_expand_step(pkt, pos, bound, olen) {
    if pos >= len(pkt) then 0
    else if pkt[pos] == 0 then
        if olen + 1 > 255 then 0 else olen + 1
    else if pkt[pos] <= 63 then
        if pos + 1 + pkt[pos] > len(pkt) then 0
        else if olen + 1 + pkt[pos] > 254 then 0
        else name_expand_step(pkt, pos + 1 + pkt[pos], bound, olen + 1 + pkt[pos])
    else if pkt[pos] >= 192 then
        if pos + 2 > len(pkt) then 0
        else if (pkt[pos] - 192) * 256 + pkt[pos + 1] >= bound then 0
        else name_expand_step(pkt, (pkt[pos] - 192) * 256 + pkt[pos + 1],
                              (pkt[pos] - 192) * 256 + pkt[pos + 1], olen)
    else 0
}

def name_expand_len(pkt, off) {
    name_expand_step(pkt, off, off, 0)
}

fn dns_name_expand_len(pkt: n bytes, n: number, off: number)
    requires off <= n
    requires n <= 65535
    returns name_expand_len(pkt, off)
    trace depends on pkt, n, off
    stack 16
{
    var pos: u64 := off
    var bound: u64 := off
    var olen: u64 := 0
    while pos < n
        maintains pos <= n
        maintains bound <= n
        maintains olen <= 254
        maintains name_expand_step(pkt, pos, bound, olen) == name_expand_len(pkt, off)
        decreases bound * 256 + (255 - olen)
    {
        let tag: u64 := pkt[pos]
        if tag == 0 {
            if olen >= 255 { return 0 }
            return olen + 1
        }
        if tag <= 63 {
            let next_pos: u64 := pos + 1 + tag
            if next_pos > n { return 0 }
            let next_olen: u64 := olen + 1 + tag
            if next_olen > 254 { return 0 }
            pos := next_pos
            olen := next_olen
        } else if tag >= 192 {
            if pos + 2 > n { return 0 }
            let lo: u64 := pkt[pos + 1]
            let ptr: u64 := ((tag - 192) << 8) + lo
            if ptr >= bound { return 0 }
            pos := ptr
            bound := ptr
        } else {
            return 0
        }
    }
    return 0
}

// ---------------------------------------------------------------------------
// 5. RFC 1035 §4.1.3 Resource Record (RR) Bounds-Checked Parser
//    Calls verified `dns_name_wire_len` for the owner NAME, validates the 10-byte
//    fixed header (TYPE, CLASS, TTL, RDLENGTH) and RDATA length within `pkt[0..n)`.
//    Returns exact offset of the next RR, or 0 if malformed/truncated.
// ---------------------------------------------------------------------------
def rr_next_from(pkt, off, nlen) {
    if nlen == 0 then 0
    else if off + nlen + 10 > len(pkt) then 0
    else if off + nlen + 10 + (pkt[off + nlen + 8] * 256 + pkt[off + nlen + 9]) > len(pkt) then 0
    else off + nlen + 10 + (pkt[off + nlen + 8] * 256 + pkt[off + nlen + 9])
}

def rr_next(pkt, off) {
    rr_next_from(pkt, off, name_wire_len(pkt, off))
}

fn dns_rr_next(pkt: n bytes, n: number, off: number)
    requires off <= n
    requires n <= 65535
    returns rr_next(pkt, off)
    trace depends on pkt, n, off
    stack 64
{
    let nlen: u64 := dns_name_wire_len(pkt, n, off)
    if nlen == 0 { return 0 }
    if nlen > n { return 0 }
    let hdr: u64 := off + nlen
    if hdr + 10 > n { return 0 }
    let rdhi: u64 := pkt[hdr + 8]
    let rdlo: u64 := pkt[hdr + 9]
    let rdlen: u64 := (rdhi << 8) + rdlo
    let end_off: u64 := hdr + 10 + rdlen
    if end_off > n { return 0 }
    return end_off
}
