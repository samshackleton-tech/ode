// A parent of two blocks, with its block of 64 bytes in the stack frame. Each of the two blocks is
// compressed from a chaining value of zeros that lies in a half of the frame's block: the kernel reads and
// writes that half. Then the frame's block, now the two values, is compressed into `out`: the kernel reads it.
// parent(out, a, b): arguments in rdi, rsi, rdx, as C passes them. Saved and restored: rbx, rbp, r12.
//   Kept: out in rbx, a in rbp, b in r12. Buffer: blk at [rsp + 0], 64 bytes. Frame: 64 bytes.
fn parent as "ode_parent" {
  push rbx
  push rbp
  push r12
  sub rsp, 64
  mov rbx, rdi
  mov rbp, rsi
  mov r12, rdx
  mov rax, 0
  mov qword ptr [rsp + 0], rax
  mov qword ptr [rsp + 8], rax
  mov qword ptr [rsp + 16], rax
  mov qword ptr [rsp + 24], rax
  mov qword ptr [rsp + 32], rax
  mov qword ptr [rsp + 40], rax
  mov qword ptr [rsp + 48], rax
  mov qword ptr [rsp + 56], rax
  lea rdi, [rsp + 0]
  mov rsi, rbp
  mov rdx, 64
  mov rcx, 0
  mov r8, 0
  call blake3_servil_compress_in_place_sse41
  lea rdi, [rsp + 32]
  mov rsi, r12
  mov rdx, 64
  mov rcx, 0
  mov r8, 0
  call blake3_servil_compress_in_place_sse41
  mov rdi, rbx
  lea rsi, [rsp + 0]
  mov rdx, 64
  mov rcx, 0
  mov r8, 0
  call blake3_servil_compress_in_place_sse41
  add rsp, 64
  pop r12
  pop rbp
  pop rbx
  ret
}
