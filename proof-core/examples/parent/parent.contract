// The contract of ode_parent (parent.ode). The block of the two values is no argument: the function keeps
// it in its stack frame, and the kernel it calls writes there.
def zero_cv() { [word(0) for i in 0..8] }

contract ode_parent(out: cv, a: block, b: block) {
    requires disjoint(out, a, b, 1)
    ensures out = compress(out, compress(zero_cv(), a, counter(0), 64, 0) ++ compress(zero_cv(), b, counter(0), 64, 0), counter(0), 64, 0)
    stack 96
    needs sse41
}
