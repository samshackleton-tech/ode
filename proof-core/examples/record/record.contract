// The contract of ode_absorb (record.ode). The record's tag is as it was; its chaining value becomes the
// compression of the old one with the block m, compressed again with the block m2, as
// ../../../kcheck/blake3.spec defines `compress`. There is no `trace` line: the function reads no byte of
// the record or of the blocks itself.
layout tagged 64 { tag: cv at 0, h: cv at 32 }

contract ode_absorb(r: tagged, m: block, m2: block) {
    requires no_overlap(r, m, m2)
    ensures r = {tag: r.tag, h: compress(compress(r.h, m, counter(0), 64, 0), m2, counter(0), 64, 0)}
    stack 32
    needs sse41
}
