// The contract of ode_left_block (left.ode). `left_chunks` is ../../../kcheck/blake3.spec's own definition:
// `the greatest power of two k with 1024 * k < len(bytes)`. The contract says where the block lies by
// that definition, and the verifier in Lean works the definition out: with 2049 to 4096 bytes, each of
// the sixty-four powers of two is seen at once, by one of the two `requires`, to be too great or not.
contract ode_left_block(h: cv, input: len bytes, len: number) {
    requires disjoint(h, input, 1)
    requires len >= 2049
    requires len <= 4096
    ensures h = compress(h, words(input[1024 * left_chunks(input) - 64 .. 1024 * left_chunks(input)]), counter(0), 64, 0)
    stack 64
    needs sse41
}
