// The parent of two parents, by the hash's 16-way kernel. A parent node's value is one compression of a block
// from the key. The kernel compresses sixteen blocks at once: it is given a table of sixteen addresses and
// writes sixteen values, 32 bytes each. Here the table and the values are in this function's stack frame.
// First round: lane 0 reads the block `a`, lane 1 the block `b` (the fourteen lanes left read `a` again, and
// what they leave is not used). Second round: every lane reads the first 64 bytes of what the first round
// left, which are the values of `a` and of `b` side by side. `out` becomes the first value of the second
// round. The hash's upper functions make a tree's parents in this way, a level at a time.
// quad(out, a, b, kf): arguments in rdi, rsi, rdx, rcx, as C passes them. Saved and restored: rbx, r12.
// Kept: out in rbx, kf in r12. In the frame: the table at [rsp + 0], the first round's values at
// [rsp + 128], the second round's at [rsp + 640]. Frame: 1160 bytes.
fn quad as "ode_quad" {
  push rbx
  push r12
  sub rsp, 1160
  mov rbx, rdi
  mov r12, rcx
  // the table: lane 0 reads a, lane 1 reads b, the other lanes read a
  mov rax, rsi
  mov qword ptr [rsp + 0], rax
  mov rax, rdx
  mov qword ptr [rsp + 8], rax
  mov rax, rsi
  mov qword ptr [rsp + 16], rax
  mov rax, rsi
  mov qword ptr [rsp + 24], rax
  mov rax, rsi
  mov qword ptr [rsp + 32], rax
  mov rax, rsi
  mov qword ptr [rsp + 40], rax
  mov rax, rsi
  mov qword ptr [rsp + 48], rax
  mov rax, rsi
  mov qword ptr [rsp + 56], rax
  mov rax, rsi
  mov qword ptr [rsp + 64], rax
  mov rax, rsi
  mov qword ptr [rsp + 72], rax
  mov rax, rsi
  mov qword ptr [rsp + 80], rax
  mov rax, rsi
  mov qword ptr [rsp + 88], rax
  mov rax, rsi
  mov qword ptr [rsp + 96], rax
  mov rax, rsi
  mov qword ptr [rsp + 104], rax
  mov rax, rsi
  mov qword ptr [rsp + 112], rax
  mov rax, rsi
  mov qword ptr [rsp + 120], rax
  // packed = flags | 0x40000004: the flags and PARENT in the low byte; no flag of a chunk's first or last block;
  // 64 bytes a block
  mov rax, qword ptr [r12 + 32]
  or rax, 1073741828
  mov r8, rax
  // p16(table, 1, key, 0, packed, values)
  lea rdi, [rsp + 0]
  mov rsi, 1
  mov rdx, r12
  mov rcx, 0
  lea r9, [rsp + 128]
  call blake3_servil_avx512_p16
  // the table: every lane reads the two values the first round left first
  lea rax, [rsp + 128]
  mov qword ptr [rsp + 0], rax
  mov qword ptr [rsp + 8], rax
  mov qword ptr [rsp + 16], rax
  mov qword ptr [rsp + 24], rax
  mov qword ptr [rsp + 32], rax
  mov qword ptr [rsp + 40], rax
  mov qword ptr [rsp + 48], rax
  mov qword ptr [rsp + 56], rax
  mov qword ptr [rsp + 64], rax
  mov qword ptr [rsp + 72], rax
  mov qword ptr [rsp + 80], rax
  mov qword ptr [rsp + 88], rax
  mov qword ptr [rsp + 96], rax
  mov qword ptr [rsp + 104], rax
  mov qword ptr [rsp + 112], rax
  mov qword ptr [rsp + 120], rax
  // packed = flags | 0x40000004: the flags and PARENT in the low byte; no flag of a chunk's first or last block;
  // 64 bytes a block
  mov rax, qword ptr [r12 + 32]
  or rax, 1073741828
  mov r8, rax
  // p16(table, 1, key, 0, packed, values)
  lea rdi, [rsp + 0]
  mov rsi, 1
  mov rdx, r12
  mov rcx, 0
  lea r9, [rsp + 640]
  call blake3_servil_avx512_p16
  // out = the first value of the second round
  mov rax, qword ptr [rsp + 640]
  mov qword ptr [rbx + 0], rax
  mov rax, qword ptr [rsp + 648]
  mov qword ptr [rbx + 8], rax
  mov rax, qword ptr [rsp + 656]
  mov qword ptr [rbx + 16], rax
  mov rax, qword ptr [rsp + 664]
  mov qword ptr [rbx + 24], rax
  // rax held bytes of the value: it is set to zero, so that it shows nothing of the blocks
  mov rax, 0
  add rsp, 1160
  pop r12
  pop rbx
  ret
}
