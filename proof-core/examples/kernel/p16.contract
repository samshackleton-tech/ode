// The 16-way AVX-512 kernel of the hash (the function is in ../../../kcheck/b3hashr.o): sixteen chunks at
// once, each of n blocks, every lane with the same counter. As in ../../../kcheck/proofs/inner.spec the
// trace depends on n and on nothing else that is given: which instructions run and which addresses are
// touched depend on no byte of the blocks or of the key, and not on the counter or on the four bytes of
// `packed`. (The addresses the table `inputs` holds are read as addresses, so they show: a table is never
// hidden.)
contract blake3_servil_avx512_p16(inputs: 16 inputs, n: number, key: cv, t: counter, packed: bytes flags start end length, out: 16 cvs) {
    requires n >= 1
    requires disjoint(inputs, key, out, 1)
    ensures out[i] = chunk(key, t, flags, start, end, length, n, inputs[i]) for i in 0..16
    trace depends on n
    stack 4096
    needs avx512
}
