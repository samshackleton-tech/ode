// The one-block kernel of the hash for processors with SSE4.1 and no more (the function is in
// ../../../kcheck/b3hashr.o). As for the other kernel (kernel.contract), its contract in
// ../../../kcheck/proofs/inner.spec has no `trace` line, and the account in Lean says nothing of the trace
// yet. `length: word`: the caller keeps the length below 2^32. `flags: low word`: the low 32 bits of the
// flags' register are read, the rest being anything.
contract blake3_servil_compress_in_place_sse41(h: cv, m: block, length: word, t: counter, flags: low word) {
    requires no_overlap(h, m)
    ensures h = compress(h, m, t, length, flags)
    stack 0
    needs sse41
    trace depends on h, m
}
