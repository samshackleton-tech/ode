// The loops of ode_adler32_blocks4 (../../../kcheck/programs/adler32/odeadler32.o), for the prover of the
// verifier in Lean. As ode_adler32_blocks, with the bytes of a block taken four at a turn while four are
// left, and then one at a turn: three places, the two inside a block saying the same.
place +0x3c {
    name i = r12
    name a = r13
    name b = r14
    fact i <= len
    fact a <= 65520
    fact b <= 65520
    fact a == s1(input)[i]
    fact b == s2(input)[i]
    decreases len - i
}
place +0x6f {
    name i = r12
    name a = r13
    name b = r14
    name end = r15
    keep r15
    fact i <= end
    fact end <= len
    fact a + 255 * (end - i) <= 1481280
    fact b + 1481280 * (end - i) <= 8224132080
    fact a % 65521 == s1(input)[i]
    fact b % 65521 == s2(input)[i]
    decreases end - i
}
place +0x10c {
    name i = r12
    name a = r13
    name b = r14
    name end = r15
    keep r15
    fact i <= end
    fact end <= len
    fact a + 255 * (end - i) <= 1481280
    fact b + 1481280 * (end - i) <= 8224132080
    fact a % 65521 == s1(input)[i]
    fact b % 65521 == s2(input)[i]
    decreases end - i
}
