// The loop of ode_adler32 (../../../kcheck/programs/adler32/odeadler32.o), for the prover of the verifier in
// Lean: whenever the code comes to the place, with i bytes taken, the two sums are those of the
// specification's two sequences at place i, and each is below 65521.
place +0x2c {
    name i = r14
    name a = r12
    name b = r13
    fact i <= len
    fact a <= 65520
    fact b <= 65520
    fact a == s1(input)[i]
    fact b == s2(input)[i]
    decreases len - i
}
