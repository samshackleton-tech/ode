// The loops of ode_adler32_blocks (../../../kcheck/programs/adler32/odeadler32.o), for the prover of the
// verifier in Lean. The function takes the bytes in blocks of at most 5552 and reduces the two sums once a
// block. At the head of the loop over the blocks the sums are the specification's. Within a block (the
// second place) they are only the same as the specification's by 65521, and bounded by how far the block has
// still to go; the block's end is what it was when the block was begun.
place +0x3c {
    name i = r12
    name a = r13
    name b = r14
    fact i <= len
    fact a <= 65520
    fact b <= 65520
    fact a == s1(input)[i]
    fact b == s2(input)[i]
    decreases len - i
}
place +0x6f {
    name i = r12
    name a = r13
    name b = r14
    name end = r15
    keep r15
    fact i <= end
    fact end <= len
    fact a + 255 * (end - i) <= 1481280
    fact b + 1481280 * (end - i) <= 8224132080
    fact a % 65521 == s1(input)[i]
    fact b % 65521 == s2(input)[i]
    decreases end - i
}
