// One-block BLAKE3 compression for AArch64 NEON (unified `.ode` with linked local namespace).
use b3 = "blake3_spec.ode"

// BLAKE3 one-block NEON compression kernel on AArch64, written in higher-level Ode.
// Verified in Lean 4 directly against kcheck/blake3.spec's `compress(h, m, t, length, flags)`:
// zero stack, zero read-only data (the four IV words are built in registers), zero callee-saved
// vector registers touched, and constant-time (no `trace depends on` clause).
//
// Arguments: (h, m, length, t, flags) in (x0, x1, x2, x3, x4).
// Writes the eight 32-bit words of compress(h, m, t, length, flags) back to h[0..32].
// Half of a BLAKE3 round across four 32-bit NEON lanes: mixes (a, b, c, d) with message words (mx, my).
inline fn g_neon for arm64 (a: vec, b: vec, c: vec, d: vec, mx: vec, my: vec, t: vec) distinct(a, b, c, d, mx, my, t) changes a, b, c, d, t {
  add a.4s, a.4s, mx.4s
  add a.4s, a.4s, b.4s
  eor d.16b, d.16b, a.16b
  rev32 d.8h, d.8h
  add c.4s, c.4s, d.4s
  eor b.16b, b.16b, c.16b
  ushr t.4s, b.4s, 12
  shl b.4s, b.4s, 20
  orr b.16b, b.16b, t.16b
  add a.4s, a.4s, my.4s
  add a.4s, a.4s, b.4s
  eor d.16b, d.16b, a.16b
  ushr t.4s, d.4s, 8
  shl d.4s, d.4s, 24
  orr d.16b, d.16b, t.16b
  add c.4s, c.4s, d.4s
  eor b.16b, b.16b, c.16b
  ushr t.4s, b.4s, 7
  shl b.4s, b.4s, 25
  orr b.16b, b.16b, t.16b
}

// In-register BLAKE3 message schedule permutation on packed (m0, m1, m2, m3) using 14 NEON ops
// and zero vector copies, touching only caller-saved temporaries t0..t6.
inline fn permute_msg for arm64 (m0: vec, m1: vec, m2: vec, m3: vec, t0: vec, t1: vec, t2: vec, t3: vec, t4: vec, t5: vec, t6: vec) distinct(m0, m1, m2, m3, t0, t1, t2, t3, t4, t5, t6) changes m0, m1, m2, m3, t0, t1, t2, t3, t4, t5, t6 {
  uzp2 t0.4s, m1.4s, m0.4s
  zip1 t1.2d, m0.2d, t0.2d
  ext t2.16b, m0.16b, m0.16b, 8
  ext t3.16b, m2.16b, m0.16b, 4
  uzp2 t4.4s, m0.4s, t3.4s
  ext t5.16b, m3.16b, m0.16b, 12
  ext m0.16b, t1.16b, t2.16b, 4
  uzp1 t0.4s, m3.4s, m1.4s
  ext t1.16b, m2.16b, m3.16b, 12
  zip2 t2.4s, m1.4s, m3.4s
  zip1 t3.2d, m2.2d, t2.2d
  ext t6.16b, m1.16b, m2.16b, 4
  ext m1.16b, t4.16b, t5.16b, 4
  uzp1 m2.4s, t0.4s, t1.4s
  uzp2 m3.4s, t3.4s, t6.4s
}

fn compress1(h: cv, m: block, length: word, t: counter, flags: low word)
    requires no_overlap(h, m)
    ensures h = b3.compress(h, m, t, length, flags)
    stack 0
{
    for arm64 {
          budget {
            max_bytes 512
            max_icache_lines 8
            max_frame_bytes 0
            max_line_splits 0
            max_stlf_partial 0
          }
          reg hptr = x0
          reg mptr = x1
          reg blen = x2
          reg ctr = x3
          reg flg = x4
          reg addr = x9
          reg tmp = x10
          reg rounds = x11

          // Load chaining value h[0..7] into rows v0 and v1.
          ld1 {v0.4s}, [hptr]
          add addr, hptr, 16
          ld1 {v1.4s}, [addr]

          // Build row v2 = [IV[0], IV[1], IV[2], IV[3]] in registers (no read-only data load).
          addr := 0xBB67
          lsl addr, addr, 16
          tmp := 0xAE85
          add addr, addr, tmp
          lsl addr, addr, 16
          tmp := 0x6A09
          add addr, addr, tmp
          lsl addr, addr, 16
          tmp := 0xE667
          add addr, addr, tmp
          fmov d2, addr

          addr := 0xA54F
          lsl addr, addr, 16
          tmp := 0xF53A
          add addr, addr, tmp
          lsl addr, addr, 16
          tmp := 0x3C6E
          add addr, addr, tmp
          lsl addr, addr, 16
          tmp := 0xF372
          add addr, addr, tmp
          fmov d16, addr
          zip1 v2.2d, v2.2d, v16.2d

          // Build row v3 = [lo(t), hi(t), word(length), word(flags)].
          lsl tmp, flg, 32
          add addr, blen, tmp
          fmov d3, ctr
          fmov d16, addr
          zip1 v3.2d, v3.2d, v16.2d

          // Load message block m[0..15] and pack into column/diagonal message vectors v4..v7.
          ld1 {v16.4s}, [mptr]
          add addr, mptr, 16
          ld1 {v17.4s}, [addr]
          add addr, mptr, 32
          ld1 {v18.4s}, [addr]
          add addr, mptr, 48
          ld1 {v19.4s}, [addr]

          uzp1 v4.4s, v16.4s, v17.4s
          uzp2 v5.4s, v16.4s, v17.4s
          uzp1 v20.4s, v18.4s, v19.4s
          ext v6.16b, v20.16b, v20.16b, 12
          uzp2 v21.4s, v18.4s, v19.4s
          ext v7.16b, v21.16b, v21.16b, 12

          rounds := 7
        @round:
          g_neon(v0, v1, v2, v3, v4, v5, v16)
          ext v0.16b, v0.16b, v0.16b, 12
          ext v3.16b, v3.16b, v3.16b, 8
          ext v2.16b, v2.16b, v2.16b, 4
          g_neon(v0, v1, v2, v3, v6, v7, v16)
          ext v0.16b, v0.16b, v0.16b, 4
          ext v3.16b, v3.16b, v3.16b, 8
          ext v2.16b, v2.16b, v2.16b, 12
          sub rounds, rounds, 1
          cmp rounds, 0
          b.eq @done
          permute_msg(v4, v5, v6, v7, v16, v17, v18, v19, v20, v21, v22)
          b @round

        @done:
          eor v0.16b, v0.16b, v2.16b
          eor v1.16b, v1.16b, v3.16b
          st1 {v0.4s}, [hptr]
          add addr, hptr, 16
          st1 {v1.4s}, [addr]
          ret
    }
}
