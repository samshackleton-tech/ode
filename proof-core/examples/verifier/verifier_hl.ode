// Verifier-in-Ode Stage 2: core Arithmetic.lean, Core.lean (`plain`), and Reader.lean kernels
// written in 100% pure High-Level Ode, dual-verified (`--verifier both`) on x86-64 and AArch64.

use ints = "raeybpdavam7upiziaktzghulvfgv6er54pcn6xjgiq7uuoc6kvq"  // std/int.ode

const PARSE_ERR = 1152921504606846976
const PARSE_MAX_ACC = 72057594037927936

def all_zero_from(a, at) {
    if at >= len(a) then 1
    else if a[at] != 0 then 0
    else all_zero_from(a, at + 1)
}

def row_contradicts(a, pos, neg) {
    if pos < neg then all_zero_from(a, 0)
    else 0
}

def eq_from(a, b, at) {
    if at >= len(a) then 1
    else if a[at] != b[at] then 0
    else eq_from(a, b, at + 1)
}

def bytes_eq(a, b) { eq_from(a, b, 0) }

def plain_match(fv, gv, fc, gc) {
    if fc <= gc then bytes_eq(fv, gv)
    else 0
}

def step_ok(i, a, j, b, d, n_rows) {
    if i < n_rows && j < n_rows && a > 0 && b > 0 && d > 0 then 1
    else 0
}

def parse_from(buf, i, acc) {
    if i >= len(buf) then acc
    else if buf[i] < 48 || buf[i] > 57 then PARSE_ERR
    else if acc >= PARSE_MAX_ACC then PARSE_ERR
    else parse_from(buf, i + 1, acc * 10 + (buf[i] - 48))
}

def parse_u64(buf) {
    if len(buf) == 0 then PARSE_ERR
    else parse_from(buf, 0, 0)
}

// `Reader.lean` proof-line keyword classifier:
//   1 = "r", 2 = "s", 3 = "q", 4 = "t", 5 = "k", 6 = "for", 7 = "place", 0 = unknown.
def tag_kind(buf) {
    if len(buf) == 1 then
        if buf[0] == 114 then 1
        else if buf[0] == 115 then 2
        else if buf[0] == 113 then 3
        else if buf[0] == 116 then 4
        else if buf[0] == 107 then 5
        else 0
    else if len(buf) == 3 && buf[0] == 102 && buf[1] == 111 && buf[2] == 114 then 6
    else if len(buf) == 5 && buf[0] == 112 && buf[1] == 108 && buf[2] == 97 && buf[3] == 99 && buf[4] == 101 then 7
    else 0
}

def sum16(a, b) { [a[i] + b[i] for i in 0..16] }

// 1. `Arithmetic.allZero`: 1 iff every coefficient byte in `coeffs[0..n)` is zero.
fn v_all_zero(coeffs: n bytes, n: number)
    returns all_zero_from(coeffs, 0)
    trace depends on coeffs, n
    stack 0
{
    for i in 0..n
        maintains all_zero_from(coeffs, 0) == all_zero_from(coeffs, i)
    {
        if coeffs[i] != 0 { return 0 }
    }
    return 1
}

// 2. `Arithmetic.verify` base case: 1 iff constant `pos - neg < 0` and all coefficients are zero.
//    Verified tail call to `v_all_zero` (zero stack frame).
fn v_row_contradicts(coeffs: n bytes, n: number, pos: number, neg: number)
    returns row_contradicts(coeffs, pos, neg)
    trace depends on coeffs, n, pos, neg
    stack 0
{
    if pos >= neg { return 0 }
    return v_all_zero(coeffs, n)
}

// 3. `Reader` / `Arithmetic.among`: exact byte-slice equality.
fn v_bytes_eq(a: n bytes, b: n bytes, n: number)
    returns bytes_eq(a, b)
    trace depends on a, b, n
    stack 0
{
    for i in 0..n
        maintains bytes_eq(a, b) == eq_from(a, b, i)
    {
        if a[i] != b[i] { return 0 }
    }
    return 1
}

// 4. `Core.plain`: 1 iff `fact_c <= goal_c` and variable-coefficient vectors match byte-for-byte.
//    Verified tail call to `v_bytes_eq` (zero stack frame).
fn v_plain_match(fact_v: n bytes, goal_v: n bytes, n: number, fact_c: number, goal_c: number)
    returns plain_match(fact_v, goal_v, fact_c, goal_c)
    trace depends on fact_v, goal_v, n, fact_c, goal_c
    stack 0
{
    if fact_c > goal_c { return 0 }
    return v_bytes_eq(fact_v, goal_v, n)
}

// 5. `Arithmetic.derive` step guard: indices in bounds and multipliers/divisor strictly positive.
fn v_step_ok(i: number, a: number, j: number, b: number, d: number, n_rows: number)
    returns step_ok(i, a, j, b, d, n_rows)
    trace depends on i, a, j, b, d, n_rows
    stack 0
{
    if i >= n_rows { return 0 }
    if j >= n_rows { return 0 }
    if a == 0 { return 0 }
    if b == 0 { return 0 }
    if d == 0 { return 0 }
    return 1
}

// 6. `Reader` strict unsigned decimal integer parser (up to 10 * 2^56 - 1; rejects empty/non-digit/overflow).
fn v_parse_u64(buf: n bytes, n: number)
    returns parse_u64(buf)
    trace depends on buf, n
    stack 0
{
    let one: u64 := 1
    let err: u64 := one << 60
    if n == 0 { return err }
    let max_acc: u64 := one << 56
    var acc: u64 := 0
    for i in 0..n
        maintains acc < 1152921504606846976
        maintains parse_u64(buf) == parse_from(buf, i, acc)
    {
        let c: u64 := buf[i]
        if c < 48 { return err }
        if c > 57 { return err }
        if acc >= max_acc { return err }
        let d: u64 := c - 48
        acc := ints.mul_const(acc, 10) + d
    }
    return acc
}

// 7. `Reader.lean` proof-line keyword classifier (`r`, `s`, `q`, `t`, `k`, `for`, `place`).
fn v_tag_kind(buf: n bytes, n: number)
    returns tag_kind(buf)
    trace depends on buf, n
    stack 0
{
    if n == 1 {
        let c: u64 := buf[0]
        if c == 114 { return 1 }
        if c == 115 { return 2 }
        if c == 113 { return 3 }
        if c == 116 { return 4 }
        if c == 107 { return 5 }
        return 0
    }
    if n == 3 {
        if buf[0] == 102 && buf[1] == 111 && buf[2] == 114 { return 6 }
        return 0
    }
    if n == 5 {
        if buf[0] == 112 && buf[1] == 108 && buf[2] == 97 && buf[3] == 99 && buf[4] == 101 { return 7 }
        return 0
    }
    return 0
}

// 8. `Arithmetic.sum` on 16-word (64-byte cache-line-aligned) coefficient rows.
fn v_row_sum16(out: 64 bytes, a: 64 bytes, b: 64 bytes)
    requires no_overlap(out, a, b)
    requires aligned(out, 64), aligned(a, 64), aligned(b, 64)
    ensures out = bytes_of(sum16(words(a), words(b)))
    stack 0
{
    for x86_64 needs avx needs avx512 {
        out.u32x16(0) := a.u32x16(0) +% b.u32x16(0)
    }
    for arm64 {
        for k in 0..4 unroll {
            out.u32x4(k * 16) := a.u32x4(k * 16) +% b.u32x4(k * 16)
        }
    }
}
