for ode_lz4_ext_len
place 14
name i rcx
name a rdx
fact (bin <= (num 0) (name i))
fact (bin <= (name i) (name n))
fact (bin == (name a) (bin + (num 15) (bin * (num 255) (name i))))
fact (bin == (call lz4_len_from (name buf) (num 0) (num 15)) (call lz4_len_from (name buf) (name i) (name a)))
keep rax rbx rsp rbp rsi rdi r10 r11 r12 r13 r14 r15
decreases (bin - (name n) (name i))
