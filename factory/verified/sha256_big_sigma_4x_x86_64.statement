fn ode_sha256_big_sigma_4x
i 0 4 .xloadu 0 .rsi 0x0
i 4 8 .xloadu 1 .rdx 0x0
i 8 13 .xpsrld 2 0 2
i 13 18 .xpslld 3 0 30
i 18 22 .xpor 2 2 3
i 22 27 .xpsrld 3 0 13
i 27 32 .xpslld 4 0 19
i 32 36 .xpor 3 3 4
i 36 41 .xpsrld 4 0 22
i 41 46 .xpslld 5 0 10
i 46 50 .xpor 4 4 5
i 50 54 .xpxor 2 2 3
i 54 58 .xpxor 2 2 4
i 58 63 .xpsrld 3 1 6
i 63 68 .xpslld 4 1 26
i 68 72 .xpor 3 3 4
i 72 77 .xpsrld 4 1 11
i 77 82 .xpslld 5 1 21
i 82 86 .xpor 4 4 5
i 86 91 .xpsrld 5 1 25
i 91 96 .xpslld 6 1 7
i 96 100 .xpor 5 5 6
i 100 104 .xpxor 3 3 4
i 104 108 .xpxor 3 3 5
i 108 112 .xpaddd 0 2 3
i 112 116 .xstoreu .rdi 0x0 0
i 116 117 .ret
arg out inout 16
arg a fixed 16
arg e fixed 16
needs avx
hidden a
hidden e
ensuresw out (call bytes_of (call big_sigma_sum4 (call words (name a)) (call words (name e))))
stack 0
def big_sigma0 a = (bin ^ (bin ^ (bin >>> (name a) (num 2)) (bin >>> (name a) (num 13))) (bin >>> (name a) (num 22)))
def big_sigma1 e = (bin ^ (bin ^ (bin >>> (name e) (num 6)) (bin >>> (name e) (num 11))) (bin >>> (name e) (num 25)))
def big_sigma_sum4 a e = (each (bin + (call big_sigma0 (index (name a) (name i))) (call big_sigma1 (index (name e) (name i)))) i (num 0) (num 4))
