arg v number
below v 64
returns (call b64_letter (name v))
stack 0
def b64_letter v = (ifx (bin < (name v) (num 26)) (bin + (num 65) (name v)) (ifx (bin < (name v) (num 52)) (bin + (num 71) (name v)) (ifx (bin < (name v) (num 62)) (bin - (name v) (num 4)) (ifx (bin == (name v) (num 62)) (num 43) (num 47)))))
