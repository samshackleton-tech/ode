stack 64
def b64_val b = (ifx (ifx (bin >= (name b) (num 65)) (bin <= (name b) (num 90)) (bin == (num 0) (num 1))) (bin - (name b) (num 65)) (ifx (ifx (bin >= (name b) (num 97)) (bin <= (name b) (num 122)) (bin == (num 0) (num 1))) (bin - (name b) (num 71)) (ifx (ifx (bin >= (name b) (num 48)) (bin <= (name b) (num 57)) (bin == (num 0) (num 1))) (bin + (name b) (num 4)) (ifx (bin == (name b) (num 43)) (num 62) (ifx (bin == (name b) (num 47)) (num 63) (num 255))))))
def b64_quad_ok v0 v1 c2 v2 c3 v3 = (ifx (ifx (bin == (name v0) (num 255)) (bin == (num 0) (num 0)) (bin == (name v1) (num 255))) (num 0) (ifx (bin == (name c2) (num 61)) (ifx (ifx (bin == (name c3) (num 61)) (bin == (bin % (name v1) (num 16)) (num 0)) (bin == (num 0) (num 1))) (num 1) (num 0)) (ifx (bin == (name c3) (num 61)) (ifx (ifx (bin != (name v2) (num 255)) (bin == (bin % (name v2) (num 4)) (num 0)) (bin == (num 0) (num 1))) (num 1) (num 0)) (ifx (ifx (bin != (name v2) (num 255)) (bin != (name v3) (num 255)) (bin == (num 0) (num 1))) (num 1) (num 0)))))
def b64_valid_quad c0 c1 c2 c3 = (call b64_quad_ok (call b64_val (name c0)) (call b64_val (name c1)) (name c2) (call b64_val (name c2)) (name c3) (call b64_val (name c3)))
