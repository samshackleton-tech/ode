for ode_utf8_is_ascii
place 7
name i rcx
fact (bin <= (num 0) (name i))
fact (bin <= (name i) (name n))
fact (bin == (call ascii_from (name input) (num 0)) (call ascii_from (name input) (name i)))
keep rax rbx rsp rbp rsi rdi r8 r9 r10 r11 r12 r13 r14 r15
decreases (bin - (name n) (name i))
