for ode_inet_sum16
place 14
name idx rcx
name cur rax
fact (bin <= (num 0) (name idx))
fact (bin <= (name idx) (name pairs))
fact (bin == (name cur) (call inet16 (name input) (name idx)))
fact (bin < (name cur) (num 65536))
keep rdx rbx rsp rbp rsi rdi r12 r13 r14 r15
decreases (bin - (name pairs) (name idx))
