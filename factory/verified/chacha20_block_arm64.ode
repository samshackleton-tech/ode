target arm64

// One 4-way NEON quarter-round over rows (a, b, c, d) using caller-saved scratch t.
// Zero callee-saved vector registers (v8..v15) are touched.
inline fn qround(a: vec, b: vec, c: vec, d: vec, t: vec)
    distinct(a, b, c, d, t) changes a, b, c, d, t {
  add   a.4s, a.4s, b.4s
  eor   d.16b, d.16b, a.16b
  rev32 d.8h, d.8h
  add   c.4s, c.4s, d.4s
  eor   b.16b, b.16b, c.16b
  ushr  t.4s, b.4s, 20
  shl   b.4s, b.4s, 12
  orr   b.16b, b.16b, t.16b
  add   a.4s, a.4s, b.4s
  eor   d.16b, d.16b, a.16b
  ushr  t.4s, d.4s, 24
  shl   d.4s, d.4s, 8
  orr   d.16b, d.16b, t.16b
  add   c.4s, c.4s, d.4s
  eor   b.16b, b.16b, c.16b
  ushr  t.4s, b.4s, 25
  shl   b.4s, b.4s, 7
  orr   b.16b, b.16b, t.16b
}

// One RFC 8439 double round (column round + diagonal round).
inline fn dround(a: vec, b: vec, c: vec, d: vec, t: vec)
    distinct(a, b, c, d, t) changes a, b, c, d, t {
  qround(a, b, c, d, t)
  ext b.16b, b.16b, b.16b, 4
  ext c.16b, c.16b, c.16b, 8
  ext d.16b, d.16b, d.16b, 12
  qround(a, b, c, d, t)
  ext b.16b, b.16b, b.16b, 12
  ext c.16b, c.16b, c.16b, 8
  ext d.16b, d.16b, d.16b, 4
}

// Complete RFC 8439 Section 2.3 ChaCha20 64-byte keystream block:
// 20 rounds (10 double rounds) + feed-forward state addition, stack 0, constant-time.
fn chacha20_block as "ode_chacha20_block" {
  // Load initial 16 words into both saved (v4..v7) and working (v0..v3) rows.
  ldr q4, [x1, 0]
  ldr q5, [x1, 16]
  ldr q6, [x1, 32]
  ldr q7, [x1, 48]
  ldr q0, [x1, 0]
  ldr q1, [x1, 16]
  ldr q2, [x1, 32]
  ldr q3, [x1, 48]

  // 10 double rounds = 20 ChaCha20 rounds.
  dround(v0, v1, v2, v3, v16)
  dround(v0, v1, v2, v3, v16)
  dround(v0, v1, v2, v3, v16)
  dround(v0, v1, v2, v3, v16)
  dround(v0, v1, v2, v3, v16)
  dround(v0, v1, v2, v3, v16)
  dround(v0, v1, v2, v3, v16)
  dround(v0, v1, v2, v3, v16)
  dround(v0, v1, v2, v3, v16)
  dround(v0, v1, v2, v3, v16)

  // Feed-forward addition with initial state and store 64-byte keystream block.
  add v0.4s, v0.4s, v4.4s
  add v1.4s, v1.4s, v5.4s
  add v2.4s, v2.4s, v6.4s
  add v3.4s, v3.4s, v7.4s
  str q0, [x0, 0]
  str q1, [x0, 16]
  str q2, [x0, 32]
  str q3, [x0, 48]
  ret
}
