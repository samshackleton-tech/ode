i 188 192 .str128 1 .x0 0x10
i 192 196 .str128 2 .x0 0x20
i 196 200 .str128 3 .x0 0x30
i 200 204 .ret
arg state inout 64
ensuresw state (call bytes_of (call chacha20_dround (call words (name state))))
stack 0
def qr_a1 a b = (bin + (name a) (name b))
def qr_d1 a b d = (bin >>> (bin ^ (name d) (call qr_a1 (name a) (name b))) (num 16))
def qr_c1 a b c d = (bin + (name c) (call qr_d1 (name a) (name b) (name d)))
def qr_b1 a b c d = (bin >>> (bin ^ (name b) (call qr_c1 (name a) (name b) (name c) (name d))) (num 20))
def qr_a2 a b c d = (bin + (call qr_a1 (name a) (name b)) (call qr_b1 (name a) (name b) (name c) (name d)))
def qr_d2 a b c d = (bin >>> (bin ^ (call qr_d1 (name a) (name b) (name d)) (call qr_a2 (name a) (name b) (name c) (name d))) (num 24))
def qr_c2 a b c d = (bin + (call qr_c1 (name a) (name b) (name c) (name d)) (call qr_d2 (name a) (name b) (name c) (name d)))
def qr_b2 a b c d = (bin >>> (bin ^ (call qr_b1 (name a) (name b) (name c) (name d)) (call qr_c2 (name a) (name b) (name c) (name d))) (num 25))
def col_round s = (list (call qr_a2 (index (name s) (num 0)) (index (name s) (num 4)) (index (name s) (num 8)) (index (name s) (num 12))) (call qr_a2 (index (name s) (num 1)) (index (name s) (num 5)) (index (name s) (num 9)) (index (name s) (num 13))) (call qr_a2 (index (name s) (num 2)) (index (name s) (num 6)) (index (name s) (num 10)) (index (name s) (num 14))) (call qr_a2 (index (name s) (num 3)) (index (name s) (num 7)) (index (name s) (num 11)) (index (name s) (num 15))) (call qr_b2 (index (name s) (num 0)) (index (name s) (num 4)) (index (name s) (num 8)) (index (name s) (num 12))) (call qr_b2 (index (name s) (num 1)) (index (name s) (num 5)) (index (name s) (num 9)) (index (name s) (num 13))) (call qr_b2 (index (name s) (num 2)) (index (name s) (num 6)) (index (name s) (num 10)) (index (name s) (num 14))) (call qr_b2 (index (name s) (num 3)) (index (name s) (num 7)) (index (name s) (num 11)) (index (name s) (num 15))) (call qr_c2 (index (name s) (num 0)) (index (name s) (num 4)) (index (name s) (num 8)) (index (name s) (num 12))) (call qr_c2 (index (name s) (num 1)) (index (name s) (num 5)) (index (name s) (num 9)) (index (name s) (num 13))) (call qr_c2 (index (name s) (num 2)) (index (name s) (num 6)) (index (name s) (num 10)) (index (name s) (num 14))) (call qr_c2 (index (name s) (num 3)) (index (name s) (num 7)) (index (name s) (num 11)) (index (name s) (num 15))) (call qr_d2 (index (name s) (num 0)) (index (name s) (num 4)) (index (name s) (num 8)) (index (name s) (num 12))) (call qr_d2 (index (name s) (num 1)) (index (name s) (num 5)) (index (name s) (num 9)) (index (name s) (num 13))) (call qr_d2 (index (name s) (num 2)) (index (name s) (num 6)) (index (name s) (num 10)) (index (name s) (num 14))) (call qr_d2 (index (name s) (num 3)) (index (name s) (num 7)) (index (name s) (num 11)) (index (name s) (num 15))))
def diag_round s = (list (call qr_a2 (index (name s) (num 0)) (index (name s) (num 5)) (index (name s) (num 10)) (index (name s) (num 15))) (call qr_a2 (index (name s) (num 1)) (index (name s) (num 6)) (index (name s) (num 11)) (index (name s) (num 12))) (call qr_a2 (index (name s) (num 2)) (index (name s) (num 7)) (index (name s) (num 8)) (index (name s) (num 13))) (call qr_a2 (index (name s) (num 3)) (index (name s) (num 4)) (index (name s) (num 9)) (index (name s) (num 14))) (call qr_b2 (index (name s) (num 3)) (index (name s) (num 4)) (index (name s) (num 9)) (index (name s) (num 14))) (call qr_b2 (index (name s) (num 0)) (index (name s) (num 5)) (index (name s) (num 10)) (index (name s) (num 15))) (call qr_b2 (index (name s) (num 1)) (index (name s) (num 6)) (index (name s) (num 11)) (index (name s) (num 12))) (call qr_b2 (index (name s) (num 2)) (index (name s) (num 7)) (index (name s) (num 8)) (index (name s) (num 13))) (call qr_c2 (index (name s) (num 2)) (index (name s) (num 7)) (index (name s) (num 8)) (index (name s) (num 13))) (call qr_c2 (index (name s) (num 3)) (index (name s) (num 4)) (index (name s) (num 9)) (index (name s) (num 14))) (call qr_c2 (index (name s) (num 0)) (index (name s) (num 5)) (index (name s) (num 10)) (index (name s) (num 15))) (call qr_c2 (index (name s) (num 1)) (index (name s) (num 6)) (index (name s) (num 11)) (index (name s) (num 12))) (call qr_d2 (index (name s) (num 1)) (index (name s) (num 6)) (index (name s) (num 11)) (index (name s) (num 12))) (call qr_d2 (index (name s) (num 2)) (index (name s) (num 7)) (index (name s) (num 8)) (index (name s) (num 13))) (call qr_d2 (index (name s) (num 3)) (index (name s) (num 4)) (index (name s) (num 9)) (index (name s) (num 14))) (call qr_d2 (index (name s) (num 0)) (index (name s) (num 5)) (index (name s) (num 10)) (index (name s) (num 15))))
def chacha20_dround s = (call diag_round (call col_round (name s)))
