fn ode_inet_sum16
machine arm64
i 0 4 .movi .x3 0x0
i 4 8 .movi .x4 0x0
i 8 12 .cmp .x3 .x2
i 12 16 .blo 0x18
i 16 20 .mov .x0 .x4
i 20 24 .ret
i 24 28 .lsl .x5 .x3 0x1
i 28 32 .add .x5 .x0 .x5
i 32 36 .ldrb .x6 .x5 0x0
i 36 40 .ldrb .x7 .x5 0x1
i 40 44 .lsl .x6 .x6 0x8
i 44 48 .add .x4 .x4 .x6
i 48 52 .add .x4 .x4 .x7
i 52 56 .movi .x8 0x1
i 56 60 .lsl .x8 .x8 0x10
i 60 64 .cmp .x4 .x8
i 64 68 .blo 0x4c
i 68 72 .subi .x8 .x8 0x1
i 72 76 .sub .x4 .x4 .x8
i 76 80 .addi .x3 .x3 0x1
i 80 84 .b 0x8
arg input bytes len
arg len number
arg pairs number
linpre 0 len -1 pairs 2
linpre 0 len 1 pairs -2
returns (call inet16 (name input) (name pairs))
stack 0
def fold16 x = (ifx (bin >= (name x) (num 65536)) (bin - (name x) (num 65535)) (name x))
def inet16 bytes place = (ifx (bin == (name place) (num 0)) (num 0) (call fold16 (bin + (bin + (call inet16 (name bytes) (bin - (name place) (num 1))) (bin * (num 256) (index (name bytes) (bin * (num 2) (bin - (name place) (num 1)))))) (index (name bytes) (bin + (bin * (num 2) (bin - (name place) (num 1))) (num 1))))))
