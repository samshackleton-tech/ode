for ode_adler32_s1
place 12
name loop_i x2
name loop_cur x3
fact (bin <= (num 0) (name loop_i))
fact (bin <= (name loop_i) (name n))
fact (bin == (name loop_cur) (call s1 (name input) (name loop_i)))
fact (bin < (name loop_cur) (num 65521))
keep x0 x1 sp x5 x7 x8 x9 x10 x11 x12 x13 x14 x15 x16 x17 x18 x19 x20 x21 x22 x23 x24 x25 x26 x27 x28 x29 x30
decreases (bin - (name n) (name loop_i))
