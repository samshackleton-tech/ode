target x86_64

fn chacha20_qround_4x as "ode_chacha20_qround_4x" {
  reg out_ptr = rdi
  reg state_ptr = rsi

  // Load four 16-byte rows into xmm0..xmm3
  vmovdqu xmm0, [state_ptr + 0]
  vmovdqu xmm1, [state_ptr + 16]
  vmovdqu xmm2, [state_ptr + 32]
  vmovdqu xmm3, [state_ptr + 48]

  // a += b
  vpaddd xmm0, xmm0, xmm1

  // d = (d ^ a) >>> 16
  vpxor xmm3, xmm3, xmm0
  // x86 doesn't have rotate-by-immediate for 128-bit, so we implement >>>16 as:
  // (x << 16) | (x >> 16) but for 32-bit lanes.
  // We'll use vpsrld and vpslld with 16, then vpor.
  vpsrld xmm4, xmm3, 16
  vpslld xmm5, xmm3, 16
  vpor xmm3, xmm4, xmm5

  // c += d
  vpaddd xmm2, xmm2, xmm3

  // b = (b ^ c) >>> 20
  vpxor xmm1, xmm1, xmm2
  vpsrld xmm4, xmm1, 20
  vpslld xmm5, xmm1, 12
  vpor xmm1, xmm4, xmm5

  // a += b
  vpaddd xmm0, xmm0, xmm1

  // d = (d ^ a) >>> 24
  vpxor xmm3, xmm3, xmm0
  vpsrld xmm4, xmm3, 24
  vpslld xmm5, xmm3, 8
  vpor xmm3, xmm4, xmm5

  // c += d
  vpaddd xmm2, xmm2, xmm3

  // b = (b ^ c) >>> 25
  vpxor xmm1, xmm1, xmm2
  vpsrld xmm4, xmm1, 25
  vpslld xmm5, xmm1, 7
  vpor xmm1, xmm4, xmm5

  // Store results: a, b, c, d
  vmovdqu [out_ptr + 0], xmm0
  vmovdqu [out_ptr + 16], xmm1
  vmovdqu [out_ptr + 32], xmm2
  vmovdqu [out_ptr + 48], xmm3

  ret
}
